#!/usr/bin/env bash
# coordinator-settings-home — bare-name forwarder. The real resolver installs to
# ~/.claude/bin (CLAUDE_HOME-aware, retained compat forwarder that itself resolves
# the settings home); this forwarder lives in the harness-injected plugin bin so
# bare `coordinator-settings-home` resolves on POSIX tool shells where ~/.claude/bin
# is NOT on PATH — parity with the machine-local / claude-home forwarders.
#
# WHY THIS EXISTS: shape-(iv) install-chain consumers bind to
# $(coordinator-settings-home)/<repo-id>/ per the agent-install-contract. Without
# this forwarder the seam CLI resolves only by absolute path (~/.claude/bin or the
# settings-home bin, neither reliably on PATH), so consumers cannot bind bare — the
# exact gap example-game-repo-em flagged on 2026-07-06 (settings-home seam grep-confirm).
# Spec: docs/plans/2026-07-06-durable-substrate-to-settings-home.md § C1/C9
set -euo pipefail
# CLAUDE_HOME is a $HOME-substitute per machine-local-registry.md §4a (CLAUDE_HOME=/x → install
# at /x/.claude/), so the .claude suffix is correct here — same as the machine-local forwarder.
_real="${CLAUDE_HOME:-$HOME}/.claude/bin/coordinator-settings-home"
if [ ! -x "$_real" ]; then
  echo "coordinator-settings-home: resolver not installed at $_real — run /coordinator:setup (Phase 3)." >&2
  exit 127
fi
exec "$_real" "$@"
