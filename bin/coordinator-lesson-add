#!/bin/sh
''''exec "$(command -v python3 || command -v python || command -v py)" "$0" "$@" #'''
from __future__ import annotations
"""
coordinator-lesson-add — thin wrapper over coordinator-queue-append --schema lessons
with a dedup pre-check at capture time.

Added value over direct coordinator-queue-append invocation:
  - Scans state/lessons/*.yaml for title-token overlap before writing.
  - If a candidate match exists (>=60% shared significant tokens or a
    substring match), prints a warning to stderr and exits nonzero.
  - Re-run with --force to bypass the check and add unconditionally.

Flags NOT exposed by this wrapper (call coordinator-queue-append --schema lessons
directly if you need them):
  --queue-scope   (default "project" baked in; use direct call for "central")
  --status        (lessons default applied by coordinator-queue-append)
  --created       (timestamp auto-generated by coordinator-queue-append)
  --from-repo     (auto-detected from git root by coordinator-queue-append)

Review: code-reviewer F6 — enumerate omitted flags so callers know to use the
direct coordinator-queue-append path when those fields are needed.

Spec backlink: docs/plans/2026-06-30-lessons-md-to-queryable-yaml-queue.md § C2
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys

_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
_QUEUE_APPEND = os.path.join(_THIS_DIR, "coordinator-queue-append")

# Mirrors coordinator-queue-append._QUEUE_APPEND_OUTPUT_ROOT_ENV for test isolation.
# When set, the dedup scan looks under <QUEUE_APPEND_OUTPUT_ROOT>/state/lessons/
# (matching where coordinator-queue-append writes when this env var is set).
_QUEUE_APPEND_OUTPUT_ROOT_ENV = "QUEUE_APPEND_OUTPUT_ROOT"

# Mirrors coordinator-queue-append._CLAUDE_HOME_ENV for test isolation.
_CLAUDE_HOME_ENV = "CLAUDE_HOME"

# Mirrors coordinator-queue-append._EXAMPLE_ORCHESTRATION_HUB_ROOT_ENV for test isolation and §4b gate.
_EXAMPLE_ORCHESTRATION_HUB_ROOT_ENV = "EXAMPLE_ORCHESTRATION_HUB_ROOT"

# Mirrors coordinator-queue-append._MACHINE_LOCAL_IMPL_ENV for test isolation.
_MACHINE_LOCAL_IMPL_ENV = "MACHINE_LOCAL_IMPL"


def _git_root():
    """Return the git repo root of cwd, or None if not in a git repo.

    Mirrors coordinator-queue-append._current_repo_root resolution.
    """
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except OSError:
        pass
    return None


def _claude_home() -> str:
    """Return the ~/.claude root, honouring CLAUDE_HOME env var for test isolation.

    Mirrors coordinator-queue-append._claude_home().
    """
    override = os.environ.get(_CLAUDE_HOME_ENV)
    if override:
        return override
    return os.path.join(os.path.expanduser("~"), ".claude")


def _machine_local_get(key: str):
    """Call machine-local get <key> and return the value, or None on failure.

    Mirrors coordinator-queue-append._machine_local_get().
    """
    impl_override = os.environ.get(_MACHINE_LOCAL_IMPL_ENV)
    impl = impl_override if impl_override else os.path.join(_claude_home(), "bin", "_machine_local.py")
    try:
        result = subprocess.run(
            [sys.executable, impl, "get", key],
            capture_output=True,
            text=True,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def _example_orchestration_hub_root():
    """Resolve the example-orchestration-hub repo root, returning None when unresolvable.

    Resolution chain:
      1. EXAMPLE_ORCHESTRATION_HUB_ROOT env var — trusted as-is (§4b idempotency gate).
      2. machine-local get repos.example_orchestration_hub_repo.
      3. Returns None when unresolvable (caller degrades gracefully).

    Mirrors coordinator-queue-append._example_orchestration_hub_root().
    Spec backlink: docs/plans/2026-07-03-stop-the-rot-example-orchestration-hub-state-home-placement.md § AC1 / AC13
    """
    override = os.environ.get(_EXAMPLE_ORCHESTRATION_HUB_ROOT_ENV, "").strip()
    if override:
        return override
    val = _machine_local_get("repos.example_orchestration_hub_repo")
    return val if val else None


def _same_path(a: str, b: str) -> bool:
    """True if two paths resolve to the same directory (cross-platform).

    Uses os.path.samefile when both paths exist; falls back to normcase+realpath
    string comparison so absent/unregistered repos never raise.

    Mirrors coordinator_registry._same_path().
    """
    try:
        return os.path.samefile(a, b)
    except OSError:
        return os.path.normcase(os.path.realpath(a)) == os.path.normcase(os.path.realpath(b))


def _lessons_dir():
    """Return the directory to scan for existing lesson entries (dedup pre-check).

    Resolution mirrors the routing logic of coordinator-queue-append._output_path for the lessons schema:
      1. QUEUE_APPEND_OUTPUT_ROOT env override → <override>/state/lessons
      2. Meta-repo cwd (git root == ~/.claude) → <example-orchestration-hub>/state/lessons
         (mirrors queue-append._output_path else-branch stop-the-rot routing so
         the dedup scan looks where queue-append actually writes)
      3. cwd git-root → <root>/state/lessons
      4. Fallback → cwd-relative state/lessons
    Tolerates the directory not existing (returns the path; caller checks isdir).
    On unresolvable example-orchestration-hub root, emits a stderr warning and falls back to the
    git-root path (dedup pre-check degrades to no-op rather than crashing).

    Negative-spec: WITHOUT this meta-repo routing, cwd=~/.claude causes the dedup
    scan to look in ~/.claude/state/lessons while queue-append writes to
    <example-orchestration-hub>/state/lessons — the dedup check silently misses all existing entries.
    Fix: align with queue-append._output_path else-branch (stop-the-rot taxonomy).
    Spec backlink: state/bug-backlog/2026-07-06-lesson-add-dedup-scans-wrong-dir-in-meta.yaml
    """
    override = os.environ.get(_QUEUE_APPEND_OUTPUT_ROOT_ENV)
    if override:
        return os.path.join(override, "state", "lessons")
    root = _git_root()
    if root:
        home = _claude_home()
        if _same_path(root, home):
            # Meta-repo cwd → dedup scan must look in example-orchestration-hub, not in ~/.claude.
            # Mirrors coordinator-queue-append._output_path else-branch (stop-the-rot).
            example-orchestration-hub = _example_orchestration_hub_root()
            if example-orchestration-hub is not None:
                return os.path.join(example-orchestration-hub, "state", "lessons")
            # ExampleOrchestrationHub unresolvable: degrade gracefully — dedup scan falls back to the
            # git-root path; the pre-check becomes a no-op (directory likely absent)
            # rather than crashing or writing to the wrong place.
            print(
                "coordinator-lesson-add: warning: example-orchestration-hub root unresolvable; "
                "dedup pre-check will miss all existing entries in example-orchestration-hub; "
                "lesson will still be written correctly by coordinator-queue-append",
                file=sys.stderr,
            )
            # Review: code-reviewer — nit: old text "may miss" understated; on any machine
            # with a working example-orchestration-hub setup the fallback dir is always empty, so the dedup
            # check is always a complete no-op. "will miss all" is accurate.
        return os.path.join(root, "state", "lessons")
    return os.path.join(os.getcwd(), "state", "lessons")


def _tokenize(text):
    """Return significant lowercase alphanumeric tokens (len>2, not a stop word)."""
    STOP = {
        "the", "a", "an", "is", "in", "on", "at", "to", "of", "and",
        "or", "for", "not", "be", "are", "was", "with", "from", "by",
        "its", "it", "has", "via",
    }
    return {t for t in re.findall(r"[a-z0-9]+", text.lower())
            if len(t) > 2 and t not in STOP}


def _title_overlap(a, b):
    """Fraction of shared significant tokens vs max token-set size (Jaccard-like)."""
    ta, tb = _tokenize(a), _tokenize(b)
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / max(len(ta), len(tb))


def _read_yaml_title(path):
    """Extract the title: value from a YAML file via a simple line scan.

    Strips enclosing double-quotes produced by coordinator-queue-append
    _yaml_quote_string. Returns None on read failure or no title: line found.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"^title:\s*(.+)$", line.rstrip())
                if m:
                    val = m.group(1).strip()
                    if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
                        # Review: code-reviewer Slice-A — (A-F4) json.loads handles all JSON
                        # escape sequences (including \\→\) so backslash titles dedup correctly.
                        try:
                            val = json.loads(val)
                        except (json.JSONDecodeError, ValueError):
                            val = val[1:-1].replace('\\"', '"')
                    return val
    except OSError:
        pass
    return None


def _dedup_check(new_title):
    """Return list of (path, existing_title) tuples that are possible duplicates.

    A match is declared when:
      - Title-token overlap >= 60% (Jaccard-like over significant tokens), OR
      - One title is a case-insensitive substring of the other.
    """
    lessons = _lessons_dir()
    if not os.path.isdir(lessons):
        return []
    matches = []
    for path in sorted(glob.glob(os.path.join(lessons, "*.yaml"))):
        existing = _read_yaml_title(path)
        if existing is None:
            continue
        overlap = _title_overlap(new_title, existing)
        is_substr = (
            new_title.lower() in existing.lower()
            or existing.lower() in new_title.lower()
        )
        if overlap >= 0.60 or is_substr:
            matches.append((path, existing))
    return matches


def main():
    parser = argparse.ArgumentParser(
        prog="coordinator-lesson-add",
        description=(
            "Add a lesson entry to state/lessons/ — thin wrapper over "
            "coordinator-queue-append --schema lessons with a dedup pre-check."
        ),
    )
    parser.add_argument(
        "--title", required=True, metavar="TEXT",
        help="One-line lesson title (required).",
    )
    parser.add_argument(
        "--body", required=True, metavar="TEXT",
        help="Lesson body prose (required).",
    )
    parser.add_argument(
        "--scope", required=True, metavar="VALUE",
        help="Scope classification: universal | project | wiki-only (required).",
    )
    parser.add_argument(
        "--target-wiki", dest="target_wiki", default=None, metavar="TEXT",
        help="Routing clause — belongs in <wiki>.md (optional).",
    )
    parser.add_argument(
        "--proposed-target", dest="proposed_target", default=None, metavar="TEXT",
        help="Doctrine/wiki/hook/skill the lesson routes to (optional).",
    )
    parser.add_argument(
        "--evidence", default=None, metavar="TEXT",
        help="Provenance: commit SHA, plan path, or related reference (optional).",
    )
    parser.add_argument(
        "--trigger", default=None, metavar="TEXT",
        help=(
            "The concrete situation or event that surfaced this lesson (optional). "
            "author-supplied; do NOT LLM-extract from existing prose."
        ),
    )
    parser.add_argument(
        "--why", default=None, metavar="TEXT",
        help=(
            "Root-cause explanation — why this matters and what breaks without it (optional). "
            "author-supplied; do NOT LLM-extract from existing prose."
        ),
    )
    parser.add_argument(
        "--how-to-apply", dest="how_to_apply", default=None, metavar="TEXT",
        help=(
            "Actionable guidance for applying this lesson in future situations (optional). "
            "author-supplied; do NOT LLM-extract from existing prose."
        ),
    )
    parser.add_argument(
        "--force", action="store_true",
        help="Skip the dedup pre-check and write unconditionally.",
    )

    args = parser.parse_args()

    if not args.force:
        dupes = _dedup_check(args.title)
        if dupes:
            path, existing_title = dupes[0]
            fname = os.path.basename(path)
            print(
                'possible duplicate of ' + fname + ': "' + existing_title + '"'
                ' — re-run with --force to add anyway, or amend the existing entry',
                file=sys.stderr,
            )
            sys.exit(1)

    cmd = [
        sys.executable, _QUEUE_APPEND,
        "--schema", "lessons",
        "--title", args.title,
        "--body", args.body,
        "--scope", args.scope,
    ]
    if args.target_wiki:
        cmd += ["--target-wiki", args.target_wiki]
    if args.proposed_target:
        cmd += ["--proposed-target", args.proposed_target]
    if args.evidence:
        cmd += ["--evidence", args.evidence]
    if args.trigger:
        cmd += ["--trigger", args.trigger]
    if args.why:
        cmd += ["--why", args.why]
    if args.how_to_apply:
        cmd += ["--how-to-apply", args.how_to_apply]

    result = subprocess.run(
        cmd,
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
    )
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
