{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash /test/coordinator/hooks/scripts/plan-persistence-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /test/coordinator/hooks/scripts/block-some-write.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash /test/coordinator/hooks/scripts/session-guard.sh",
            "timeout": 5,
            "async": false
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash /test/coordinator/hooks/scripts/bootstrap-substrate.sh",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ]
  }
}
