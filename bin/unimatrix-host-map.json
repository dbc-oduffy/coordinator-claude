{
  "agy": {
    "commands_to_skills": true,
    "copy_dirs": [
      "bin",
      "hooks",
      "scripts"
    ],
    "hook_drop_fields": [
      "description"
    ],
    "hook_events": [
      "PostInvocation",
      "PostToolUse",
      "PreInvocation",
      "PreToolUse",
      "SessionStart",
      "Stop"
    ],
    "hooks_path": "hooks.json",
    "ignore_top_level": [
      ".claude-plugin",
      ".git",
      ".github",
      "__pycache__",
      "ceremony_tests",
      "node_modules",
      "templates",
      "tests"
    ],
    "manifest_path": "plugin.json",
    "max_text_bytes": 24000,
    "plugin_root_token": "${PLUGIN_DIR}",
    "rules_path": "rules/coordinator-doctrine.md",
    "rules_trigger": "always_on",
    "source_manifest_path": ".claude-plugin/plugin.json",
    "tiers": {
      "haiku": "flash_lite",
      "opus": "pro",
      "sonnet": "flash"
    },
    "token_suffixes": [
      ".json",
      ".md"
    ],
    "tool_hook_events": [
      "PostToolUse",
      "PreToolUse"
    ],
    "tools": {
      "Bash": "run_command",
      "Edit": "edit_file",
      "Glob": "find_by_name",
      "Grep": "grep_search",
      "MultiEdit": "multi_replace_file_content",
      "NotebookEdit": "notebook_edit",
      "Read": "view_file",
      "Write": "write_file"
    },
    "valid_tiers": [
      "flash",
      "flash_lite",
      "inherit",
      "pro"
    ]
  },
  "codex": {},
  "grok": {}
}
