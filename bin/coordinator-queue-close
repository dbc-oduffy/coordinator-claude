"""
coordinator-queue-close — CLI forwarder for the ``queue.close`` op
(``coordinator_core/ops/queue_close.py``).

Shebang note: this file deliberately carries NO ``#!/usr/bin/env python3``
line, unlike its older sibling ``coordinator-queue-append``. PM ruling
2026-07-28 (Windows is the P0 primary platform) reclassified the
env-stripped-shebang / extensionless-executable shape as a POSIX-only-
execution portability defect, and the new-file write guard refuses it on a
new extensionless ``coordinator/bin/`` entrypoint. The two entrypoints added
to this repo on 2026-08-11 (``coordinator-ensure-hooks-fleet``,
``static-check``) carry no shebang for exactly this reason, and this file
follows them. Windows invocation goes through the co-located ``.cmd``/``.ps1``
launchers generated by ``coordinator/bin/gen-launcher-shim.py`` (which win via
PATHEXT on a bareword); POSIX invocation is
``python3 coordinator/bin/coordinator-queue-close``.

Purpose: give improvement-queue CLOSURE the entrypoint every sibling queue
operation already has. ``queue.close`` was fully built and registered with no
forwarder anywhere — not here, not in the settings-home bin mirror — so the
only way to reach it was hand-writing a scratchpad script against the op seam.

WHAT THIS SCRIPT DOES NOT DO — closure is ATOMIC INSIDE THE OP
    ``queue.close`` performs all three legs of a closure ITSELF, in one call:
      1. stamps ``status: closed`` (+ backfills missing ``closed_at`` /
         ``closed_by``) under the entry's write lock,
      2. COMMITS that stamp, scoped to exactly the one entry path, via
         ``git_native.commit_authored_content``, and
      3. delegates the archival ``git mv`` into
         ``archive/improvement-queue/YYYY-MM/`` to the unmodified
         ``fleet.archive_queue_entry`` op.
    See that module's "Write confinement (hard)" contract and DR-270. This
    script therefore NEVER stages, commits, moves, or writes anything: it
    parses arguments, invokes the op through the native ``cc_invoke`` seam,
    and renders the returned envelope. Adding a ``git add``/``git mv``/
    ``git commit`` here would reintroduce exactly the two-step,
    stamp-then-sweep-by-hand discipline the op exists to abolish.

Invocation:
    coordinator-queue-close <entry_path> --closed-by <sha> [--closed-at YYYY-MM-DD]

    <entry_path>   repo-relative (or absolute) path to ONE
                   state/improvement-queue/*.yaml entry. The op refuses any
                   path escaping that directory.
    --closed-by    the commit SHA that realized the fix. Required by the op —
                   it exists so a closure can never reproduce the missing-
                   ``closed_by`` gap 24 of the 36 hand-stamped entries carry.
    --closed-at    YYYY-MM-DD; defaults to today (UTC) inside the op.

Output: one ``closed=… archived=… dest=… commit=…`` summary line, plus an
explicit line for each notable state — a declined close (``skipped_reason``),
a resumed stranded write, or a total no-op. A silent success-looking exit on a
call that changed nothing is the failure mode this rendering exists to
prevent.

Exit codes:
    0 — the entry was closed and/or archived by this call, or the call was a
        legitimate idempotent replay (the entry is already sitting at ``dest``
        in the archive).
    1 — the op reported an ``error`` or a non-zero ``exit_code``; the native
        transport failed; or the call found NOTHING — neither the named entry
        nor its archive destination exists, which means the path names no
        entry at all (a typo), not a replay.
    2 — usage error, validated before any op routing.

Negative-spec: no legacy/bash fallback. ``queue.close`` is native-only, so the
``legacy_fn`` handed to ``route_mutation`` always raises — a seam-absent
install fails loud naming the missing seam rather than silently reporting a
closure that never happened.

Spec backlink: coordinator_core/ops/queue_close.py (the op this forwards to)
DR authority: docs/decisions/DR-270-queue-closure-writer-side-commit-ownership.md
"""
from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# lib/ bootstrap — identical shape to coordinator-queue-append's: prepend this
# file's co-located lib/ directory so `cc_invoke` and `cli_shared` resolve by
# bare name whether the script is spawned from the repo, from an installed
# settings-home forwarder, or by a test that loads it via importlib.
# ---------------------------------------------------------------------------
_LIB_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)
from cc_invoke import RouteMutationError, route_mutation  # noqa: E402
from repo_identity import resolve_checked_repo_root  # noqa: E402

_PROG = "coordinator-queue-close"
_OP = "queue.close"

_QUEUE_DIR_POSIX = "state/improvement-queue/"

# --closed-at is a DATE field. It is not interpolated into any filename by
# this script, but it IS written verbatim into the entry's frontmatter by the
# op, and the on-disk convention every `closed_at:` field already uses is a
# plain, unquoted YYYY-MM-DD. Shape-checking here (mirroring
# coordinator-queue-append's `_CREATED_DATE_RE`) keeps a malformed value from
# reaching a committed record. [0-9] rather than \d: `\d` matches any Unicode
# Nd digit; .fullmatch() rather than .match(): `$` admits one trailing "\n".
_CLOSED_AT_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")


def _no_legacy() -> None:
    """``route_mutation`` legacy_fn for ``queue.close`` — always raises.

    ``queue.close`` is native-only: it has never had a bash or Python legacy
    implementation, so there is nothing to degrade to. A fail-OPEN legacy_fn
    here would be strictly worse than a loud break — it would report a
    closure that never stamped, never committed, and never archived. route()'s
    State-1 path wraps this RuntimeError in the four-rung CLAUDE_KLABAUTER_ROOT
    remediation message, so the operator sees which rung to fix.
    """
    raise RuntimeError(
        f"{_PROG}: {_OP} requires the native coordinator_core.invoke seam — "
        "no legacy fallback exists."
    )


def _repo_root() -> str:
    """cwd's git root, falling back to cwd itself outside a repo.

    Thin wrapper over the checked resolver (`repo_identity`, the same seam
    coordinator-queue-append routes its own repo-root resolution through), kept
    as a named function so tests can substitute it without spawning git. Was
    `cli_shared.current_repo_root`, deleted by C2 of the one-checked-resolver
    plan on the premise that `resolve_from_repo` was its only caller.

    Classification: READER — a MISMATCH warns and proceeds, per DR-277.
    """
    root, verdict = resolve_checked_repo_root(explicit_root=None)
    if verdict.get("verdict") == "MISMATCH":
        print(
            verdict.get("message", f"{_PROG}: repo-identity MISMATCH"),
            file=sys.stderr,
        )
    return root or os.getcwd()


def _build_parser() -> argparse.ArgumentParser:
    """Build the argument parser for coordinator-queue-close."""
    return argparse.ArgumentParser(
        prog=_PROG,
        description=(
            "Close ONE state/improvement-queue/*.yaml entry via the queue.close op. "
            "The op stamps, commits, and archives atomically — this CLI writes nothing."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Example:

  coordinator-queue-close \\
      state/improvement-queue/2026-08-11-some-entry-9b6d190ee07e.yaml \\
      --closed-by a8fa206de \\
      --closed-at 2026-08-11

Closure is atomic INSIDE the op (stamp + scoped commit + archival git mv);
this script never stages, commits, or moves anything.

Spec backlink: coordinator_core/ops/queue_close.py
""",
    )


def _add_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "entry_path",
        metavar="ENTRY_PATH",
        help="Path to ONE state/improvement-queue/*.yaml entry (repo-relative or absolute).",
    )
    parser.add_argument(
        "--closed-by",
        dest="closed_by",
        required=True,
        metavar="SHA",
        help="Commit SHA that realized the fix. Required — stamped as closed_by.",
    )
    parser.add_argument(
        "--closed-at",
        dest="closed_at",
        default=None,
        metavar="YYYY-MM-DD",
        help="Closure date. Defaults to today (UTC), resolved inside the op.",
    )


def _render(result: dict, repo_root: str, entry_path: str) -> int:
    """Print the op's envelope readably and return this process's exit code.

    Every field the op returns that a caller could act on is surfaced:
    ``closed`` (did THIS call stamp), ``archived`` (did the entry reach the
    archive), ``dest``, ``committed_sha``, ``skipped_reason`` and ``resumed``.
    ``skipped_reason`` in particular is never swallowed — the op declines a
    ``status: deferred`` entry rather than promoting it, and a caller who
    cannot see that decline reads a 0 exit as a closure that happened.
    """
    closed = bool(result.get("closed"))
    archived = bool(result.get("archived"))
    dest = result.get("dest")
    committed_sha = result.get("committed_sha")
    skipped_reason = result.get("skipped_reason")
    resumed = bool(result.get("resumed"))

    print(
        f"{_PROG}: {_OP} — closed={closed} archived={archived} "
        f"dest={dest or '-'} commit={committed_sha or '-'}"
    )

    if skipped_reason:
        # The op declined rather than acted. Name the decline AND the way out;
        # a bare reason string leaves the caller guessing at the next move.
        print(
            f"{_PROG}: DECLINED ({skipped_reason}) — nothing was stamped, "
            f"committed, or archived for {entry_path}.",
            file=sys.stderr,
        )
        if skipped_reason == "deferred":
            print(
                f"{_PROG}: a 'deferred' entry is explicitly deprioritized, not "
                "terminal — queue.close refuses to promote it silently. Flip it "
                "back to 'status: open' first if it really is being closed.",
                file=sys.stderr,
            )
        return 0

    if resumed:
        print(
            f"{_PROG}: resumed a stranded status flip left uncommitted by a "
            f"prior run; it is committed now ({committed_sha or 'sha unavailable'})."
        )

    if closed or archived:
        return 0

    # Nothing happened. Two very different causes share this envelope, and the
    # op cannot tell them apart (it computes `dest` unconditionally, before
    # ever probing disk — see fleet.archive_queue_entry's `_reply(exit_code=0,
    # archived=False, dest=dest_rel)` branches). Discriminate here, client-side:
    #   - the archive destination EXISTS   -> a legitimate idempotent replay;
    #     the entry is closed and already sitting in the archive. Exit 0.
    #   - neither source nor destination exists -> the path names no entry at
    #     all (typo, wrong date prefix, wrong repo). Exiting 0 on that is the
    #     silent no-op this CLI must never produce. Exit 1.
    dest_on_disk = Path(repo_root) / dest if dest else None
    if dest_on_disk is not None and dest_on_disk.exists():
        print(
            f"{_PROG}: no-op — entry is already archived at {dest} "
            "(idempotent replay; nothing left to close)."
        )
        return 0

    print(
        f"{_PROG}: error: nothing to close — no entry at {entry_path} and no "
        f"archived copy at {dest or '<undetermined>'}. Check the path: it must "
        f"name an existing {_QUEUE_DIR_POSIX}*.yaml entry.",
        file=sys.stderr,
    )
    return 1


def main(argv: "list[str] | None" = None) -> int:
    """Entry point for coordinator-queue-close."""
    parser = _build_parser()
    _add_arguments(parser)
    args = parser.parse_args(argv)

    entry_path = args.entry_path.strip()
    if not entry_path:
        print(f"{_PROG}: error: ENTRY_PATH must not be empty", file=sys.stderr)
        return 2

    closed_by = args.closed_by.strip()
    if not closed_by:
        print(f"{_PROG}: error: --closed-by must not be empty", file=sys.stderr)
        return 2

    params: dict = {"entry_path": entry_path, "closed_by": closed_by}

    if args.closed_at is not None:
        closed_at = args.closed_at.strip()
        if not _CLOSED_AT_RE.fullmatch(closed_at):
            print(
                f"{_PROG}: error: --closed-at must match "
                f"{_CLOSED_AT_RE.pattern} (YYYY-MM-DD), got {args.closed_at!r}",
                file=sys.stderr,
            )
            return 2
        params["closed_at"] = closed_at

    repo_root = _repo_root()

    # route_mutation, not route: queue.close's op-level refusals live INSIDE
    # the result payload ({"exit_code": N} / {"error": "..."}), which a bare
    # route() would hand back unraised — a caller would then read a stamp that
    # never landed as a success. See cc_invoke.route_mutation's DR-215 note.
    try:
        result = route_mutation(_OP, params, repo_root, _no_legacy)
    except RouteMutationError as exc:
        print(f"{_PROG}: error: {_OP} refused: {exc}", file=sys.stderr)
        partial = getattr(exc, "result", None)
        if isinstance(partial, dict) and partial.get("committed_sha"):
            # The stamp commit can land durably even when the archival leg
            # fails. Losing that SHA in the failure path would leave the
            # operator unable to see what DID happen.
            print(
                f"{_PROG}: note: the status stamp WAS committed as "
                f"{partial['committed_sha']} before the failure.",
                file=sys.stderr,
            )
        return 1
    except RuntimeError as exc:
        print(f"{_PROG}: error: {_OP} transport failed: {exc}", file=sys.stderr)
        return 1

    if not isinstance(result, dict):
        print(
            f"{_PROG}: error: {_OP} returned a non-dict result: {result!r}",
            file=sys.stderr,
        )
        return 1

    return _render(result, repo_root, entry_path)


if __name__ == "__main__":
    sys.exit(main())
