# review-trail-vouch-cli — CLI trampoline over claude-klabauter
# coordinator_core.session.review_trail_vouch (the per-session, PM-granted
# relaxation of the review-trail write-side foreign-session Case-1 refusal —
# see that module's docstring for the two-part write-time-grant /
# permanent-read-side-waiver mechanism). Direct-import variant, mirroring
# coordinator/bin/tier-u-grant-cli's resolve/import/dispatch/exit shape (the
# sibling per-session PM-grant precedent this CLI's shape is deliberately
# mirrored from, per the PM design constraint "mirror the existing precedent
# rather than inventing one").
#
# The write path is intended to be invoked ONLY following a recorded,
# verbatim PM utterance authorizing a NAMED foreign SHA — see the module
# docstring's negative-spec for why an env var or a bare agent-writable file
# was rejected as the mechanism. This CLI itself performs no PM-identity
# check (neither does its tier-u-grant-cli sibling) — the naming and the
# procedure (grant pm "<verbatim utterance>" --sha <sha>) make a self-grant a
# deliberate, visible act rather than a silent one.
#
# Subcommands (argv[1] selects; remaining argv forwarded to the mapped
# coordinator_core.session.review_trail_vouch function):
#   grant pm <note> --sha <sha> [--sha <sha> ...]
#                                              -> review_trail_vouch.write_review_trail_vouch(...)
#                                                 bool->exit
#   read                                       -> review_trail_vouch.read_review_trail_vouch():
#                                                  prints the raw grant record as one line of
#                                                  JSON if present, prints nothing if absent/
#                                                  unreadable/malformed; always exit 0
#                                                  (informational — this is NOT the
#                                                  authorization predicate, see `check`)
#   check --sha <sha> [--sha <sha> ...]        -> review_trail_vouch.check_review_trail_vouch():
#                                                  prints the vouched-for subset (one SHA per
#                                                  line) of the requested SHAs; exit 0 iff ALL
#                                                  requested SHAs are vouched-for under a live
#                                                  grant, exit 1 otherwise (matches
#                                                  tier-u-grant-cli's bool->exit convention)
#
# Exit codes: exit 0 on grant-write success / check-all-vouched; exit 1 on
# grant-write failure / check-not-all-vouched. A missing/unresolvable
# CLAUDE_KLABAUTER_ROOT or an ImportError (this trampoline's own transport failure)
# exits 3 (_TRANSPORT_FAIL — "the claude-klabauter engine could not be reached," never
# silently degraded to 0/1). A usage error (missing/unknown subcommand,
# wrong arity, no --sha given, an invalid `grant` enum/cross-field value
# caught as ValueError) exits 2.
#
# Invocation (2026-07-28): `python3 coordinator/bin/review-trail-vouch-cli
# <subcommand> ...` — an explicit interpreter, not a bare-name/shebang-exec
# invocation. This file carries no shebang and no exec bit: POSIX-only
# execution assumptions (env-stripped shebang, extensionless-plus-shebang
# bare invocability, reliance on the git exec-mode bit) are a portability
# defect class per the 2026-07-28 PM ruling (Windows is the P0 primary
# platform), enforced by `coordinator_core.ops.check_posix_exec_assumptions`.
# The co-located `.cmd` twin still gives bare-name coverage on Windows
# (PATHEXT resolution) — this trampoline was never bare-invoked there.
from __future__ import annotations
"""review-trail-vouch-cli — see the # comment block above for the RAG-bait
purpose text (this triple-quoted string is deliberately NOT the first
statement in the file — the `from __future__ import annotations` above it
makes this a silently-discarded expression statement, not the module
__doc__ — same convention as tier-u-grant-cli / session-liveness-cli /
session-claim-cli)."""

import json
import os
import sys

_LIB_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)
from cc_invoke import _resolve_claude_klabauter_root  # noqa: E402

_TRANSPORT_FAIL = 3


def _import_module():
    claude_klabauter_root = _resolve_claude_klabauter_root()
    if claude_klabauter_root not in sys.path:
        sys.path.insert(0, claude_klabauter_root)
    import coordinator_core.session.review_trail_vouch as _mod

    return _mod


_SUBCOMMANDS = "subcommands: grant | read | check"

_HELP_FLAGS = ("--help", "-h", "help")


def _usage(prog: str) -> int:
    print(f"usage: {prog} <subcommand> <args...>\n{_SUBCOMMANDS}", file=sys.stderr)
    return 2


def _bool_to_exit(result: bool) -> int:
    return 0 if result else 1


def _parse_sha_args(rest: list[str]):
    """Hand-rolled parse of argv shared by `grant`/`check`: an optional set
    of positionals (grant: exactly one, the note; check: none) plus one or
    more `--sha <token>` flags anywhere in the remaining argv. Returns
    (positionals, shas) or None on a malformed arg list (a dangling `--sha`
    with no following value)."""
    shas: list[str] = []
    positional: list[str] = []
    i = 0
    while i < len(rest):
        if rest[i] == "--sha":
            if i + 1 >= len(rest):
                return None
            shas.append(rest[i + 1])
            i += 2
            continue
        positional.append(rest[i])
        i += 1
    return positional, shas


def main(argv: list[str]) -> int:
    if not argv:
        return _usage("review-trail-vouch-cli")
    subcmd, rest = argv[0], argv[1:]

    if subcmd in _HELP_FLAGS:
        print(f"usage: review-trail-vouch-cli <subcommand> <args...>\n{_SUBCOMMANDS}")
        return 0

    try:
        mod = _import_module()
    except RuntimeError as exc:
        print(f"review-trail-vouch-cli: CLAUDE_KLABAUTER_ROOT resolution failed: {exc}", file=sys.stderr)
        return _TRANSPORT_FAIL
    except ImportError as exc:
        print(f"review-trail-vouch-cli: coordinator_core.session.review_trail_vouch not importable: {exc}", file=sys.stderr)
        return _TRANSPORT_FAIL

    if subcmd == "grant":
        parsed = _parse_sha_args(rest)
        if parsed is None:
            return _usage(
                "review-trail-vouch-cli grant <granted_by> <note> --sha <sha> [--sha <sha> ...]"
            )
        positional, shas = parsed
        if len(positional) != 2 or not shas:
            return _usage(
                "review-trail-vouch-cli grant <granted_by> <note> --sha <sha> [--sha <sha> ...]"
            )
        granted_by, note = positional
        try:
            return _bool_to_exit(
                mod.write_review_trail_vouch(shas, note, granted_by=granted_by)
            )
        except ValueError as exc:
            print(f"review-trail-vouch-cli: grant: {exc}", file=sys.stderr)
            return 2

    if subcmd == "read":
        if rest:
            return _usage("review-trail-vouch-cli read")
        record = mod.read_review_trail_vouch()
        if record is not None:
            print(json.dumps(record))
        return 0

    if subcmd == "check":
        parsed = _parse_sha_args(rest)
        if parsed is None:
            return _usage("review-trail-vouch-cli check --sha <sha> [--sha <sha> ...]")
        positional, shas = parsed
        if positional or not shas:
            return _usage("review-trail-vouch-cli check --sha <sha> [--sha <sha> ...]")
        vouched, _record = mod.check_review_trail_vouch(shas)
        for sha in sorted(vouched):
            print(sha)
        return _bool_to_exit(set(shas) <= vouched)

    print(f"review-trail-vouch-cli: unknown subcommand {subcmd!r}", file=sys.stderr)
    return _usage("review-trail-vouch-cli")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
