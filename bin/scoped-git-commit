#!/usr/bin/env python3
# scoped-git-commit — CLI trampoline over claude-klabauter's `ceremony.scoped_git_commit`
# op (coordinator_core/ops/ceremony/scoped_git_commit.py), the mechanism DoE's
# always-loaded doctrine routes ordinary scoped commits to
# (`coordinator/snippets/em-operating-doctrine.md` ~:422: "it selects the
# agree-case form vs. an isolated private-index mechanism for you").
#
# WHY THIS FILE EXISTS: the op was registered and correct, and had NO caller-
# reachable entrypoint. An EM session's only CLI surface is the settings-home
# forwarder dir, whose contents are DERIVED from a scan of this directory, so
# an op with no artifact here is unreachable without hardcoding a claude-klabauter path
# — which reads to a caller exactly like no mechanism at all, and left the
# reachable-but-wrong `coordinator-safe-commit` as the only thing a
# scoped-commit advisory could name. Sourced from doe-claude-em's 2026-07-29
# memo (`cross-repo/archive/2026-07-29-doe-claude-em-safe-commit-advisory-
# offers-a-mode-that-does-not-exist.md`), ask option 1.
#
# The argument grammar deliberately mirrors `git commit`'s own scoped form
# (`-m <subject> -- <paths>...`) so the command an agent already knows how to
# type IS the command that gets the mechanism selection for free. That is the
# discharge test applied to this rule: the correct path is cheaper than the
# wrong one, rather than documented next to it.
#
# Contract: DoE-claude coordinator/docs/wiki/scoped-safety-commits.md
#   § SC-DR-015 (agree-case vs. private-index discriminator)
# Registration seam: a new engine capability registers by shipping a thin
# bin/ trampoline over a coordinator_core op — same shape as cross-repo-memo
# (route_mutation variant) rather than the direct-import variant, because
# `ceremony.scoped_git_commit` is a registered async op, not a plain module
# entrypoint.
#
# Usage:
#   scoped-git-commit -m "<subject>" -- <path> [<path>...]
#   scoped-git-commit -F <path> -- <path> [<path>...]
#   scoped-git-commit -F - -- <path> [<path>...]
#     Reads the subject from <path> (or stdin, for `-F -`) instead of `-m`,
#     mirroring `git commit -F`. `-m` and `-F` are mutually exclusive. Exists
#     to give agents a way out of the here-string trap on this seam: `-m`
#     forces a multi-line message through a single argv token, and this
#     fleet's Windows box has already mangled a commit subject once via the
#     PowerShell `@'...'@` idiom used from the Bash tool (a literal `@` became
#     the subject; exit 0; damage visible only in `git log --format=%s`).
#   scoped-git-commit -m "<subject>" --repo <worktree-root> -- <path>...
#     Stages exactly <paths>, commits them under <subject>, and pushes when a
#     remote exists. Selects the agree-case form vs. the private-index form
#     from index/worktree state — the caller never classifies the horn. A
#     directory named in <paths> is expanded (2026-08-06) to its dirty
#     TRACKED files beneath it and each is classified individually — never
#     untracked content, and a directory with nothing dirty tracked beneath
#     it still refuses (see the op's own docstring). Still never STAGES an
#     untracked file beneath a named directory (2026-08-12) — but now SAYS
#     SO in the output (count, a capped path sample, and the invocation to
#     include them explicitly) instead of silently omitting it. MUTATING.
#   scoped-git-commit --json ...
#     Emit the op's raw result envelope instead of the human line.
#   scoped-git-commit -m "<subject>" --pathspec-from-file <path>
#     Newline-delimited pathspec from a file instead of argv -- mutually
#     exclusive with `-- <paths>`. Windows caps a CreateProcess command line
#     at 32767 chars, which a several-thousand-path pathspec exceeds; this
#     is the way out (state/bug-backlog percolate-round WinError 206).
#
# Exit codes:
#   0 — a commit landed, OR a benign no-op (nothing to commit).
#   1 — business failure (op refusal with no more specific code below: gate
#       failed, ownership/pathspec refusal, or a reason this CLI does not
#       yet recognize).
#   2 — usage error.
#   3 — transport failure (CLAUDE_KLABAUTER_ROOT unresolvable / seam absent).
#   4 — --stage-patch refusal: the patch did not apply (reason:
#       "patch-did-not-apply").
#   5 — --stage-patch refusal: a supplied blob's HEAD CAS check failed
#       (reason: "head-blob-cas-refusal").
#   6 — --stage-patch refusal: an index/HEAD CAS check failed (reason:
#       "index-head-cas-refusal").
#   7 — the commit step itself failed after staging (reason:
#       "commit-failure").
from __future__ import annotations
"""scoped-git-commit — see the # comment block above for the RAG-bait purpose
text (the shebang line makes THIS triple-quoted string a discarded expression
statement, not the module __doc__ — same convention as close-out-and-stamp)."""

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

_LIB_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)
from cc_invoke import ensure_engine_on_path, route_mutation  # noqa: E402
from raw_cmdline_recovery import (  # noqa: E402
    RAW_CMDLINE_FILE_ENV,
    UnsoundRawCmdlineTransport,
    recover_windows_argv,
    spawn_shape_prefix,
)

_OP = "ceremony.scoped_git_commit"

#: The .cmd launcher's own basename — used by `recover_windows_argv` to
#: locate where this invocation's own arguments begin within the raw
#: `%CMDCMDLINE%` capture (see `raw_cmdline_recovery` module docstring for
#: the full caret-eating-defect recovery contract; this CLI is one of the
#: two `_RAW_CMDLINE_ENTRYPOINTS` members, alongside
#: `coordinator-write-review-trail.py`, sharing that module's implementation).
_LAUNCHER_CMD_NAME = "scoped-git-commit.cmd"

# C2b (docs/plans/2026-08-15-the-caret-fix-went-to-the-caller-that-never-
# broke.md): detect-and-record, NOT refuse, on `UnsoundRawCmdlineTransport`.
# The named limitation is soundness is not decidable from the capture text
# alone -- refusal here would fleet-break committing for ~40 concurrent
# sessions on a heuristic with known false-refusal shapes. This ledger exists
# so a follow-up chunk can flip to refusal once it shows zero unsound-or-
# unknown classifications among invocations that themselves succeeded.
_RAW_CMDLINE_LEDGER_PATH = os.path.join(
    os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))),
    "state",
    "raw-cmdline-transport-ledger.jsonl",
)


def _peek_raw_cmdline_capture() -> str | None:
    """Best-effort, non-destructive peek at the raw `%CMDCMDLINE%` capture
    file BEFORE `recover_windows_argv` reads-and-deletes it, so a subsequent
    `UnsoundRawCmdlineTransport` can still be logged with the text that
    justified it -- the exception itself carries only the classification
    (SOUND/UNSOUND/UNKNOWN), never the raw text (see
    `raw_cmdline_recovery.UnsoundRawCmdlineTransport`'s own docstring). Never
    raises; any failure here must not affect the real recovery path below.
    """
    raw_file = os.environ.get(RAW_CMDLINE_FILE_ENV)
    if not raw_file:
        return None
    try:
        return Path(raw_file).read_text(encoding="utf-8", errors="replace").rstrip("\r\n")
    except OSError:
        return None


def _record_unsound_raw_cmdline_transport(
    entrypoint: str, exc: Exception, raw_capture: str | None
) -> None:
    """C2b's detect-and-record consequence for `UnsoundRawCmdlineTransport`:
    warns on stderr and appends one JSONL row to the shared observation
    ledger. Never raises, never changes the caller's exit code -- the caller
    falls back to proceeding on the un-recovered (possibly caret-mangled)
    argv, same as `recover_windows_argv`'s own other fail-safe branches.

    Row: classification (parsed off `str(exc)`'s leading token -- the only
    structured signal the exception carries), the entrypoint name, a UTC ISO
    timestamp, and `spawn_shape` -- the leading transport tokens (comspec
    path, `/d`/`/s`/etc., the `/c`/`/k` switch itself) `spawn_shape_prefix`
    extracts from the raw capture, NEVER the remainder that follows the
    switch. The remainder is the caller's actual command and argument
    payload -- a commit message, memo body, or `--note` value can carry
    secrets or sensitive text, and this ledger is shared append-space across
    ~40 concurrent sessions (docs/wiki/machine-load-norm.md), readable by
    every one of them. The ledger's own purpose only needs the transport
    SHAPE: refusal on these two entrypoints flips on once the ledger shows a
    caller-shape distribution with zero unsound-or-unknown classifications
    among invocations that succeeded (C2b's flip-condition), which is a
    question about spawn shape, never about payload content.

    Concurrency: `state/` is shared append-space across ~40 concurrent
    sessions (docs/wiki/machine-load-norm.md). A single `os.open` with
    `O_APPEND | O_CREAT` plus one `os.write` call keeps each row's bytes from
    tearing into a concurrent writer's row; cross-process row ORDER is not
    guaranteed and does not need to be.

    Message register (docs/wiki/guard-messaging.md § Register): one fact,
    one terse pointer at the ledger, no self-legitimacy, no apology -- and
    critically, no language implying the operation was stopped, because it
    was not.
    """
    classification = (str(exc).split(":", 1)[0].strip()) or "UNKNOWN"
    # Review: coordinator:code-reviewer (9245562b, P2) -- persist only the
    # spawn-shape prefix, never the raw payload; see docstring above.
    spawn_shape = spawn_shape_prefix(raw_capture or "")
    print(
        "%s: warning: raw cmdline transport for this invocation could not be "
        "vouched for (%s) -- proceeding on possibly-mangled argv. Recorded to "
        "%s." % (entrypoint, classification, _RAW_CMDLINE_LEDGER_PATH),
        file=sys.stderr,
    )
    row = {
        "classification": classification,
        "spawn_shape": spawn_shape,
        "entrypoint": entrypoint,
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }
    try:
        os.makedirs(os.path.dirname(_RAW_CMDLINE_LEDGER_PATH), exist_ok=True)
        line = (json.dumps(row, sort_keys=True) + "\n").encode("utf-8")
        fd = os.open(
            _RAW_CMDLINE_LEDGER_PATH, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o644
        )
        try:
            os.write(fd, line)
        finally:
            os.close(fd)
    except OSError:
        pass  # best-effort -- a ledger write failure must never block the commit path


_EXIT_OK = 0
_EXIT_BUSINESS_FAIL = 1
_EXIT_USAGE = 2
_EXIT_TRANSPORT_FAIL = 3
# Review: coordinator:code-reviewer (88f5accd, finding 2) -- AC7
# (docs/plans/2026-08-14-the-tool-stages-what-it-commits.md) requires each
# of the pipeline's machine-readable `reason` values to carry "a distinct
# exit path in the CLI ... not merely all lumped as non-zero". Before this
# fix all four refusal reasons below shared `_EXIT_BUSINESS_FAIL`,
# distinguishable only via the JSON `reason` field -- literally "lumped as
# non-zero". Codes start at 4 (never colliding with 0-3 above or with any
# git exit code, which never returns >1 for `git commit`/`git apply`).
_EXIT_PATCH_DID_NOT_APPLY = 4
_EXIT_HEAD_BLOB_CAS_REFUSAL = 5
_EXIT_INDEX_HEAD_CAS_REFUSAL = 6
_EXIT_COMMIT_FAILURE = 7
#: The staging primitive failed for a reason that is NOT a bad patch --
#: `read-tree`/`ls-files` against the private index. Distinct from
#: `_EXIT_PATCH_DID_NOT_APPLY` because telling an operator their patch is bad
#: when the index infrastructure faulted sends them to debug the wrong artifact.
_EXIT_STAGE_INFRA_FAILURE = 8

#: `result["reason"]` -> distinct exit code, for the four AC7 refusal
#: reasons `ops/ceremony/commit_pipeline.py` can set. A `reason` NOT in this
#: map (a reason this CLI predates, e.g. a sibling infra-failure reason
#: `git_native.py` mints independently, or none at all -- an ownership/
#: pathspec refusal with no `reason` key) deliberately falls through to
#: `_EXIT_BUSINESS_FAIL`, never to `_EXIT_OK`: an unmapped refusal is still
#: a refusal, and this mapping's whole point is to never let one collapse
#: into a success exit merely because this CLI has not been taught its
#: code yet.
_EXIT_CODE_BY_REASON = {
    "patch-did-not-apply": _EXIT_PATCH_DID_NOT_APPLY,
    "head-blob-cas-refusal": _EXIT_HEAD_BLOB_CAS_REFUSAL,
    "index-head-cas-refusal": _EXIT_INDEX_HEAD_CAS_REFUSAL,
    "commit-failure": _EXIT_COMMIT_FAILURE,
    "stage-infra-failure": _EXIT_STAGE_INFRA_FAILURE,
}

_USAGE = (
    "usage: scoped-git-commit (-m \"<subject>\" | -F <path>) [--repo <worktree-root>]\n"
    "                        [--json] [--include-orphans]\n"
    "                        [--deliverable-id <id>] [--stage-patch <patchfile>]\n"
    "                        (-- <path> [<path>...] | --pathspec-from-file <path>)\n"
    "\n"
    "Stages and commits exactly <paths> via claude-klabauter's ceremony.scoped_git_commit,\n"
    "which selects the agree-case form vs. the private-index form from\n"
    "index/worktree state. A pathspec is REQUIRED, given one of two mutually\n"
    "exclusive ways: this CLI has no unscoped mode by construction.\n"
    "\n"
    "--pathspec-from-file <path> reads the pathspec from <path> instead of\n"
    "argv (newline-delimited; blank lines and `#`-prefixed comment lines\n"
    "skipped -- mirrors git's own `--pathspec-from-file`). Exists because\n"
    "Windows caps a CreateProcess command line at 32767 characters, which a\n"
    "several-thousand-path argv pathspec exceeds; a file has no such limit.\n"
    "Mutually exclusive with `-- <paths>` -- supplying both is a usage error,\n"
    "never a silent merge of the two sources.\n"
    "\n"
    "-F <path> reads the commit subject from <path> (UTF-8) instead of the\n"
    "argv-embedded `-m` form -- `-F -` reads it from stdin, mirroring\n"
    "`git commit -F`. Mutually exclusive with -m.\n"
    "\n"
    "--stage-patch <patchfile> (docs/plans/2026-08-14-the-tool-stages-what-\n"
    "it-commits.md): the tool stages what it commits. Applies <patchfile>\n"
    "under a process-private temporary index (never `git add`, never the\n"
    "shared repo index) and commits exactly the resulting content for every\n"
    "named path the patch covers -- provenance by construction, never by\n"
    "asking who a session is. A named path the patch does not cover still\n"
    "takes the ordinary staged-or-worktree route (additive per-path); named\n"
    "in the default plain-text output as well as `unprovenanced_paths` on\n"
    "--json output for that mixed shape. The patch\n"
    "file must exist and be readable -- refused before anything mutates.\n"
    "\n"
    "--deliverable-id <id> (C7a, docs/plans/2026-08-10-a-commit-trailer-\n"
    "that-names-the-session.md) forwards a caller-supplied deliverable_id to\n"
    "the op's own `deliverable_id` param -- see that param's own docstring\n"
    "(coordinator_core/ops/ceremony/scoped_git_commit.py) for validation and\n"
    "current wiring: accepted and validated here, then forwarded all the way\n"
    "to commit_scoped() (validated again there per AC19 before either commit\n"
    "mechanism runs).\n"
    "\n"
    "--include-orphans is RETIRED (accepted for backward compatibility, no\n"
    "effect on any outcome): the ceremony.scoped_git_commit op's own claim-\n"
    "conflict gate already lets a not-live claimant's path through without\n"
    "needing an opt-in, so there is no remaining semantics for this flag to\n"
    "relax. See that op's own docstring for the current gate's shape.\n"
    "\n"
    "Exit codes: 0 ok/no-op, 1 refusal (unrecognized reason), 2 usage,\n"
    "3 transport failure, 4 patch-did-not-apply, 5 head-blob-cas-refusal,\n"
    "6 index-head-cas-refusal, 7 commit-failure. See the # comment block\n"
    "at the top of this file for detail on each.\n"
)


class _Usage(Exception):
    """Argument-shape rejection — mapped to exit 2, never to a guess."""


def _read_message_file(path: str) -> str:
    """Reads `-F <path>`'s subject -- `-F -` reads stdin, mirroring
    `git commit -F -`. UTF-8 explicit (this box is Windows; the platform
    default encoding mangles non-ASCII bodies). A missing/unreadable path
    fails loud and early -- before any staging or git invocation -- rather
    than falling through to an empty subject.
    """
    if path == "-":
        return sys.stdin.read()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return fh.read()
    except OSError as exc:
        raise _Usage("-F %s: cannot read file: %s" % (path, exc))


def _read_pathspec_file(path: str) -> list[str]:
    """Reads `--pathspec-from-file <path>`'s newline-delimited pathspec list.

    Mirrors git's own `--pathspec-from-file` convention (newline-delimited;
    blank lines and `#`-prefixed comment lines skipped) rather than adding a
    `--pathspec-file-nul` companion -- this CLI's only caller
    (`percolate-round.py::_cmd_round`) composes ordinary repo-relative paths
    built from `git status --porcelain` output, none of which can
    legitimately contain a newline, so the NUL variant's sole purpose (paths
    that themselves contain a newline) has no live caller here. Not
    implemented; revisit only if a caller with newline-bearing paths
    appears. `str.splitlines()` already normalizes CRLF vs LF line endings,
    so no separate carriage-return stripping is needed here the way
    `_parse_args`'s argv branch needs one for its own mangled-input defect.

    A missing/unreadable file fails loud before anything mutates -- same
    contract as `_read_message_file`.
    """
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError as exc:
        raise _Usage(
            "--pathspec-from-file %s: cannot read file: %s" % (path, exc)
        )
    paths: list[str] = []
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        paths.append(line)
    return paths


def _parse_args(
    argv: list[str],
) -> tuple[str, str | None, list[str], bool, bool, str | None, str | None, list[str]]:
    """`(-m <subject> | -F <path>) [--repo <root>] [--json] [--include-orphans]
    [--deliverable-id <id>] [--stage-patch <patchfile>]
    (-- <paths>... | --pathspec-from-file <path>)`.

    Hand-rolled rather than argparse because the `--` separator is load-bearing
    here in git's own sense (everything after it is a pathspec, never a flag)
    and argparse's own `--` handling would swallow it before this function
    could require it.

    `--pathspec-from-file` is resolved into the SAME `paths` list the argv
    `-- <paths>` form produces, at this earliest possible point -- every
    downstream consumer (`main()`'s `params["paths"]`, and therefore the
    op's own validation, claim-conflict, and provenance machinery) sees one
    pathspec source, never two. Mutually exclusive with the argv `--
    <paths>` form: two sources of truth for the pathspec being committed is
    exactly the ambiguity this CLI's whole design exists to rule out (see
    the module-level `#` comment's "the argument grammar deliberately
    mirrors git commit's own scoped form" rationale).
    """
    subject: str | None = None
    message_file: str | None = None
    repo: str | None = None
    as_json = False
    include_orphans = False
    deliverable_id: str | None = None
    stage_patch: str | None = None
    pathspec_from_file: str | None = None
    paths: list[str] = []
    saw_separator = False

    mangled_cr_paths: list[str] = []
    i = 0
    n = len(argv)
    while i < n:
        tok = argv[i]
        if saw_separator:
            # 2026-08-10 fix (P1 live incident): a caller composing the
            # pathspec from a CRLF-authored file via unquoted
            # `$(cat file | tr '\n' ' ')` gets a trailing `\r` glued onto
            # every token but the last -- `tr` only ever sees `\n`, so the
            # `\r` half of each CRLF survives into the shell word. No real
            # path can legitimately end in a carriage return, so a trailing
            # `\r` here is unambiguous transport damage, never a caller's
            # actual intent -- stripped rather than passed through to land
            # on `explicit_stage()`'s "genuinely absent" branch as 54
            # separate, individually-plausible-looking false declines (the
            # incident shape: 1 clean path -- the one with no trailing `\r`
            # -- committed; the other 54 were refused with a reason that
            # was, in isolation, indistinguishable from a real absence).
            # Every stripped token is named on stderr, not silently fixed --
            # a caller whose shell composition is producing mangled input
            # needs to know, even though this run now proceeds correctly.
            if tok.endswith("\r"):
                mangled_cr_paths.append(tok)
                tok = tok[:-1]
            paths.append(tok)
            i += 1
            continue
        if tok == "--":
            saw_separator = True
            i += 1
            continue
        if tok in ("-m", "--message"):
            if i + 1 >= n:
                raise _Usage("%s requires a subject argument." % tok)
            # A second -m must fail loud, not silently overwrite the first: this
            # tool takes exactly one subject and does NOT concatenate repeated
            # -m like `git commit` does. On the live shared commit path, a
            # silent overwrite discards operator-authored content before the
            # commit lands.
            if subject is not None:
                raise _Usage(
                    "a second %s was given; this tool takes exactly one "
                    "subject and does not concatenate repeated -m like "
                    "`git commit` does. Use -F/--file for a multi-paragraph "
                    "message." % tok
                )
            subject = argv[i + 1]
            i += 2
            continue
        if tok in ("-F", "--file"):
            if i + 1 >= n:
                raise _Usage("%s requires a path argument." % tok)
            message_file = argv[i + 1]
            i += 2
            continue
        if tok == "--repo":
            if i + 1 >= n:
                raise _Usage("--repo requires a path argument.")
            repo = argv[i + 1]
            i += 2
            continue
        if tok == "--json":
            as_json = True
            i += 1
            continue
        if tok == "--include-orphans":
            include_orphans = True
            i += 1
            continue
        if tok == "--deliverable-id":
            if i + 1 >= n:
                raise _Usage("--deliverable-id requires an id argument.")
            deliverable_id = argv[i + 1]
            i += 2
            continue
        if tok == "--stage-patch":
            if i + 1 >= n:
                raise _Usage("--stage-patch requires a patch file argument.")
            stage_patch = argv[i + 1]
            i += 2
            continue
        if tok == "--pathspec-from-file":
            if i + 1 >= n:
                raise _Usage("--pathspec-from-file requires a path argument.")
            pathspec_from_file = argv[i + 1]
            i += 2
            continue
        if tok in ("-h", "--help"):
            raise _Usage("")
        raise _Usage("unrecognized argument %r (paths go after `--`)." % tok)

    if subject is not None and message_file is not None:
        raise _Usage("-m and -F are mutually exclusive; pass only one.")
    if subject is None and message_file is None:
        raise _Usage("-m \"<subject>\" or -F <path> is required.")
    if message_file is not None:
        subject = _read_message_file(message_file)
    if pathspec_from_file is not None:
        if saw_separator:
            raise _Usage(
                "--pathspec-from-file and the `-- <paths>` argv form are "
                "mutually exclusive; pass the pathspec one way or the "
                "other, never both."
            )
        paths = _read_pathspec_file(pathspec_from_file)
        if not paths:
            raise _Usage(
                "--pathspec-from-file %s named no paths (empty, or only "
                "blank/comment lines) — this CLI has no unscoped mode."
                % pathspec_from_file
            )
    elif not saw_separator:
        forwarder_path = os.path.abspath(__file__)
        raise _Usage(
            "the `-- <paths>` separator is required — this CLI has no unscoped "
            "mode. Name the paths this commit owns. From PowerShell, quote it as "
            "'--' — PowerShell's binder consumes a bare `--` while parsing the "
            "call to this script, so it never reaches this CLI. On a Restricted "
            "execution policy (the Windows 11 default, where the .ps1 launcher "
            "never runs), invoke `python %s ...` instead — it preserves argv "
            "intact regardless of policy." % forwarder_path
        )
    elif not paths:
        raise _Usage("`--` was given with no paths after it.")
    return (
        subject, repo, paths, as_json, include_orphans, deliverable_id, stage_patch,
        mangled_cr_paths,
    )


def _preflight_reap_stale_lock(worktree_root: str) -> None:
    """Best-effort orphaned-`.git/index.lock` self-heal, run once before this
    CLI's own git call lands on the pre-flight path.

    `guard_reap_stale_git_lock`'s PreToolUse guard only recognizes a bare
    `git` in command position (`_seg_resolved_git_subcommand`) — a
    `scoped-git-commit` invocation never matches it, even from the repo
    root, so the engine's own sanctioned commit wrapper had no self-heal of
    its own (state/bug-backlog/2026-08-12-scoped-git-commit-is-not-a-raw-
    git-invoc-f4fff3a626fa.yaml, P1). A guard that pattern-matches command
    text can never cover every wrapper; the wrapper has to self-heal.

    Thin trampoline over the shared leaf policy,
    `coordinator_core.lock_preflight.preflight_reap_stale_lock` — see that
    module's docstring for the full contract, negative-spec, and why BOTH
    this CLI and `ops/ceremony/commit_pipeline.py::run_commit_pipeline` call
    it (deliberately, not duplicatively).
    """
    ensure_engine_on_path(os.path.abspath(__file__))
    from coordinator_core.lock_preflight import preflight_reap_stale_lock

    preflight_reap_stale_lock(worktree_root)


def _worktree_root(explicit: str | None) -> str:
    """Explicit `--repo` wins; otherwise the enclosing worktree's own root,
    asked of git rather than assumed to be cwd (an agent frequently runs from
    a subdirectory, and the op's `paths` are repo-relative)."""
    if explicit:
        return os.path.abspath(explicit)
    ensure_engine_on_path(os.path.abspath(__file__))
    from coordinator_core.git.repo_root import show_toplevel

    toplevel = show_toplevel()
    if not toplevel:
        raise _Usage("not inside a git worktree (and no --repo given)")
    return toplevel


def _legacy_absent() -> None:
    """State-1 (claude-klabauter seam absent) has no bash predecessor to fall back to —
    this CLI is native-only from birth. Raising here lets `route()` wrap the
    failure in its own four-rung CLAUDE_KLABAUTER_ROOT remediation message rather than
    this file re-deriving one."""
    raise RuntimeError(
        "scoped-git-commit has no legacy fallback: it is a thin trampoline over "
        "claude-klabauter's %s op and needs the coordinator_core seam present." % _OP
    )


# Human renderings of the op's `push_state` tri-state. `unconfirmed` deliberately
# does NOT read as a failure and names no corrective action: the commit is local,
# the remote could not be read, and the reader's cheapest correct next move is to
# re-check, never to re-push or amend. Sourced from doe-claude-em's 2026-07-30
# memo (`cross-repo/archive/2026-07-30-doe-claude-em-scoped-git-commit-misreports-
# push-state.md`) — a two-valued report rendered an in-flight push identically to
# a failed one, and the corrections that invites (re-push, amend, force-push) are
# more dangerous on an auto-push-armed shared branch than the symptom.
#: A diagnostic that is nothing but the subprocess exit code explains nothing —
#: `git commit` exits 1 on an empty commit set, so the benign already-committed
#: no-op arrives carrying exactly this and no more. Used by `_render` to tell a
#: real refusal (which names its cause in prose) from that ordinary outcome.
_BARE_EXIT_CODE_RE = re.compile(r"^exit_code=\d+$")

_PUSH_NOTES = {
    "pushed": "pushed",
    "push-failed": "PUSH FAILED — commit is local only",
    "unconfirmed": "push unconfirmed — re-check, do not re-push",
    "no-remote": "no remote",
    # 2026-08-10 fix: a bare "declined" push-state note (falling through to
    # the `elif push_state:` branch below before this key existed) rendered
    # as the single word "(declined)" on EVERY commit this branch-policy
    # ever declines a push for -- including a fully clean, nothing-else-
    # wrong commit -- and read identically to a PATH decline
    # (`_declined_note`'s "DECLINED N named path(s)"). Two unrelated facts
    # sharing one word made "declined" useless as a signal either way. This
    # note is now unambiguous prose naming what was declined (the PUSH, by
    # branch policy) so it can never be misread as a path-level refusal.
    "declined": "push declined by branch policy — commit is local only",
}

# Negative-spec: the op's `ownership_gate` response key (and this CLI's
# rendering of it, `_OWNERSHIP_NOTES`/`_ownership_note`) was deliberately
# excised 2026-08-08 (commits de277165 + e90cdfb2; archived spec
# archive/specs/2026-08/2026-08-08-claim-index-the-commit-gate-never-had.md).
# `ceremony.scoped_git_commit` now enforces via `_check_claim_conflicts`
# (O(pathspec): allows an unclaimed path, denies only a live peer's claim)
# and never emits `ownership_gate` at all. Do not re-add a renderer for it.


def _declined_note(result: dict) -> str:
    """Renders the op's `declined_paths` as an operator-facing suffix, or "".

    A path the caller NAMED and the op did not commit must never leave through
    a rendered line that does not say so. The motivating incident: two commits
    named a deleted path in their pathspec, the op dropped it, and this
    renderer printed a bare `committed <sha>` both times -- so both commit
    MESSAGES assert a removal that never landed, and nothing prompted anyone to
    check. A commit route that writes false statements into the audit trail is
    worse than one that refuses, which is the same failure shape `_render`'s own
    REFUSED branch was already fixed for once (see its comment below).

    Applied to EVERY branch of `_render`, deliberately -- the success branch is
    the one that bit, precisely because success is where nobody looks.
    """
    declined = result.get("declined_paths") or []
    if not isinstance(declined, list) or not declined:
        return ""
    parts = []
    for entry in declined:
        if isinstance(entry, dict):
            path = str(entry.get("path", "?"))
            reason = str(entry.get("reason", "")).strip()
            parts.append("%s (%s)" % (path, reason) if reason else path)
        else:
            parts.append(str(entry))
    return " — DECLINED %d named path(s), NOT committed: %s" % (
        len(parts),
        "; ".join(parts),
    )


def _worktree_excluded_note(result: dict) -> str:
    """Renders the op's `worktree_excluded` as a LOUD operator-facing suffix,
    or "" when the engine did not send one.

    state/bug-backlog/2026-08-10-scoped-git-commit-reports-success-while-
    334e90d707f9.yaml: the private-index branch commits a diverged path's
    STAGED content, not its worktree content — a legitimate success, but a
    bare `committed <sha>` is indistinguishable from "your worktree edits
    are in this commit", which they are not. Applied only where `committed`
    is true (the op never sets this key otherwise) — see `_render`'s own
    call site.
    """
    excluded = result.get("worktree_excluded") or []
    if not isinstance(excluded, list) or not excluded:
        return ""
    return " — WARNING: worktree edits to %d named path(s) NOT included (staged/index content committed instead): %s" % (
        len(excluded),
        ", ".join(str(p) for p in excluded),
    )


def _unprovenanced_note(result: dict) -> str:
    """Renders the op's `unprovenanced_paths` as an operator-facing suffix,
    or "" when the engine did not send one.

    Review: coordinator:code-reviewer (88f5accd, finding 1) -- AC4 documents
    this field as mirroring `worktree_excluded`/`declined_paths`'s "never a
    silent drop" posture, but until this fix it was surfaced only via
    `--json`, never in the default plain-text render `_render` builds. An
    operator running `--stage-patch` without `--json` saw a bare `committed
    <sha>` with nothing indicating part of the commit was worktree- rather
    than patch-sourced. Applied on every branch that reaches it, same
    "success is where nobody looks" rationale as the other suffix renderers
    in this file.
    """
    unprovenanced = result.get("unprovenanced_paths") or []
    if not isinstance(unprovenanced, list) or not unprovenanced:
        return ""
    return " — NOTE: %d named path(s) NOT covered by --stage-patch, committed via ordinary staged/worktree content instead: %s" % (
        len(unprovenanced),
        ", ".join(str(p) for p in unprovenanced),
    )


def _untracked_omitted_note(result: dict, paths: list[str], repo: str | None) -> str:
    """Renders the op's `untracked_paths_omitted` as an operator-facing
    suffix, or "" when the engine did not send one.

    state/bug-backlog/2026-08-12-scoped-git-commit-silently-omits-
    untracked-files-in-a-pathspec.yaml: a directory named in the pathspec
    silently dropped every untracked file beneath it, with nothing in the
    output saying so -- caught only by an unprompted `git status`
    afterward, which is not a mechanism. Applied on EVERY branch of
    `main()`'s printed line (success and refusal alike), mirroring
    `_declined_note`/`_worktree_excluded_note`'s own "success is where
    nobody looks" rationale. Reporting only -- untracked files are, by
    design, never swept into the commit; this never changes exit code.
    """
    info = result.get("untracked_paths_omitted")
    if not isinstance(info, dict):
        return ""
    listed = info.get("paths") or []
    if not listed:
        return ""
    count = info.get("count", len(listed))
    truncated = info.get("truncated", False)
    shown = ", ".join(str(p) for p in listed)
    if truncated:
        shown += " (and %d more)" % (count - len(listed))
    repo_flag = " --repo %s" % repo if repo else ""
    include_cmd = 'scoped-git-commit -m "<subject>"%s -- %s %s' % (
        repo_flag, " ".join(paths), " ".join(str(p) for p in listed)
    )
    return (
        " — NOTE: %d untracked file(s) beneath the named directory "
        "pathspec were NOT staged (untracked files are never swept into a "
        "commit by naming their parent directory, by design): %s — to "
        "include them, name them explicitly, e.g.: %s"
        % (count, shown, include_cmd)
    )


def _explanatory_diagnostics(result: dict) -> list[str]:
    """The subset of `result["diagnostics"]` that actually EXPLAINS a
    refusal — never a bare `exit_code=N` (see `_render`'s own comment on
    this discriminator, which this factors out of, unchanged in meaning).
    Shared by `_render` and `_exit_code_for_result` so the rendered line and
    the process exit code can never disagree about whether a given result
    was a real refusal.
    """
    return [
        str(d).strip()
        for d in (result.get("diagnostics") or [])
        if str(d).strip() and not _BARE_EXIT_CODE_RE.match(str(d).strip())
    ]


def _exit_code_for_result(result: dict) -> int:
    """Map the op's result envelope onto this CLI's own exit-code contract.

    2026-08-06 fix (live incident): `main()` previously printed `_render`'s
    output and unconditionally returned `_EXIT_OK` afterward — a REFUSED
    render (`commit_failed`, a denied ownership gate, a rejected pathspec)
    still exited 0. A caller checking the return code alone (the whole point
    of a return code) saw success with nothing committed — the exact
    silent-data-loss shape `d-run-wsc-tail`'s 0/1/2/3 ladder
    (coordinator/skills/workstream-complete/SKILL.md) exists to prevent.

    Deliberately mirrors `_render`'s own outcome classification instead of
    inventing a second one: a landed commit, the benign
    empty-commit-set/already-committed no-op (`reason == "empty-commit-
    set"`, or `diagnostics` with nothing EXPLANATORY in it — the same
    `_explanatory_diagnostics` filter `_render` itself applies, e.g. the
    bare `exit_code=1` `git commit` leaves behind on a no-op), is
    `_EXIT_OK`, matching this file's own documented contract ("0 — a commit
    landed, OR a benign no-op"). Every other shape — a real gate/commit
    refusal (explanatory diagnostics present), an ownership-gate denial or
    rejected pathspec (`"error"` key, no `"committed"` key at all) — is
    `_EXIT_BUSINESS_FAIL`: the op ran, and nothing landed.
    """
    # 2026-08-10 fix (P1 live incident: a 55-path commit that landed 1 path
    # and DECLINED 54 still printed "committed <sha>" and exited 0 -- a
    # caller checking the return code alone, the whole point of a return
    # code, saw success). Scoped to exactly the incident's own shape --
    # `committed: true` alongside a non-empty `declined_paths` -- and never
    # wider: `committed: false` with a lone declined path (e.g. a caller
    # naming one nonexistent path with nothing else to commit) is the
    # pre-existing benign "nothing to commit" outcome and stays `_EXIT_OK`
    # unless one of the branches below already says otherwise.
    if result.get("committed") and _declined_note(result):
        return _EXIT_BUSINESS_FAIL
    if result.get("committed"):
        return _EXIT_OK
    if result.get("error"):
        return _EXIT_BUSINESS_FAIL
    if _explanatory_diagnostics(result):
        # AC7 (finding 2 above): a real refusal keys its exit code off the
        # op's own `reason` when this CLI recognizes it, rather than
        # collapsing every refusal onto one shared code. See
        # `_EXIT_CODE_BY_REASON`'s own docstring for the unmapped-reason
        # fallback.
        return _EXIT_CODE_BY_REASON.get(result.get("reason"), _EXIT_BUSINESS_FAIL)
    return _EXIT_OK


def _render(result: dict) -> str:
    # Both suffixes ride every branch, the success branch included — success is
    # where nobody looks, and it is the branch both defects were reported on.
    declined_note = _declined_note(result)
    if result.get("committed"):
        worktree_excluded_note = _worktree_excluded_note(result)
        sha = result.get("sha") or "?"
        push_state = result.get("push_state")
        if push_state in _PUSH_NOTES:
            push_note = _PUSH_NOTES[push_state]
        elif push_state:
            push_note = str(push_state)
        else:
            # Pre-tri-state engine on the other side of the seam: a bare
            # `pushed` bool cannot distinguish failed from in-flight, so say
            # "unconfirmed" rather than asserting either certainty.
            push_note = {True: "pushed", False: "push unconfirmed", None: "no remote"}.get(
                result.get("pushed"), str(result.get("pushed"))
            )
        # 2026-08-10 fix (P1 live incident): a run that DECLINED any named
        # path must never lead with the word "committed" -- a caller reading
        # only the first word (or grepping for "^committed") saw success on
        # a run that silently dropped 54 of 55 named paths. Leading with
        # "PARTIAL" makes the decline the headline, not a trailing clause a
        # reader has to keep scanning for.
        if declined_note:
            return "PARTIAL — committed %s (%s)%s%s" % (
                sha[:12], push_note, declined_note, worktree_excluded_note
            )
        return "committed %s (%s)%s%s" % (
            sha[:12], push_note, declined_note, worktree_excluded_note
        )
    # The engine distinguishes THREE no-commit outcomes and says so in its own
    # response: a benign already-committed no-op ("reason": "empty-commit-set"),
    # a refusal with an explanation (`commit_failed` + `diagnostics` — e.g. a
    # rejected directory pathspec), and an integrity breach. Rendering only
    # `reason` collapsed all three into "nothing to commit", so a REFUSAL read as
    # benign success while the caller's files stayed staged on a shared branch,
    # waiting for the next bare commit to absorb them. `commit_failed` and
    # `diagnostics` exist precisely to be surfaced here — the engine's own
    # comment says a caller reading only `committed` cannot tell them apart.
    # Negative-spec: `commit_failed` alone does NOT mean a refusal worth
    # shouting about. `git commit` exits 1 on an empty commit set, so the
    # ordinary already-committed no-op also arrives as commit_failed with a
    # single content-free "exit_code=N" diagnostic. Rendering that as REFUSED
    # would cry wolf on the most common outcome there is. The discriminator is
    # whether a diagnostic actually EXPLAINS anything — a refusal carries prose
    # naming its cause, a benign no-op carries only the exit code.
    explanatory = _explanatory_diagnostics(result)
    if explanatory:
        return "REFUSED — no commit landed: %s%s" % (
            "; ".join(explanatory),
            declined_note,
        )
    reason = result.get("reason") or "nothing to commit"
    return "no commit landed: %s%s" % (reason, declined_note)


def main(argv: list[str]) -> int:
    try:
        (
            subject, repo, paths, as_json, include_orphans, deliverable_id, stage_patch,
            mangled_cr_paths,
        ) = _parse_args(argv)
        worktree_root = _worktree_root(repo)
    except _Usage as exc:
        message = str(exc)
        if message:
            print("scoped-git-commit: %s" % message, file=sys.stderr)
        print(_USAGE, file=sys.stderr)
        return _EXIT_USAGE

    _preflight_reap_stale_lock(worktree_root)

    if mangled_cr_paths:
        # Never silent (see `_parse_args`'s own comment on this strip): the
        # run proceeds with the corrected paths, but the caller's own
        # pathspec composition produced transport damage and needs to know,
        # or it recurs on every future invocation built the same way.
        print(
            "scoped-git-commit: warning: stripped a trailing carriage "
            "return ('\\r') from %d named path(s) -- your pathspec looks "
            "like it was built from a CRLF-authored file via something "
            "like `$(cat file | tr '\\n' ' ')`, which only translates the "
            "'\\n' half of CRLF and leaves '\\r' glued to every token but "
            "the last. Affected: %s"
            % (len(mangled_cr_paths), ", ".join(repr(p) for p in mangled_cr_paths)),
            file=sys.stderr,
        )

    params = {
        "worktree_root": worktree_root,
        "paths": paths,
        "message": subject,
        "include_orphans": include_orphans,
    }
    if deliverable_id is not None:
        params["deliverable_id"] = deliverable_id
    if stage_patch is not None:
        params["stage_patch"] = stage_patch
    try:
        result = route_mutation(_OP, params, worktree_root, _legacy_absent)
    except RuntimeError as exc:
        print("scoped-git-commit: %s" % exc, file=sys.stderr)
        offending = getattr(exc, "result", None)
        if isinstance(offending, dict):
            for diagnostic in offending.get("diagnostics") or []:
                print("  %s" % diagnostic, file=sys.stderr)
            return _EXIT_BUSINESS_FAIL
        return _EXIT_TRANSPORT_FAIL

    if not isinstance(result, dict):
        print("scoped-git-commit: unexpected op result shape: %r" % (result,), file=sys.stderr)
        return _EXIT_BUSINESS_FAIL

    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(
            _render(result)
            + _unprovenanced_note(result)
            + _untracked_omitted_note(result, paths, repo)
        )
    return _exit_code_for_result(result)


if __name__ == "__main__":
    _raw_capture = _peek_raw_cmdline_capture()
    try:
        _argv = recover_windows_argv(sys.argv[1:], _LAUNCHER_CMD_NAME)
    except UnsoundRawCmdlineTransport as _exc:
        # C2b: detect-and-record, not refuse -- see the constant/helpers
        # above for the full rationale and flip-condition.
        _record_unsound_raw_cmdline_transport(
            "scoped-git-commit", _exc, _raw_capture
        )
        _argv = sys.argv[1:]
    sys.exit(main(_argv))
