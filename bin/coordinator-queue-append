# ---------------------------------------------------------------------------
# Node CLI bridge — schema introspection and validation via schema-cli.js.
# Spec backlink: dual-yaml-parser option-d, C3
#
# Replaces the Python schema_loader module with subprocess calls to schema-cli.js
# so both the YAML-dialect and JSON-Schema-backed paths run through a single Node
# implementation. Two callers:
#   _build_yaml   → _schema_cli_describe  (--describe: field order for emit)
#   _validate     → _schema_cli_validate  (--validate: required-field + enum checks)
# ---------------------------------------------------------------------------

_SCHEMA_CLI = os.path.join(os.path.dirname(os.path.abspath(__file__)), "schema-cli.js")
_SUBPROCESS_TIMEOUT_SECS = 15  # hung node process must fail loud, not block indefinitely


def _schema_cli_describe(schema_name: str) -> dict:
    """Call node bin/schema-cli.js --describe <schema_name> and return parsed JSON.

    Returns {"required": [field names in schema order], "optional": [...], "enums": {...}}.
    The required/optional lists are ORDERED arrays — schema YAML key insertion order.

    Three failure classes (the Staff Engineer F3, mandatory):
    (a) ENOENT/spawn failure (node not found): fail loud with remediation — exits.
    (b) Non-zero exit with parseable JSON: infra error for --describe (no validation-rejection
        path on introspection); treated the same as (c).
    (c) Non-zero exit with no parseable output: infra crash — fail loud, exits.
    Subprocess timeout: fail loud — exits.

    Spec backlink: dual-yaml-parser option-d, C3
    """
    try:
        result = subprocess.run(
            ["node", _SCHEMA_CLI, "--describe", schema_name],
            capture_output=True,
            text=True,
            timeout=_SUBPROCESS_TIMEOUT_SECS,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except FileNotFoundError:
        # class (a): node not installed or not on PATH
        print(
            "error: 'node' not found — install Node.js and ensure it is on PATH "
            "to use coordinator-queue-append.",
            file=sys.stderr,
        )
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(
            f"error: schema-cli.js --describe timed out after {_SUBPROCESS_TIMEOUT_SECS}s. "
            "Check that Node.js is healthy.",
            file=sys.stderr,
        )
        sys.exit(1)

    if result.returncode != 0:
        # class (c): schema not found or schema load failure — infra error
        detail = result.stderr.strip() or result.stdout.strip()
        print(
            f"error: schema introspection failed for '{schema_name}': {detail}",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        return json.loads(result.stdout)
    except (json.JSONDecodeError, ValueError) as exc:
        # class (c): node exited 0 but emitted non-JSON — unexpected crash residue
        print(
            f"error: schema-cli.js --describe emitted non-JSON output: {exc}",
            file=sys.stderr,
        )
        sys.exit(1)


def _schema_cli_validate(schema_name: str, fields: dict) -> tuple[bool, list[str]]:
    """Pipe fields (as JSON) to node bin/schema-cli.js --validate <schema_name>.

    Returns (ok: bool, errors: list[str]).

    Three failure classes (the Staff Engineer F3, mandatory — do NOT collapse):
    (a) ENOENT/spawn failure (node not found): fail loud with remediation — exits.
    (b) Non-zero exit WITH parseable {ok: false, errors: [...]}: VALIDATION REJECTION.
        Returns (False, errors) — NOT an infra error; caller formats and reports.
    (c) Non-zero exit with no parseable verdict (crash/garbage): infra error — exits.
    Subprocess timeout: fail loud — exits.

    Spec backlink: dual-yaml-parser option-d, C3
    """
    stdin_json = json.dumps(fields, default=str)

    try:
        result = subprocess.run(
            ["node", _SCHEMA_CLI, "--validate", schema_name],
            input=stdin_json,
            capture_output=True,
            text=True,
            timeout=_SUBPROCESS_TIMEOUT_SECS,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except FileNotFoundError:
        # class (a): node not installed or not on PATH
        print(
            "error: 'node' not found — install Node.js and ensure it is on PATH "
            "to use coordinator-queue-append.",
            file=sys.stderr,
        )
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(
            f"error: schema-cli.js --validate timed out after {_SUBPROCESS_TIMEOUT_SECS}s. "
            "Check that Node.js is healthy.",
            file=sys.stderr,
        )
        sys.exit(1)

    # Try to parse a JSON verdict from stdout regardless of exit code.
    # A parseable {ok, errors} on a non-zero exit is class (b) — validation rejection,
    # not an infra error. A non-zero exit with no parseable JSON is class (c).
    verdict = None
    if result.stdout.strip():
        try:
            parsed = json.loads(result.stdout)
            if isinstance(parsed, dict) and "ok" in parsed:
                verdict = parsed
        except (json.JSONDecodeError, ValueError):
            pass

    if result.returncode == 0:
        # Success — ok:true
        return True, []

    if verdict is not None:
        # class (b): parseable validation response — normal rejection, caller handles
        errors = verdict.get("errors") or []
        if not isinstance(errors, list):
            errors = [str(errors)]
        return False, errors

    # class (c): non-zero exit with no parseable verdict — infra error
    detail = result.stderr.strip() or result.stdout.strip()
    print(
        f"error: schema-cli.js --validate failed (exit {result.returncode}): {detail}",
        file=sys.stderr,
    )
    sys.exit(1)


