{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "coordinator_root_path": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "repo"
      ]
    },
    "period_value": {
      "type": "string"
    },
    "declared_by_machine": {
      "type": "string"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "done",
        "superseded",
        "dropped"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "github_graphql",
            "github_rest",
            "local_fs",
            "coordinator_artifact"
          ]
        },
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "branch",
            "sha"
          ],
          "additionalProperties": false
        },
        "path": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "derivation": {
          "type": "string",
          "enum": [
            "raw",
            "parsed",
            "rolled_up"
          ]
        }
      },
      "required": [
        "source_kind",
        "repo",
        "ref",
        "path",
        "observed_at",
        "derivation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "goal_id",
    "repo",
    "coordinator_root_path",
    "period",
    "period_value",
    "declared_by_machine",
    "declared_at",
    "text",
    "status",
    "provenance"
  ],
  "additionalProperties": false
}
