{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "enum": [
        "dbc-oduffy",
        "Delphi-Interactive",
        "workstation"
      ]
    },
    "coordinator_root_path": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tip_sha": {
      "type": "string"
    },
    "merge_base_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ahead_by": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "behind_by": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "last_commit_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "last_commit_message": {
      "type": "string"
    },
    "machine_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "date_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "github_graphql",
            "github_rest",
            "local_fs",
            "coordinator_artifact"
          ]
        },
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "branch",
            "sha"
          ],
          "additionalProperties": false
        },
        "path": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "derivation": {
          "type": "string",
          "enum": [
            "raw",
            "parsed",
            "rolled_up"
          ]
        }
      },
      "required": [
        "source_kind",
        "repo",
        "ref",
        "path",
        "observed_at",
        "derivation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "repo",
    "owner",
    "coordinator_root_path",
    "name",
    "tip_sha",
    "merge_base_sha",
    "ahead_by",
    "behind_by",
    "last_commit_at",
    "last_commit_message",
    "machine_hint",
    "date_hint",
    "provenance"
  ],
  "additionalProperties": false
}
