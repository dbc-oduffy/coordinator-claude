{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "coordinator_root_path": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "consumed"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "session-handoff",
        "spinoff",
        "spinoff-roadmap",
        "recovery"
      ]
    },
    "deployment_state": {
      "type": "string",
      "enum": [
        "awaiting_gate",
        "ready_to_fire",
        "in_flight",
        "shipped",
        "abandoned"
      ]
    },
    "workstream": {
      "type": "string"
    },
    "predecessor": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "consumed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "shipped_in": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sha": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "sha",
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "picked_up_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_criteria": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "done": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "done",
            "total"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "github_graphql",
            "github_rest",
            "local_fs",
            "coordinator_artifact"
          ]
        },
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "branch",
            "sha"
          ],
          "additionalProperties": false
        },
        "path": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "derivation": {
          "type": "string",
          "enum": [
            "raw",
            "parsed",
            "rolled_up"
          ]
        }
      },
      "required": [
        "source_kind",
        "repo",
        "ref",
        "path",
        "observed_at",
        "derivation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "repo",
    "coordinator_root_path",
    "title",
    "created",
    "status",
    "kind",
    "deployment_state",
    "workstream",
    "predecessor",
    "scope",
    "consumed_by",
    "consumed_at",
    "shipped_in",
    "picked_up_by",
    "acceptance_criteria",
    "provenance"
  ],
  "additionalProperties": false
}
