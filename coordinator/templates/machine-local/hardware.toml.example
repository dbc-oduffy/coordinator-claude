# ~/.claude/machine-local/hardware.toml  (TRACKED — shared baseline)
#
# Spec backlink: docs/plans/2026-06-23-coordinator-install-surface-dogfood-hardening.md §C4
# Spec backlink: docs/wiki/machine-local-registry.md §5b (concern-file convention)
#
# Concern file for the `hardware.*` namespace.
#
# Ownership map (one writer per key):
#   hardware.cores    — detect-hardware.sh (install-time audit, idempotent re-run)
#   hardware.ram_gb   — detect-hardware.sh
#   hardware.gpu      — detect-hardware.sh (best-effort; may be absent)
#   hardware.vram_gb  — detect-hardware.sh (best-effort; may be absent)
#
# All actual values live in `hardware.local.toml` (gitignored, per-machine).
# This baseline carries the schema declaration only; do NOT pre-declare keys
# with empty strings here — an empty baseline value would mask "not provisioned
# yet" as "provisioned to empty" at the GET layer.

schema = 1

# Place machine-specific values in hardware.local.toml using the natural TOML
# table form (written automatically by detect-hardware.sh):
#
#   [hardware]
#   cores   = 12         # logical CPU count
#   ram_gb  = 32         # total physical RAM in GB (rounded)
#   gpu     = 'RTX 4090' # GPU model string (best-effort)
#   vram_gb = 24         # GPU VRAM in GB (best-effort)
