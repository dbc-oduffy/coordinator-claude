#!/usr/bin/env bash
# machine-local — thin shell wrapper for the machine-local registry reader.
#
# Spec backlink: docs/plans/2026-05-19-machine-local-registry.md §4.3
# Purpose: delegate all subcommands to _machine_local.py, resolving Python
# interpreter portably. Users call this wrapper; _machine_local.py is the
# implementation and is intentionally underscore-prefixed to discourage direct
# invocation.
#
# PORTABILITY: this wrapper is invoked by daemons under a stripped PATH, where
# `#!/usr/bin/env bash` can resolve to stock macOS /bin/bash (3.2) rather than the
# coordinator-installed brew bash 4+. It MUST stay bash-3.2 / POSIX-sh compatible
# — do NOT add bash-4 constructs (declare -A, mapfile, ${v^^}, &c.) here without a
# BASH_VERSINFO fail-loud guard (and note such a guard would itself break the
# stripped-PATH 3.2 case this wrapper exists to survive). Constructs used below
# (for / if / command -v / function def) are all bash-3.2-safe.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMPL="$SCRIPT_DIR/_machine_local.py"

if ! [ -f "$IMPL" ]; then
    echo "machine-local: implementation not found at $IMPL" >&2
    exit 2  # operational failure (see _machine_local.py exit-code contract)
fi

# Resolve a Python interpreter that satisfies _machine_local.py's >=3.11 guard.
# Naively taking the first `python3` on PATH is a footgun: under a stripped PATH
# (e.g. a daemon launched with PATH=/usr/bin:/bin) `python3` resolves to macOS
# system Python 3.9, which trips the impl's version guard and exits operational-
# fail — indistinguishable downstream from a genuinely-absent key. Probe candidates
# and pick the first that is >=3.11 so the wrapper self-heals for ANY caller
# regardless of inherited PATH. Cross-repo memo 2026-06-24 (daemon read-path).
_ml_py311_ok() {
    "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

PYTHON=""
# Explicit operator pin (resolution-order doctrine: explicit → env → discovery).
# A hot-path caller (e.g. a daemon issuing many `machine-local get` calls) can set
# MACHINE_LOCAL_PYTHON once at startup to bypass the probe loop's worst-case ~6
# subprocess spawns per invocation. Honoured verbatim — if the operator pins a
# guard-failing interpreter, the impl's own version guard fails loud with rc=2.
if [ -n "${MACHINE_LOCAL_PYTHON:-}" ]; then
    PYTHON="$MACHINE_LOCAL_PYTHON"
fi

# Version-pinned names first (most likely >=3.11 even under a stripped PATH that
# only carries an old generic python3), then the generics (catch a new-enough
# python3/python whatever its minor version, future-proofing past this list).
# Worst case ~6 probe spawns before the real exec; MACHINE_LOCAL_PYTHON skips it.
if [ -z "$PYTHON" ]; then
    for _cand in python3.14 python3.13 python3.12 python3.11 python3 python; do
        if command -v "$_cand" >/dev/null 2>&1 && _ml_py311_ok "$_cand"; then
            PYTHON="$_cand"
            break
        fi
    done
fi

if [ -z "$PYTHON" ]; then
    # No >=3.11 interpreter found. Exec the first available python anyway so the
    # impl's own version guard emits its actionable remediation (and the
    # operational exit code), rather than dying here with a vaguer message.
    for _cand in python3 python; do
        if command -v "$_cand" >/dev/null 2>&1; then
            PYTHON="$_cand"
            break
        fi
    done
fi

if [ -z "$PYTHON" ]; then
    echo "machine-local: no python3 (or python) found on PATH" >&2
    exit 2  # operational failure (see _machine_local.py exit-code contract)
fi

exec "$PYTHON" "$IMPL" "$@"
