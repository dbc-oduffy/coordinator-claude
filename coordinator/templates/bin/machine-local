#!/usr/bin/env bash
# machine-local — thin shell wrapper for the machine-local registry reader.
#
# Spec backlink: docs/plans/2026-05-19-machine-local-registry.md §4.3
# Purpose: delegate all subcommands to _machine_local.py, resolving Python
# interpreter portably. Users call this wrapper; _machine_local.py is the
# implementation and is intentionally underscore-prefixed to discourage direct
# invocation.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMPL="$SCRIPT_DIR/_machine_local.py"

if ! [ -f "$IMPL" ]; then
    echo "machine-local: implementation not found at $IMPL" >&2
    exit 1
fi

# Resolve Python interpreter: prefer python3, fall back to python.
# Review: code-reviewer (F10) — 'python' fallback retains Python 2 on some systems;
# _machine_local.py's version guard will fail-loud immediately if Python < 3.11 is chosen.
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "machine-local: python3 (or python) not found on PATH" >&2
    exit 1
fi

exec "$PYTHON" "$IMPL" "$@"
