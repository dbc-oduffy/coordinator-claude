#!/bin/sh
# ── sh/python polyglot trampoline ──────────────────────────────────────────────
# The next line is inert Python (a bare string literal) but executable sh/bash.
# It lets this CLI be invoked three ways that ALL Just Work, so the habitual
# `bash <script>` reach no longer exec-fails by feeding Python to bash:
#   coordinator-lesson-promote ...          # direct, via the shebang above — canonical form
#   python  coordinator-lesson-promote ...  # explicit interpreter
#   bash    coordinator-lesson-promote ...  # re-execs under python instead of erroring
# Under sh/bash the line resolves the interpreter as `python3 || python || py`
# (macOS 12.3+ and modern Linux ship only `python3` — Apple dropped the `python`
# symlink; clean Windows python.org installs ship only `python`/`py`), captures
# its path via command substitution, then execs it; under Python the whole line
# is a no-op string. One `exec`, three-way probe — the canonical pattern.
''''exec "$(command -v python3 || command -v python || command -v py)" "$0" "$@" #'''
from __future__ import annotations
"""
coordinator-lesson-promote — write a universal lesson to the local lessons-outbox
for drain by the central /learn-lessons --central procedure.

Shebang note: the SHEBANG line above is `python`, NOT `python3` — `python3` is
not on PATH on a clean Windows install (only `python`/`py` are), so a `python3`
shebang exec-127s there. This is the documented rule for coordinator CLIs:
docs/wiki/bash-on-windows-gotchas.md § Windows exception. The TRAMPOLINE line
above is a separate concern: it probes `python3 || python || py` so
`bash coordinator-lesson-promote …` works on macOS, Linux, AND Windows.
Do not flatten the trampoline back to a single name.

Spec backlink: docs/plans/2026-06-15-universal-lesson-routing-mechanical-capture.md § C1

Purpose: Write ONE YAML entry to state/lessons-outbox/<ISO-ts>-<slug>.yaml.
The file is left uncommitted (dirty) so it surfaces in `git status` and is
picked up by the /learn-lessons --central drain procedure.

Output path: state/lessons-outbox/<ISO-ts>-<slug>.yaml
  - ISO-ts: UTC timestamp, colons replaced with hyphens for filesystem safety
  - Slug: title sanitised to lowercase + hyphens, alphanumeric + hyphens only,
    truncated to 40 chars

from_repo resolution order (same convention as cross-repo-memo):
  1. cwd git-root → reverse-lookup against machine-local repos.* table
  2. ~/.claude meta-repo root → "claude-central-em"
  3. Unregistered git repo → basename of git root + "-em"
  4. Not in a git repo → "unknown-sender-em"
  Never uses `git remote get-url origin` — that yields a URL, not a shortname.

Negative-spec: this CLI writes ONLY to state/lessons-outbox/. It does NOT
append to state/improvement-queue.md, lessons.md, or any other surface.
Those routes are for project-scoped or wiki-only entries; this CLI is for
universal lessons destined for the central coordinator wiki.

Invocation:
  coordinator-lesson-promote \\
    --title "lesson title" \\
    --body "lesson body prose" \\
    --change-kind doctrine-edit \\
    --target-wiki docs/wiki/some-wiki.md \\
    [--scope-tags "tag1,tag2"] \\
    [--evidence "commit-sha or plan path"]
"""

import argparse
import datetime
import os
import re
import subprocess
import sys
import uuid

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# Canonical change_kind enum — C2 (lessons-outbox-schema.md) is the authoritative source.
# Keep in sync with docs/wiki/lessons-outbox-schema.md § change_kind enum.
CHANGE_KIND_VALUES: tuple[str, ...] = (
    "doctrine-edit",
    "agent-prompt-edit",
    "hook-edit",
    "script-edit",
    "snippet-sync-update",
    "wiki-new",
    "wiki-append",
    "skill-edit",
)

# Maximum slug length (chars) for the filename component.
_SLUG_MAX_CHARS = 40

# Env var for test isolation — overrides the outbox root directory.
# Tests chdir into a temp dir; the CLI resolves state/lessons-outbox/ relative to
# cwd by default. This env var allows absolute override without chdir.
_OUTBOX_ROOT_ENV = "LESSON_PROMOTE_OUTBOX_ROOT"

# Env var for machine-local implementation path (mirrors cross-repo-memo pattern).
_MACHINE_LOCAL_IMPL_ENV = "MACHINE_LOCAL_IMPL"

# Env var for CLAUDE_HOME override (mirrors cross-repo-memo pattern).
_CLAUDE_HOME_ENV = "CLAUDE_HOME"

# ---------------------------------------------------------------------------
# from_repo resolution — mirrors cross-repo-memo._sender_em_id pattern
# ---------------------------------------------------------------------------

# Registry aliases: stable doctrine EM names that diverge from the repo's
# machine-local shortname convention. Mirrors cross-repo-memo RECEIVER_EM_ALIASES.
_REPO_KEY_ALIASES: dict[str, str] = {
    # repos.claude_unreal_holodeck → holodeck-em
    "claude_unreal_holodeck": "holodeck",
}


def _claude_home() -> str:
    """Return the ~/.claude root, honouring CLAUDE_HOME env var for test isolation."""
    override = os.environ.get(_CLAUDE_HOME_ENV)
    if override:
        return override
    return os.path.join(os.path.expanduser("~"), ".claude")


def _machine_local_impl() -> str:
    """Return the path to _machine_local.py, honouring MACHINE_LOCAL_IMPL for tests."""
    override = os.environ.get(_MACHINE_LOCAL_IMPL_ENV)
    if override:
        return override
    return os.path.join(_claude_home(), "bin", "_machine_local.py")


def _resolve_python() -> str:
    """Return a usable Python interpreter for subprocess calls to _machine_local.py.

    sys.executable is always valid — the interpreter running this script.
    Avoids subprocess probing that raises FileNotFoundError on Windows.
    """
    return sys.executable


def _machine_local_get(key: str) -> str | None:
    """Call machine-local get <key> and return the value, or None on failure."""
    impl = _machine_local_impl()
    python = _resolve_python()
    cmd = [python, impl, "get", key]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def _machine_local_repos_keys() -> list[str]:
    """Return all repos.* keys from the machine-local registry."""
    impl = _machine_local_impl()
    python = _resolve_python()
    try:
        result = subprocess.run([python, impl, "keys"], capture_output=True, text=True)
    except OSError:
        return []
    if result.returncode != 0:
        return []
    return [
        line.strip()
        for line in result.stdout.splitlines()
        if line.strip().startswith("repos.")
    ]


def _repo_key_to_em_id(key: str) -> str:
    """Convert a repos.<shortname> key to its EM identity (shortname-em), applying aliases."""
    # key looks like "repos.project_rag" → shortname "project_rag"
    shortname = key[len("repos."):] if key.startswith("repos.") else key
    # Apply aliases: if the registry shortname is in the alias table, use the canonical doctrine name.
    # Dict shape is {registry_shortname: canonical_em_stem}; e.g. "claude_unreal_holodeck" → "holodeck".
    canonical = _REPO_KEY_ALIASES.get(shortname)
    if canonical is not None:
        return canonical + "-em"
    return shortname.replace("_", "-") + "-em"


def _same_path(a: str, b: str) -> bool:
    """True if two paths resolve to the same directory (cross-platform)."""
    try:
        return os.path.samefile(a, b)
    except OSError:
        return os.path.normcase(os.path.realpath(a)) == os.path.normcase(os.path.realpath(b))


def _current_repo_root() -> str | None:
    """Return the git repo root of the cwd, or None if not inside a git repo."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
        )
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def _em_id_for_root(root: str | None, home: str, repo_key_paths: dict[str, str]) -> str:
    """Resolve a sender-EM identity from a git root path.

    Resolution order (mirrors cross-repo-memo._em_id_for_root):
      1. ~/.claude meta-repo → claude-central-em
      2. Registered repos.* sibling → <name>-em (with alias table)
      3. Unregistered git repo → basename-em
      4. No root → unknown-sender-em
    """
    if root is None:
        return "unknown-sender-em"
    if _same_path(root, home):
        return "claude-central-em"
    for key, path in repo_key_paths.items():
        if path and _same_path(path, root):
            return _repo_key_to_em_id(key)
    return os.path.basename(root.rstrip("/\\")) + "-em"


def _resolve_from_repo() -> str:
    """Identify the from_repo for the outbox entry from cwd context."""
    root = _current_repo_root()
    home = _claude_home()
    keys = _machine_local_repos_keys()
    paths = {k: _machine_local_get(k) for k in keys}
    return _em_id_for_root(root, home, {k: v for k, v in paths.items() if v})


# ---------------------------------------------------------------------------
# Output path helpers
# ---------------------------------------------------------------------------

def _outbox_root() -> str:
    """Return the lessons-outbox directory path.

    Respects LESSON_PROMOTE_OUTBOX_ROOT env var for test isolation.
    Default: state/lessons-outbox/ relative to cwd.
    """
    override = os.environ.get(_OUTBOX_ROOT_ENV)
    if override:
        return override
    return os.path.join(os.getcwd(), "state", "lessons-outbox")


def _slug_from_title(title: str) -> str:
    """Sanitize a title into a filesystem-safe slug.

    Lowercase, alphanumeric + hyphens only, no leading/trailing hyphens.
    Truncated to _SLUG_MAX_CHARS chars.
    """
    slug = title.lower()
    slug = re.sub(r"[^a-z0-9]+", "-", slug)
    slug = slug.strip("-")
    return slug[:_SLUG_MAX_CHARS]


def _now_iso() -> str:
    """Return current UTC datetime as ISO 8601 string (seconds precision)."""
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def _ts_for_filename(iso_ts: str) -> str:
    """Convert an ISO timestamp to a filesystem-safe filename component.

    Replaces ':' and '+' with '-' for cross-platform filename safety.
    e.g. '2026-06-15T10:30:00+00:00' → '2026-06-15T10-30-00-00-00'
    """
    return re.sub(r"[:+]", "-", iso_ts)


# ---------------------------------------------------------------------------
# YAML serialization (minimal, no external deps)
# ---------------------------------------------------------------------------

def _yaml_str(value: str) -> str:
    """Serialize a string value for YAML.

    Uses block scalar (|) for multi-line values; quoted scalar for single-line
    values that contain YAML-special characters.
    """
    if "\n" in value:
        # Block scalar — indent each line by 2 spaces.
        indented = "\n".join("  " + line if line.strip() else "" for line in value.splitlines())
        return "|\n" + indented + "\n"
    # Single-line: quote if it contains YAML-special characters or leading/trailing whitespace.
    needs_quoting = any(c in value for c in ('"', "'", ":", "#", "{", "}", "[", "]", ",", "&", "*", "?", "|", ">", "!", "%", "@", "`"))
    needs_quoting = needs_quoting or value != value.strip() or value.lower() in ("true", "false", "null", "yes", "no")
    if needs_quoting:
        escaped = value.replace("\\", "\\\\").replace('"', '\\"')
        return f'"{escaped}"'
    return value


def _compose_yaml(fields: dict[str, str | list[str] | None]) -> str:
    """Compose a YAML document from an ordered dict of fields.

    Handles str and list[str] values. None values are serialized as empty string.
    """
    lines = ["---"]
    for key, value in fields.items():
        if value is None:
            lines.append(f"{key}: ")
        elif isinstance(value, list):
            if not value:
                lines.append(f"{key}: []")
            else:
                lines.append(f"{key}:")
                for item in value:
                    lines.append(f"  - {_yaml_str(item)}")
        elif "\n" in str(value):
            # Block scalar — write key: |
            lines.append(f"{key}: {_yaml_str(str(value))}")
        else:
            lines.append(f"{key}: {_yaml_str(str(value))}")
    lines.append("---")
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# Core write logic
# ---------------------------------------------------------------------------

def _write_entry(
    *,
    title: str,
    body: str,
    change_kind: str,
    target_wiki: str,
    scope_tags: list[str],
    evidence: str | None,
    entry_id: str,
    created: str,
    from_repo: str,
) -> str:
    """Write a lessons-outbox YAML entry. Returns the path written."""
    outbox = _outbox_root()
    os.makedirs(outbox, exist_ok=True)

    ts_safe = _ts_for_filename(created)
    slug = _slug_from_title(title)
    filename = f"{ts_safe}-{slug}.yaml"
    path = os.path.join(outbox, filename)

    fields: dict = {
        "id": entry_id,
        "created": created,
        "from_repo": from_repo,
        "change_kind": change_kind,
        "target_wiki": target_wiki,
        "title": title,
        "body": body,
    }
    if scope_tags:
        fields["scope_tags"] = scope_tags
    if evidence:
        fields["evidence"] = evidence

    content = _compose_yaml(fields)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)

    return path


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="coordinator-lesson-promote",
        description=(
            "Write a universal lesson entry to state/lessons-outbox/ for drain "
            "by the /learn-lessons --central procedure.\n\n"
            "Spec: docs/plans/2026-06-15-universal-lesson-routing-mechanical-capture.md § C1\n"
            "Schema: docs/wiki/lessons-outbox-schema.md"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--title",
        required=True,
        help="One-line lesson title (bold heading in lessons.md format).",
    )
    parser.add_argument(
        "--body",
        required=True,
        help="Lesson body prose — 1-2 sentences describing the pattern and fix.",
    )
    parser.add_argument(
        "--change-kind",
        required=True,
        choices=CHANGE_KIND_VALUES,
        metavar="CHANGE_KIND",
        help=(
            f"Kind of change this lesson routes to. One of: {', '.join(CHANGE_KIND_VALUES)}. "
            "See docs/wiki/lessons-outbox-schema.md for semantics."
        ),
    )
    parser.add_argument(
        "--target-wiki",
        required=True,
        help=(
            "Central wiki path this lesson targets, e.g. docs/wiki/some-wiki.md. "
            "Use 'unknown' when the target wiki is not yet identified."
        ),
    )
    parser.add_argument(
        "--scope-tags",
        default="",
        help="Optional comma-separated scope tags, e.g. 'executor,plan-authoring'.",
    )
    parser.add_argument(
        "--evidence",
        default=None,
        help="Optional evidence: commit SHA, plan path, or lesson source reference.",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    """Entry point. Returns exit code."""
    parser = _build_parser()
    args = parser.parse_args(argv)

    # Validate change_kind (argparse choices= handles this, but explicit check
    # for the diagnostic message requirement).
    if args.change_kind not in CHANGE_KIND_VALUES:
        print(
            f"error: --change-kind value {args.change_kind!r} is not valid.\n"
            f"Valid values: {', '.join(CHANGE_KIND_VALUES)}",
            file=sys.stderr,
        )
        return 1

    scope_tags = [t.strip() for t in args.scope_tags.split(",") if args.scope_tags.strip() and t.strip()]

    entry_id = str(uuid.uuid4())
    created = _now_iso()
    from_repo = _resolve_from_repo()

    try:
        path = _write_entry(
            title=args.title,
            body=args.body,
            change_kind=args.change_kind,
            target_wiki=args.target_wiki,
            scope_tags=scope_tags,
            evidence=args.evidence if args.evidence else None,
            entry_id=entry_id,
            created=created,
            from_repo=from_repo,
        )
    except OSError as exc:
        print(f"error: could not write outbox entry: {exc}", file=sys.stderr)
        return 1

    print(f"Lesson outbox entry written: {path}")
    print(f"  id:          {entry_id}")
    print(f"  from_repo:   {from_repo}")
    print(f"  change_kind: {args.change_kind}")
    print(f"  target_wiki: {args.target_wiki}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
