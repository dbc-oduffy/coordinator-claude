#!/usr/bin/env bash
# coordinator-reap-sessions — Thin wrapper: archive stale agent dirs then stale session dirs.
#
# Spec backlink: ~/.claude/plans/safe-commit-fixes.md § Phase 4
#
# Purpose: operational hygiene — bound growth of .git/coordinator-sessions/.
#   Calls cs_reap_agents FIRST (back-pointer integrity: agent dirs may reference session dirs;
#   archiving session dirs first via cs_reap_stale would cause cs_reap_agents to silently
#   miss orphan agent dirs whose parent session was just reaped).
#   Then calls cs_reap_stale to archive sessions meeting the 24h-inactive + dead-PID criterion.
#
# Stdout: "reaped <session_id>" and "reaped agent <agent_id>" lines from the lib functions.
#   Wire-in callers should capture this output to a log rather than letting it surface as prose.
#
# Exit codes:
#   0 — success (zero or more sessions/agents reaped)
#   1 — hard error (lib not found)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="${SCRIPT_DIR}/../lib/coordinator-session.sh"

if [[ ! -f "$LIB" ]]; then
  echo "ERROR: coordinator-session.sh not found at ${LIB}" >&2
  exit 1
fi
# shellcheck source=../lib/coordinator-session.sh
source "$LIB"

cs_reap_agents  # FIRST — back-pointer integrity
cs_reap_stale   # SECOND
