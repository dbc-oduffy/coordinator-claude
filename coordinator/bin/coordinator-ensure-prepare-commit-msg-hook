#!/usr/bin/env bash
# coordinator-ensure-prepare-commit-msg-hook — idempotent install/repair of the
# Session-Id trailer prepare-commit-msg hook in the current git repo.
#
# Why: the Session-Id trailer convention ("append Session-Id: <id> to every
# coordinator-session commit") is install-time only via repo-setup § 3f.6.
# Repos that pre-date the convention, repos whose `.git/hooks/` got wiped, and
# OSS users who clone without running `/repo-setup` all inherit a silent
# failure: commits succeed, no trailer is appended, brightline gate's
# --session-id filter matches zero commits.
#
# This helper makes the install self-healing: it runs from session-init.sh on
# every session boot inside any coordinator-aware repo. Idempotent and near-
# zero cost — a stat plus a (comment-stripped) grep when already installed.
#
# Behavior (decoupled exec-bit + marker check — mirrors coordinator-ensure-post-commit-hook):
#   - hook absent          → install canonical shim + chmod +x.
#   - hook present + marker (routed)
#     ├─ executable        → no-op (fast path).
#     └─ not executable    → chmod +x repair only — do NOT re-append.
#   - hook present + marker absent
#                          → append backgrounded helper invocation (preserves
#                            existing hook chain), then chmod +x.
#   - helper missing       → skip silently (broken coordinator install — a
#                            different problem, not this script's to diagnose).
#
# Marker match: comment lines stripped before grep, so a stray
# "# TODO: replace with coordinator-prepare-commit-msg" cannot false-positive
# as routed.
#
# Always exits 0 — must never block a session start.
#
# Spec backlink: docs/plans/2026-06-15-brightline-session-scope-fix.md § C1

set +e

# DR-148: bash >= 4 required. On macOS stock 3.2: brew install bash + ensure
# /usr/local/bin or /opt/homebrew/bin precedes /bin in PATH.
# Review: code-reviewer — installer also needs the guard per DR-148; precautionary
# (no bash-4-only features used here), but keeps installer surface consistent.
# Never block on bash version — silently skip install on bash < 4.
if [ "${BASH_VERSINFO:-0}" -lt 4 ]; then
  exit 0
fi

GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -z "$GIT_ROOT" ] && exit 0

HOOK="$GIT_ROOT/.git/hooks/prepare-commit-msg"
HELPER="$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-prepare-commit-msg"
MARKER="coordinator-prepare-commit-msg"

[ -f "$HELPER" ] || exit 0

# Hook absent → install canonical shim. The shim passes "$@" so git's
# COMMIT_MSG_FILE (and optional COMMIT_SOURCE, SHA1 args) are forwarded.
if [ ! -e "$HOOK" ]; then
  cat > "$HOOK" <<'SHIM'
#!/usr/bin/env bash
# Session-Id trailer injection on every coordinator-session commit.
# Installed by coordinator-ensure-prepare-commit-msg-hook. Always exits 0.
exec "$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-prepare-commit-msg" "$@"
SHIM
  chmod +x "$HOOK" 2>/dev/null
  exit 0
fi

# Hook exists. Decouple the marker check from the exec-bit check: a hook
# that is routed but not executable should be chmod-repaired, not re-appended.
# Strip comment lines before grep so the marker can't false-positive on a
# documentation comment that mentions the helper but does not invoke it.
if grep -v '^[[:space:]]*#' "$HOOK" 2>/dev/null | grep -q "$MARKER"; then
  # Routed. Repair exec bit if needed; otherwise no-op.
  [ -x "$HOOK" ] || chmod +x "$HOOK" 2>/dev/null
  exit 0
fi

# Hook exists, marker absent. Append a synchronous invocation so we never
# clobber an existing hook chain. The prepare-commit-msg hook receives the
# commit message file as $1; pass "$@" to forward all args.
# Review: code-reviewer — backgrounded (&) form raced git's synchronous read of
# the message file; trailer silently dropped. || true preserves never-block-commit contract.
{
  printf '\n%s\n' '# === coordinator Session-Id trailer injection ==='
  printf '%s\n' '"$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-prepare-commit-msg" "$@" || true'
} >> "$HOOK" 2>/dev/null

[ -x "$HOOK" ] || chmod +x "$HOOK" 2>/dev/null

exit 0
