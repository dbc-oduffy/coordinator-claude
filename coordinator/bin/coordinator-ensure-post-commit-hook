#!/bin/bash
# coordinator-ensure-post-commit-hook — idempotent install/repair of the
# crash-insurance post-commit auto-push hook in the current git repo.
#
# Why: the auto-push doctrine ("Auto-push hook on every commit on work/* and
# feature/* branches — crash insurance") was install-time only via repo-setup
# § 3f.5. Repos that pre-date the doctrine, repos whose `.git/hooks/` got
# wiped, and OSS users who clone without running `/repo-setup` all inherit a
# silent failure: commits succeed, no hook fires, work strands on local.
#
# This helper makes the install self-healing: it runs from session-init.sh on
# every session boot inside any coordinator-aware repo. Idempotent and near-
# zero cost — a stat plus a grep when already installed.
#
# Behavior:
#   - hook absent          → install the canonical shim (delegating to
#                            coordinator-auto-push) and chmod +x.
#   - hook present, routed → no-op (verified by grep of $MARKER).
#   - hook present, not    → append a backgrounded helper invocation to
#     routed                 preserve the existing prefix (e.g. Git-LFS chain).
#   - hook present, not    → chmod +x to repair (still routed-or-not check
#     executable             applies before append).
#   - helper missing       → skip silently (broken coordinator install — a
#                            different problem, not this script's to diagnose).
#
# Always exits 0 — must never block a session start.
#
# Spec backlink: state/handoffs/2026-06-11_145955_auto-push-silent-failure-email-privacy.md

set +e

GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -z "$GIT_ROOT" ] && exit 0

HOOK="$GIT_ROOT/.git/hooks/post-commit"
HELPER="$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-auto-push"
MARKER="coordinator-auto-push"

[ -f "$HELPER" ] || exit 0

# Fast path: hook present, executable, routed → no-op.
if [ -x "$HOOK" ] && grep -q "$MARKER" "$HOOK" 2>/dev/null; then
  exit 0
fi

if [ ! -e "$HOOK" ]; then
  cat > "$HOOK" <<'SHIM'
#!/bin/bash
# Auto-push to remote on work/* or feature/* branches — crash insurance.
# Installed by coordinator-ensure-post-commit-hook.
exec "$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-auto-push"
SHIM
  chmod +x "$HOOK" 2>/dev/null
  exit 0
fi

# Hook exists but is not routed to the helper. Append a backgrounded invocation
# so we never clobber an existing chain (Git-LFS, prepare-commit-msg pipelines,
# user customizations). The `&` and trailing `exit 0` in the snippet keep the
# parent hook's success status intact even if the auto-push subshell exits non-
# zero — though coordinator-auto-push itself is contractually exit 0.
{
  printf '\n%s\n' '# === coordinator auto-push (crash insurance) ==='
  printf '%s\n' '( "$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-auto-push" ) &'
} >> "$HOOK" 2>/dev/null

[ -x "$HOOK" ] || chmod +x "$HOOK" 2>/dev/null

exit 0
