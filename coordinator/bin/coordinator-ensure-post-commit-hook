#!/usr/bin/env bash
# coordinator-ensure-post-commit-hook — idempotent install/repair of the
# crash-insurance post-commit auto-push hook in the current git repo.
#
# Why: the auto-push doctrine ("Auto-push hook on every commit on work/*
# branches — crash insurance") was install-time only via repo-setup § 3f.5.
# Repos that pre-date the doctrine, repos whose `.git/hooks/` got wiped, and
# OSS users who clone without running `/repo-setup` all inherit a silent
# failure: commits succeed, no hook fires, work strands on local.
#
# This helper makes the install self-healing: it runs from session-init.sh on
# every session boot inside any coordinator-aware repo. Idempotent and near-
# zero cost — a stat plus a (comment-stripped) grep when already installed.
#
# Behavior (decoupled exec-bit + marker check — see review F4):
#   - hook absent          → install canonical shim + chmod +x.
#   - hook present + marker (routed)
#     ├─ executable        → no-op (fast path).
#     └─ not executable    → chmod +x repair only — do NOT re-append.
#   - hook present + marker absent
#                          → append backgrounded helper invocation (preserves
#                            existing Git-LFS / custom prefix), then chmod +x.
#   - helper missing       → skip silently (broken coordinator install — a
#                            different problem, not this script's to diagnose).
#
# Marker match (F3): comment lines stripped before grep, so a stray
# "# TODO: replace with coordinator-auto-push" cannot false-positive as routed.
#
# Always exits 0 — must never block a session start.
#
# Spec backlink: state/handoffs/2026-06-11_145955_auto-push-silent-failure-email-privacy.md
# (now archived under archive/handoffs/).

set +e

GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -z "$GIT_ROOT" ] && exit 0

HOOK="$GIT_ROOT/.git/hooks/post-commit"
HELPER="$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-auto-push"
MARKER="coordinator-auto-push"

[ -f "$HELPER" ] || exit 0

# Hook absent → install canonical shim. coordinator-auto-push is contractually
# exit-0, so `exec` here is safe (no risk of poisoning the commit's success
# status). The append path below uses a backgrounded subshell instead, to
# preserve a possibly-set-e custom prefix.
if [ ! -e "$HOOK" ]; then
  cat > "$HOOK" <<'SHIM'
#!/usr/bin/env bash
# Auto-push to remote on work/* branches — crash insurance.
# Installed by coordinator-ensure-post-commit-hook. coordinator-auto-push is
# contractually exit-0, so `exec` here cannot mask a hook failure.
exec "$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-auto-push"
SHIM
  chmod +x "$HOOK" 2>/dev/null
  exit 0
fi

# Hook exists. Decouple the marker check from the exec-bit check (F4): a hook
# that is routed but not executable should be chmod-repaired, not re-appended.
# Strip comment lines before grep so the marker can't false-positive on a
# documentation comment that mentions the helper but does not invoke it (F3).
if grep -v '^[[:space:]]*#' "$HOOK" 2>/dev/null | grep -q "$MARKER"; then
  # Routed. Repair exec bit if needed; otherwise no-op.
  [ -x "$HOOK" ] || chmod +x "$HOOK" 2>/dev/null
  exit 0
fi

# Hook exists, marker absent. Append a backgrounded invocation so we never
# clobber an existing chain (Git-LFS, prepare-commit-msg pipelines, user
# customizations). The `&` keeps the parent hook's success status intact even
# if the auto-push subshell exits non-zero — though coordinator-auto-push
# itself is contractually exit 0.
{
  printf '\n%s\n' '# === coordinator auto-push (crash insurance) ==='
  printf '%s\n' '( "$HOME/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-auto-push" ) &'
} >> "$HOOK" 2>/dev/null

[ -x "$HOOK" ] || chmod +x "$HOOK" 2>/dev/null

exit 0
