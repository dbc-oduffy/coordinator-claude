#!/usr/bin/env bash
# Pre-commit hook for the ~/.claude meta-repo: assert exec-bit on .sh files
# under plugins/*/{hooks,bin}/ before drift can land.
#
# Surfaced by a project-rag /merge-to-main hook-suite failure on 2026-06-08:
# the meta-repo gate at /workday-complete Step 5 was correctly placed but
# only fired end-of-day; in the 80-min window between drift-introduction
# and the consumer merge, no /workday-complete had run. This hook moves
# drift detection from end-of-day to commit-time.
#
# Scope: only fires inside the meta-repo (recognized by ~/.claude/.git).
# Outside that repo it exits 0 immediately — consumer repos do not host
# the plugin source tree, so the test would be a no-op anyway.
#
# Cost: ~0.5s per commit (measured 2026-06-09). Below the annoyance floor.
#
# Spec backlink: cross-repo/inbox/2026-06-08-exec-bit-drift-runtime-tripwire-tests.md

set -euo pipefail

# Review F2 (2026-06-15): bash 4+ required for `mapfile -t` in the auto-fix
# block below. Fail loud on bash 3.2 (stock macOS) with brew remediation —
# DR-148 mandates this guard on every bash-4-using script. Plain arithmetic
# syntax so bash 3.2 can parse the check before executing it.
if (( BASH_VERSINFO[0] < 4 )); then
  echo "coordinator-precommit-exec-bit-check: requires bash >= 4 (brew install bash on macOS)" >&2
  exit 1
fi

# Review F2: fail fast on empty REPO_ROOT — `|| true` followed by `canon ""`
# silently resolved to cwd, breaking the meta-repo identity guard on detached
# HEAD or outside-git contexts.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$REPO_ROOT" ] || exit 0

META_REPO="$HOME/.claude"

# Canonicalize both sides — symlink resolution on macOS, /c/ vs C:\ on Git-Bash.
# BSD-portable: prefer `cd && pwd -P`, fall back to literal compare.
# Empty-input guard prevents `cd ""` from succeeding silently as a no-op.
canon() {
  [ -n "$1" ] || { echo ""; return; }
  (cd "$1" 2>/dev/null && pwd -P) || echo "$1"
}
if [ "$(canon "$REPO_ROOT")" != "$(canon "$META_REPO")" ]; then
  exit 0
fi

# Review F1: override must short-circuit BEFORE the test runs, not after the
# failure print — otherwise stderr shows "Fix and re-commit" immediately
# followed by "override accepted; commit proceeding", which is contradictory.
if [ "${COORDINATOR_OVERRIDE_PRECOMMIT_EXEC_BIT:-}" = "1" ]; then
  echo "pre-commit: exec-bit check skipped (COORDINATOR_OVERRIDE_PRECOMMIT_EXEC_BIT=1)." >&2
  exit 0
fi

# Review F4: silent-skip if node is missing — otherwise `set -e` + 127 from
# `node --test` blocks the commit with an opaque "command not found".
# /workday-complete Step 5 remains the backstop for nodeless machines.
if ! command -v node >/dev/null 2>&1; then
  exit 0
fi

EXEC_BIT_TEST="$META_REPO/plugins/coordinator-claude/coordinator/tests/plugin-ecosystem/exec-bit.test.js"
if [ ! -f "$EXEC_BIT_TEST" ]; then
  # Test not present (partial checkout, mid-rebase, fresh clone before npm) —
  # do not block the commit. The /workday-complete Step 5 gate remains the
  # backstop.
  exit 0
fi

# Auto-fix shape (2026-06-15): on drift, run `git update-index --chmod=+x`
# against the offending files and log loudly, instead of failing the commit.
# Rationale: with `core.filemode=false` (mandatory on Windows Git-Bash, where
# `chmod +x` is a no-op on NTFS), new shebanged files routinely land at 100644.
# Daily friction of "detect → print fix → re-commit" inverted into a single
# audible auto-fix line. Override still available for the rare case where
# auto-fix is unwanted (e.g. intentional source-only file the allowlist hasn't
# caught yet — fix the allowlist, then commit with override).
TEST_OUT="$(node --test "$EXEC_BIT_TEST" 2>&1)" || TEST_FAILED=1
if [ "${TEST_FAILED:-0}" = "1" ]; then
  # The test's assertion message embeds: git -C "<repo>" update-index --chmod=+x "<path>"
  # Extract the path arguments and re-run via the parent shell's git binary
  # (the captured `git -C "<repo>"` form is for human display; we run inline
  # since we already know we are in the meta-repo).
  #
  # Format dependency (review F3, F5): the regex below is bound to the literal
  # assertion-message format at plugins/coordinator-claude/coordinator/tests/
  # plugin-ecosystem/exec-bit.test.js around line 289-291. If that format
  # changes, both this regex AND check-all-shebanged-exec-bits.sh's identical
  # extraction must update together. Paths with embedded double-quotes would
  # break the `"[^"]+"` capture; coordinator paths don't contain quotes, but
  # the brittleness is intentional — match the test's display, not arbitrary
  # path shapes.
  mapfile -t FIX_PATHS < <(printf '%s\n' "$TEST_OUT" | grep -oE 'update-index --chmod=\+x "[^"]+"' | sed -E 's/.*"([^"]+)"/\1/' | sort -u)
  if [ ${#FIX_PATHS[@]} -eq 0 ]; then
    # Test failed but no fix paths surfaced (test infra failure, not drift).
    echo "$TEST_OUT" >&2
    echo "" >&2
    echo "pre-commit: exec-bit test failed but no drift files identified (test infra issue?)." >&2
    echo "Override (PM-authorized only): COORDINATOR_OVERRIDE_PRECOMMIT_EXEC_BIT=1 git commit ..." >&2
    exit 1
  fi
  echo "pre-commit: exec-bit drift auto-fixed on ${#FIX_PATHS[@]} file(s):" >&2
  for p in "${FIX_PATHS[@]}"; do
    git -C "$META_REPO" update-index --chmod=+x "$p" 2>&1 | sed 's/^/  /' >&2 || {
      echo "  FAILED: $p" >&2
      echo "pre-commit: auto-fix failed — see above. Original test output:" >&2
      echo "$TEST_OUT" >&2
      exit 1
    }
    # Review F4: `git update-index --chmod=+x` exits 0 even when the path is
    # untracked or deleted (silent no-op). Verify the mode actually flipped
    # by reading it back from ls-files; fail loud on mismatch.
    actual_mode=$(git -C "$META_REPO" ls-files --stage -- "$p" | awk '{print $1}' | head -1)
    if [ "$actual_mode" != "100755" ]; then
      echo "  FAILED (post-fix mode=$actual_mode, expected 100755): $p" >&2
      echo "pre-commit: auto-fix silently no-op'd — path may have been deleted, renamed, or untracked between test-run and fix." >&2
      exit 1
    fi
    echo "  +x $p" >&2
  done
  echo "pre-commit: commit proceeding with auto-fixed index." >&2
fi
