#!/usr/bin/env bash
# coordinator-auto-push — canonical post-commit auto-push helper
#
# Pushes the current branch to origin if it is a work/* or feature/* branch.
# On Windows + Git Bash, falls back to PowerShell when the remote requires SSH,
# because Git Bash's bundled OpenSSH cannot reach 1Password's SSH agent
# (Windows pipe \\.\pipe\openssh-ssh-agent).
#
# Invocation: called from .git/hooks/post-commit (sync) or wrapped in `( ... ) &`
# for async push (large repos).
#
# Always exits 0 — auto-push must never block a commit.
#
# Logs failures to .git/push-failures.log.

set -uo pipefail
# Deliberate: do not exit on non-zero — push failure must not block commits

RAW_BRANCH=$(git branch --show-current 2>/dev/null) || exit 0

# Canonicalize branch case via the on-disk ref name. On Windows's case-insensitive
# filesystem, `.git/HEAD` can carry a different case (e.g. `work/STRIKER/...`) than
# the actual ref file (`refs/heads/work/striker/...`). `git push` does ref lookups
# case-sensitively against the canonical name, so a mismatched HEAD makes
# `git push origin "$RAW_BRANCH"` fail with "cannot be resolved to branch."
# `for-each-ref` returns the canonical case (the form the remote also expects).
# If lookup fails for any reason, fall back to RAW_BRANCH so we don't regress on
# Linux/macOS where this hazard doesn't exist.
BRANCH=$(git for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null \
  | awk -v b="$RAW_BRANCH" 'tolower($0)==tolower(b){print; exit}')
[[ -z "$BRANCH" ]] && BRANCH="$RAW_BRANCH"

# Only push on work/* branches — feature/* removed because block-off-daily-branch.sh
# now denies feature/* creation; leaving it in auto-push would propagate any branches
# that slip through via COORDINATOR_OVERRIDE_BRANCH. Doctrine: work/* only.
# Review: patrik F12 (auto-push tightening) + c474ee1 follow-up.
#
# Case-sensitivity (Patrik R1 F7 + 2026-05-07 HTTPS-autopush spinoff): the
# `case work/*` prefix check accepted both `work/STRIKER/...` and `work/striker/...`
# transparently, but the *push spec* did not — `git push origin work/STRIKER/...`
# fails when the canonical ref is lowercase. The for-each-ref normalization above
# now handles this on the push side too. Do NOT remove the lowercase normalization.
# Both push paths below (direct + PowerShell-routed SSH) interpolate the
# canonicalized $BRANCH, so the fix applies uniformly to HTTPS and SSH on Windows.
case "$BRANCH" in
  work/*) ;;
  migration/*|release/*|feature/*)
    echo "coordinator-auto-push: skipping $BRANCH (recognized long-lived workstream shape; doctrine: work/* only). Push manually if intended." >&2
    exit 0 ;;
  *) exit 0 ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
REMOTE_URL=$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null) || exit 0

log_failure() {
  local route="$1" err_class="$2" attempts="$3" first_err="$4" stderr_src="$5"
  # Preserve full stderr alongside the one-line summary so we can diagnose
  # server-side rejections (GH013 push-protection, GH001 size limit, GH008 LFS
  # quota, generic 5xx) whose real message is hidden behind GitHub's
  # `remote: error: Trace: <hex>` preamble.
  local stamp forensic
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  forensic="$REPO_ROOT/.git/push-stderr-$stamp.log"
  if [[ -s "$stderr_src" ]]; then
    cp -f "$stderr_src" "$forensic" 2>/dev/null || forensic="<copy-failed>"
  else
    forensic="<empty>"
  fi
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] PUSH FAILED on $BRANCH ($route/$err_class after $attempts) :: ${first_err:-<empty>} :: stderr=$forensic" \
    >> "$REPO_ROOT/.git/push-failures.log"
}

# Classify git push stderr to decide whether retry is safe.
# Patterns sourced from git's refs.c (lock errors), receive-pack/transport (non-FF),
# openssh/curl network paths, and GitHub server-side rejection codes (GH001/008/013).
# Order matters — most specific first; GitHub-specific server rejections must come
# before generic auth/network so a push-protection block doesn't classify as auth.
classify_error() {
  local f="$1"
  [[ ! -s "$f" ]] && { echo "empty-stderr"; return; }
  if grep -qE "(GH013|push declined due to repository rule violations|push cannot contain secrets|Secret detected|Push Protection)" "$f"; then
    echo "gh-push-protection"
  elif grep -qE "(GH001|exceeds GitHub's file size limit|large files detected|file size limit)" "$f"; then
    echo "gh-size-limit"
  elif grep -qE "(GH008|exceed your.*(data )?quota|LFS.*quota|batch response: .*quota)" "$f"; then
    echo "gh-lfs-quota"
  elif grep -qE "(cannot lock ref|failed to lock|Reference has changed|reference already exists)" "$f"; then
    echo "ref-lock"
  elif grep -qE "(non-fast-forward|rejected.*fetch first|tip of your current branch is behind|stale info)" "$f"; then
    echo "non-fast-forward"
  elif grep -qE "(fatal error in commit_refs|HTTP 5[0-9][0-9]|send-pack: unexpected disconnect|unexpected disconnect while reading sideband)" "$f"; then
    # GitHub server-side transient failures. Distinct from `network` (client-side
    # connectivity) because the request reached GitHub and GitHub itself faltered:
    # `fatal error in commit_refs`, HTTP 5xx via smart-http (matches both bare and
    # `RPC failed; HTTP 5xx` forms), mid-stream sideband disconnects. Empirically
    # self-resolving — the 2026-05-27 cluster (7 of these, logged as `unknown`) all
    # eventually pushed once GitHub recovered. Retryable like `network`, but with a
    # seconds-scale backoff (ref-lock's sub-second jitter is far too short for a
    # server recovering from a 502). NOTE: matched AFTER non-fast-forward so a
    # rejection that also closes the connection can't be misread as transient.
    # `remote end hung up unexpectedly` is intentionally in `network` below, not
    # here — it is ambiguous (server EOF vs client partition), and the real 502
    # case is already caught by the sideband patterns above.
    echo "gh-transient"
  elif grep -qE "(Could not resolve host|Connection (refused|timed out|reset)|TLS handshake|SSL_connect|Temporary failure|Network is unreachable|kex_exchange_identification|Broken pipe|early EOF|remote end hung up unexpectedly)" "$f"; then
    echo "network"
  elif grep -qE "(Permission denied|Authentication failed|Host key verification|publickey|could not read from remote|access denied)" "$f"; then
    echo "auth"
  elif grep -qE "^remote: (error|rejected|fatal):" "$f"; then
    # Catch-all for server-side rejections we haven't pattern-matched yet
    # (HTTP 5xx via smart-http, branch-protection rules, org SSO, etc.).
    # Distinct from "unknown" so the forensic stderr file is the obvious next read.
    echo "gh-server-reject"
  else
    echo "unknown"
  fi
}

# Run a single push attempt; capture stderr to the given file. Returns push exit code.
push_once() {
  local stderr_file="$1"
  if [[ "$is_windows_bash" == true && "$is_ssh_remote" == true ]]; then
    REPO_ROOT="$REPO_ROOT" BRANCH="$BRANCH" \
      powershell.exe -NonInteractive -NoProfile -WindowStyle Hidden -Command \
      'git -C $env:REPO_ROOT push origin $env:BRANCH --set-upstream' \
      >/dev/null 2>"$stderr_file"
  else
    git push origin "$BRANCH" --set-upstream >/dev/null 2>"$stderr_file"
  fi
}

# --- Path selection -------------------------------------------------------
# Git Bash on Windows sets MSYSTEM (MINGW64 / MINGW32 / MSYS).
# SSH remotes on git@host or ssh:// URLs need 1Password's agent, which
# Git Bash's bundled ssh cannot reach. PowerShell uses Windows OpenSSH which
# can. HTTPS remotes work fine in either shell (Windows Credential Manager).

is_windows_bash=false
if [[ -n "${MSYSTEM:-}" ]] || [[ "${OS:-}" == "Windows_NT" ]]; then
  is_windows_bash=true
fi

is_ssh_remote=false
case "$REMOTE_URL" in
  git@*|ssh://*) is_ssh_remote=true ;;
esac

# Route label is informational only; transport choice lives in push_once.
# PowerShell route comments: REPO_ROOT/BRANCH are passed via env so embedded
# apostrophes in the repo path can't break out of the -Command string.
# -NonInteractive prevents UI prompts. -WindowStyle Hidden suppresses console flash.
if [[ "$is_windows_bash" == true && "$is_ssh_remote" == true ]]; then
  route_label="powershell ssh push"
else
  route_label="direct push"
fi

# Retry policy (2026-05-17, extended 2026-05-27): three retryable classes, each with
# a backoff matched to its recovery timescale:
#   - ref-lock      — local push-ref contention; resolves in milliseconds → sub-second jitter
#   - network       — client-side connectivity blip; sub-second jitter (a retry that
#                     fast either reconnects or fails again cheaply)
#   - gh-transient  — GitHub server-side 5xx / commit_refs / sideband disconnect;
#                     the server needs SECONDS to recover, so back off 2s, 4s.
# Non-FF, auth, and unknown classes fail loud without retry — non-FF in particular
# means a concurrent push already landed work we don't have, so silent retry would
# mask the divergence (and auto-rebasing a dirty shared tree in a post-commit hook is
# both unsafe and usually blocked). gh-push-protection / gh-size-limit / gh-lfs-quota
# are deliberately NOT retryable: secrets, oversized files, and quota don't self-heal.
# See the push-failures.log format below for the recorded forensic fields.
#
# Test seam: COORDINATOR_AUTO_PUSH_NO_SLEEP=1 skips the backoff sleeps so the test
# suite doesn't pay the seconds-scale gh-transient wait. Unset in all real use.
STDERR_TMP="$REPO_ROOT/.git/.push-stderr.$$"
trap 'rm -f "$STDERR_TMP"' EXIT

max_attempts=3
attempt=1
while (( attempt <= max_attempts )); do
  if push_once "$STDERR_TMP"; then
    exit 0
  fi
  err_class=$(classify_error "$STDERR_TMP")
  if (( attempt < max_attempts )) && [[ "$err_class" == "ref-lock" || "$err_class" == "network" || "$err_class" == "gh-transient" ]]; then
    if [[ -n "${COORDINATOR_AUTO_PUSH_NO_SLEEP:-}" ]]; then
      : # test seam — skip backoff
    elif [[ "$err_class" == "gh-transient" ]]; then
      # Server-side recovery is seconds-scale: 2s, then 4s (+0-500ms jitter to
      # de-sync concurrent hooks). Worst-case added latency on a sustained outage
      # is ~6s per commit — self-evidently an outage, and the normal (success on
      # attempt 1) path is unaffected.
      sleep "$(( attempt * 2 )).$(printf '%03d' $(( RANDOM % 500 )))"
    else
      # ref-lock / network: jittered sub-second backoff (200-700ms + 100ms/attempt).
      # The value below is the fractional part of one second (0.NNN s = NNN ms),
      # not a raw millisecond count passed to sleep. Keeps retry budget under ~2s.
      backoff_frac_ms=$(( (RANDOM % 500) + 200 + (attempt * 100) ))
      sleep "0.$(printf '%03d' "$backoff_frac_ms")"
    fi
    attempt=$((attempt + 1))
    continue
  fi
  # Extract the most informative line, NOT the first non-blank line. GitHub's
  # smart-http rejection prints `remote: error: Trace: <hex>` as a server-side
  # support correlation ID before the actual rejection reason on subsequent
  # `remote:` lines. Previous `head -1` grabbed the Trace preamble and threw
  # away the real cause. Strategy: prefer the first `remote: (error|rejected|
  # fatal):` line that ISN'T the Trace preamble; fall back to first non-blank.
  first_err=$(grep -v '^[[:space:]]*$' "$STDERR_TMP" 2>/dev/null \
    | grep -Ev '^remote: error: Trace:' \
    | grep -E '^remote: (error|rejected|fatal):' \
    | head -1 | tr -d '\r' | sed 's/[[:space:]]\+/ /g' | cut -c1-200)
  if [[ -z "$first_err" ]]; then
    first_err=$(grep -v '^[[:space:]]*$' "$STDERR_TMP" 2>/dev/null \
      | grep -Ev '^remote: error: Trace:' \
      | head -1 | tr -d '\r' | sed 's/[[:space:]]\+/ /g' | cut -c1-200)
  fi
  log_failure "$route_label" "$err_class" "$attempt" "$first_err" "$STDERR_TMP"
  exit 0
done

exit 0
