#!/usr/bin/env bash
# claude-home — thin shell wrapper for the ~/.claude path resolver.
#
# Spec backlink: coordinator/docs/wiki/machine-local-registry.md §4a
# Purpose: delegate all subcommands to _claude_home.py, resolving Python
# interpreter portably. Mirrors the bin/machine-local shape exactly so the
# two resolvers compose cleanly in install scripts.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMPL="$SCRIPT_DIR/_claude_home.py"

if ! [ -f "$IMPL" ]; then
    echo "claude-home: implementation not found at $IMPL" >&2
    exit 1
fi

# Resolve Python interpreter: prefer python3, fall back to python.
# Matches bin/machine-local's resolver for consistency; _claude_home.py uses
# only stdlib so any Python 3.x will do.
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "claude-home: python3 (or python) not found on PATH" >&2
    exit 1
fi

exec "$PYTHON" "$IMPL" "$@"
