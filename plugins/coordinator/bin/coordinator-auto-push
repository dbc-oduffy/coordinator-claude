#!/bin/bash
# coordinator-auto-push — canonical post-commit auto-push helper
#
# Pushes the current branch to origin if it is a work/* or feature/* branch.
# On Windows + Git Bash, falls back to PowerShell when the remote requires SSH,
# because Git Bash's bundled OpenSSH cannot reach 1Password's SSH agent
# (Windows pipe \\.\pipe\openssh-ssh-agent).
#
# Invocation: called from .git/hooks/post-commit (sync) or wrapped in `( ... ) &`
# for async push (large repos).
#
# Always exits 0 — auto-push must never block a commit.
#
# Logs failures to .git/push-failures.log.

set -uo pipefail
# Deliberate: do not exit on non-zero — push failure must not block commits

RAW_BRANCH=$(git branch --show-current 2>/dev/null) || exit 0

# Canonicalize branch case via the on-disk ref name. On Windows's case-insensitive
# filesystem, `.git/HEAD` can carry a different case (e.g. `work/STRIKER/...`) than
# the actual ref file (`refs/heads/work/striker/...`). `git push` does ref lookups
# case-sensitively against the canonical name, so a mismatched HEAD makes
# `git push origin "$RAW_BRANCH"` fail with "cannot be resolved to branch."
# `for-each-ref` returns the canonical case (the form the remote also expects).
# If lookup fails for any reason, fall back to RAW_BRANCH so we don't regress on
# Linux/macOS where this hazard doesn't exist.
BRANCH=$(git for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null \
  | awk -v b="$RAW_BRANCH" 'tolower($0)==tolower(b){print; exit}')
[[ -z "$BRANCH" ]] && BRANCH="$RAW_BRANCH"

# Only push on work/* branches — feature/* removed because block-off-daily-branch.sh
# now denies feature/* creation; leaving it in auto-push would propagate any branches
# that slip through via COORDINATOR_OVERRIDE_BRANCH. Doctrine: work/* only.
# Review: patrik F12 (auto-push tightening) + c474ee1 follow-up.
#
# Case-sensitivity (Patrik R1 F7 + 2026-05-07 HTTPS-autopush spinoff): the
# `case work/*` prefix check accepted both `work/STRIKER/...` and `work/striker/...`
# transparently, but the *push spec* did not — `git push origin work/STRIKER/...`
# fails when the canonical ref is lowercase. The for-each-ref normalization above
# now handles this on the push side too. Do NOT remove the lowercase normalization.
# Both push paths below (direct + PowerShell-routed SSH) interpolate the
# canonicalized $BRANCH, so the fix applies uniformly to HTTPS and SSH on Windows.
case "$BRANCH" in
  work/*) ;;
  *) exit 0 ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
REMOTE_URL=$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null) || exit 0

log_failure() {
  local reason="$1"
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] PUSH FAILED on $BRANCH ($reason)" \
    >> "$REPO_ROOT/.git/push-failures.log"
}

# --- Path selection -------------------------------------------------------
# Git Bash on Windows sets MSYSTEM (MINGW64 / MINGW32 / MSYS).
# SSH remotes on git@host or ssh:// URLs need 1Password's agent, which
# Git Bash's bundled ssh cannot reach. PowerShell uses Windows OpenSSH which
# can. HTTPS remotes work fine in either shell (Windows Credential Manager).

is_windows_bash=false
if [[ -n "${MSYSTEM:-}" ]] || [[ "${OS:-}" == "Windows_NT" ]]; then
  is_windows_bash=true
fi

is_ssh_remote=false
case "$REMOTE_URL" in
  git@*|ssh://*) is_ssh_remote=true ;;
esac

if [[ "$is_windows_bash" == true && "$is_ssh_remote" == true ]]; then
  # Route through PowerShell so Windows OpenSSH + 1Password agent pipe is used.
  # Pass REPO_ROOT and BRANCH via environment variables so embedded apostrophes
  # in the repo path can't break out of the -Command string. -NonInteractive
  # prevents UI prompts. -WindowStyle Hidden suppresses the blue console flash.
  if ! REPO_ROOT="$REPO_ROOT" BRANCH="$BRANCH" \
       powershell.exe -NonInteractive -NoProfile -WindowStyle Hidden -Command \
       'git -C $env:REPO_ROOT push origin $env:BRANCH --set-upstream' \
       >/dev/null 2>&1; then
    log_failure "powershell ssh push"
  fi
else
  # Direct push — HTTPS on any platform, or SSH on Linux/macOS.
  if ! git push origin "$BRANCH" --set-upstream >/dev/null 2>&1; then
    log_failure "direct push"
  fi
fi

exit 0
