#!/bin/bash
# coordinator-safe-commit — Scoped safety commit helper (Phase 3, scoped-safety-commits plan)
#
# Canonical invocation:
#   ~/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-safe-commit "<subject>"
# Or alias in shell rc:
#   alias safe-commit='~/.claude/plugins/coordinator-claude/coordinator/bin/coordinator-safe-commit'
#
# Usage forms:
#   coordinator-safe-commit "<subject>"                   # default — scoped staging
#   coordinator-safe-commit --blanket "<subject>"         # blanket staging (carve-outs only)
#   coordinator-safe-commit --scope-from <path> "<subject>" # workstream-anchored (handoff/pickup)
#   coordinator-safe-commit --dry-run "<subject>"         # show what would be staged, no commit
#
# Environment:
#   CLAUDE_SESSION_ID            — session ID (highest priority source)
#   CLAUDE_INVOKING_COMMAND      — required for --blanket (must be one of: session-start, workday-complete, update-docs, relay-protocol, distillation)
#   COORDINATOR_OVERRIDE_SCOPE=1 — emergency: stage all dirty files, logs override, skip subtraction
#
# See: ~/.claude/plans/scoped-safety-commits.md  (design)
#      ~/.claude/plans/review-scoped-safety-commits-patrik.md  (Patrik's review)

set -euo pipefail

# ---------------------------------------------------------------------------
# Library source
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="${SCRIPT_DIR}/../lib/coordinator-session.sh"

if [[ ! -f "$LIB" ]]; then
  echo "ERROR: coordinator-session.sh not found at ${LIB}" >&2
  exit 1
fi
# shellcheck source=../lib/coordinator-session.sh
source "$LIB"

# Script-global: path to the overlap-gate lock directory (set by _with_overlap_lock,
# read by EXIT traps in do_scope_from and do_scoped so that a body function calling
# exit 1 still cleans up the lock — the RETURN trap does not fire on script exit).
# Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — mkdir-lock EXIT trap.
_overlap_lock_dir=""

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

MODE="default"       # default | blanket | scope-from | dry-run
SCOPE_FROM_PATH=""
SUBJECT=""
ALLOW_OUT_OF_SCOPE_DIRTY=0  # --allow-out-of-scope-dirty
EXPECTED_BRANCH=""   # --expected-branch <name>: deterministic branch-pin gate
INCLUDE_ORPHANS=()   # --include-orphans <pathspec>...: claim hook/install-touched files (Phase 2)

usage() {
  cat >&2 <<'USAGE'
Usage:
  coordinator-safe-commit "<subject>"
  coordinator-safe-commit --blanket "<subject>"
  coordinator-safe-commit --scope-from <handoff.md> "<subject>"
  coordinator-safe-commit --dry-run "<subject>"

Optional flags (combinable):
  --expected-branch <name>          Fail closed if active branch != <name>
  --allow-out-of-scope-dirty        (--scope-from only) warn instead of error
                                    when dirty files exist outside declared scope
  --include-orphans <pathspec>...   Claim hook/install-script-touched files for
                                    this commit. Variadic until next flag or --.
                                    One-shot (not appended to touched.txt). Runs
                                    the runtime overlap gate; requires single live
                                    session or --scope-from for concurrent use.
USAGE
  exit 1
}

# Parse flags before subject
while [[ $# -gt 0 ]]; do
  case "$1" in
    --blanket)
      MODE="blanket"
      shift
      ;;
    --scope-from)
      MODE="scope-from"
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --scope-from requires a path argument." >&2
        exit 1
      fi
      SCOPE_FROM_PATH="$2"
      shift 2
      ;;
    --dry-run)
      MODE="dry-run"
      shift
      ;;
    --allow-out-of-scope-dirty)
      ALLOW_OUT_OF_SCOPE_DIRTY=1
      shift
      ;;
    --include-orphans)
      # Variadic: consume subsequent args until next flag (starts with -), --, or
      # until only one positional remains (which must be the commit subject).
      # The subject MUST be the last positional arg. Use '--' to explicitly terminate
      # pathspecs if a pathspec could be confused for the subject.
      shift
      while [[ $# -gt 1 && "$1" != "--" && "$1" != -* ]]; do
        INCLUDE_ORPHANS+=("$1")
        shift
      done
      if [[ ${#INCLUDE_ORPHANS[@]} -eq 0 ]]; then
        echo "ERROR: --include-orphans requires at least one pathspec argument." >&2
        exit 1
      fi
      ;;
    --expected-branch)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --expected-branch requires a branch-name argument." >&2
        exit 1
      fi
      EXPECTED_BRANCH="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "ERROR: Unknown flag: $1" >&2
      usage
      ;;
    *)
      break
      ;;
  esac
done

# Remaining arg is the subject
if [[ $# -eq 0 ]]; then
  echo "ERROR: Commit subject is required." >&2
  usage
fi
if [[ $# -gt 1 ]]; then
  echo "ERROR: Too many positional arguments. Quote your subject." >&2
  usage
fi
SUBJECT="$1"

if [[ -z "$SUBJECT" ]]; then
  echo "ERROR: Commit subject cannot be empty." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Session ID resolution
# ---------------------------------------------------------------------------

resolve_session_id() {
  # Priority 1: environment variable
  if [[ -n "${CLAUDE_SESSION_ID:-}" ]]; then
    echo "$CLAUDE_SESSION_ID"
    return 0
  fi

  # Priority 2: sentinel file
  local root
  root=$(_cs_git_root) || true
  if [[ -n "$root" ]]; then
    local sentinel="${root}/.git/coordinator-sessions/.current-session-id"
    if [[ -f "$sentinel" ]]; then
      local sid
      sid=$(cat "$sentinel" | tr -d '[:space:]')
      if [[ -n "$sid" ]]; then
        # Phase 1 (safe-commit-fixes): validate the session dir exists before trusting
        # the sentinel. The sentinel outlives the session dir when a session crashes
        # without cleanup — the stale ID would then drive the wrong-session path.
        # Spec backlink: plans/safe-commit-fixes.md § Phase 1 — sentinel validation.
        local sdir_check
        sdir_check=$(_cs_sessions_dir) || true
        if [[ -n "$sdir_check" && -d "${sdir_check}/${sid}" ]]; then
          echo "$sid"
          return 0
        else
          echo "WARNING: sentinel points at '${sid}' but session dir is gone — falling through to PID scan" >&2
          # sid="" and fall through to Priority 3
        fi
      fi
    fi
  fi

  # Priority 3: find a session dir whose meta.json PID matches a live process
  local base
  base=$(_cs_sessions_dir) || true
  if [[ -z "$base" || ! -d "$base" ]]; then
    echo "" ; return 1
  fi

  local live_sessions=()
  for sdir in "${base}"/*/; do
    [[ -d "$sdir" ]] || continue
    local sid
    sid=$(basename "$sdir")
    [[ "$sid" == ".archive" ]] && continue
    [[ "$sid" == ".agents" ]] && continue

    local pid
    pid=$(_cs_read_meta_field "$sdir" "pid")
    if _cs_pid_alive "$pid"; then
      live_sessions+=("$sid")
    fi
  done

  if [[ ${#live_sessions[@]} -eq 1 ]]; then
    echo "${live_sessions[0]}"
    return 0
  elif [[ ${#live_sessions[@]} -eq 0 ]]; then
    echo "ERROR: No live session found. Set CLAUDE_SESSION_ID or ensure a session was initialized." >&2
    echo "Fallback: bypass the helper with explicit-path commit:" >&2
    echo "  git add -- <your-paths>" >&2
    echo "  git commit -m \"<subject>\"" >&2
    return 1
  else
    echo "ERROR: Multiple live sessions found — cannot auto-detect session ID. Set CLAUDE_SESSION_ID explicitly. Candidates: ${live_sessions[*]}" >&2
    echo "If session-ownership is misidentifying your work (your files blocked, others' files swept), the safer fallback is to bypass the helper:" >&2
    echo "  git add -- <your-paths>" >&2
    echo "  git commit -m \"<subject>\"" >&2
    return 1
  fi
}

# ---------------------------------------------------------------------------
# YAML frontmatter parser (for --scope-from)
# ---------------------------------------------------------------------------

# parse_scope_from_frontmatter <file>
# Prints one pathspec per line to stdout.
# Returns 1 if frontmatter is missing or scope: is absent.
parse_scope_from_frontmatter() {
  local fpath="${1:?}"

  if [[ ! -f "$fpath" ]]; then
    echo "ERROR: Handoff file not found: ${fpath}" >&2
    return 1
  fi

  # Read lines between the first two "---" delimiters (YAML frontmatter)
  local in_frontmatter=false
  local started=false
  local in_scope=false
  local found_scope=false
  local scope_entries=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip trailing CR for CRLF-encoded files (Windows handoffs).
    # Without this, "$line" == "---" never matches and the parser silently
    # reports "no scope: field found" — a bug observed across 4+ sessions.
    line="${line%$'\r'}"

    if [[ "$line" == "---" ]]; then
      if [[ "$started" == false ]]; then
        started=true
        in_frontmatter=true
        continue
      elif [[ "$in_frontmatter" == true ]]; then
        in_frontmatter=false
        break
      fi
    fi

    [[ "$in_frontmatter" == false ]] && continue

    # Detect "scope:" key
    if [[ "$line" =~ ^scope:[[:space:]]*$ ]]; then
      in_scope=true
      found_scope=true
      continue
    fi

    # If we are inside scope:, collect list items ("  - value")
    if [[ "$in_scope" == true ]]; then
      if [[ "$line" =~ ^[[:space:]]+\-[[:space:]]+(.+)$ ]]; then
        scope_entries+=("${BASH_REMATCH[1]}")
      elif [[ "$line" =~ ^[a-zA-Z] ]]; then
        # New top-level key — exit scope block
        in_scope=false
      fi
    fi
  done < "$fpath"

  if [[ "$found_scope" == false ]]; then
    echo "ERROR: No 'scope:' field found in YAML frontmatter of ${fpath}" >&2
    return 1
  fi

  if [[ ${#scope_entries[@]} -eq 0 ]]; then
    echo "ERROR: 'scope:' field is present but empty in ${fpath}" >&2
    return 1
  fi

  for entry in "${scope_entries[@]}"; do
    echo "$entry"
  done
  return 0
}

# validate_pathspec <pathspec>
# Returns 0 if git accepts it, 1 if malformed.
validate_pathspec() {
  local ps="${1:?}"
  git ls-files -- "$ps" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# active-scope.txt success-path cleanup
# ---------------------------------------------------------------------------

# _cleanup_active_scope
# Purpose: remove active-scope.txt and clear the script-global pointer after a
# successful commit. Called from both do_scope_from (no-orphan path) and
# do_scoped (combined-mode success path). The EXIT/INT/TERM/HUP trap covers
# error paths; this function covers the happy path so that peer sessions do not
# false-positive on the overlap gate after we have committed.
# Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 5 — _cleanup_active_scope.
_cleanup_active_scope() {
  if [[ -n "${_sfm_active_scope_file:-}" ]]; then
    rm -f "$_sfm_active_scope_file"
    _sfm_active_scope_file=""
  fi
}

# ---------------------------------------------------------------------------
# Overlap-gate lock (Fix 6) and scoped overlap-check helpers
# ---------------------------------------------------------------------------

# _with_overlap_lock <body_fn> [args...]
# Purpose: acquire the per-repo overlap-gate lock via atomic mkdir, run the body
# function, then release the lock. Mirrors cs_claim_handoff in lib/coordinator-session.sh
# (mkdir as atomic primitive — POSIX + NTFS safe, no external dependency).
#
# flock is NOT used: unavailable on Git Bash for Windows (command -v flock returns
# nothing on this platform). mkdir is universal.
#
# Lock scope is intentionally narrow — held only across the check + publish of
# active-scope.txt, NOT across git add / git commit (those are long-running and
# don't need mutual exclusion for correctness).
#
# Exit-code contract: propagates the body's exit code unchanged (Patrik finding 1).
# Caller MUST NOT swallow non-zero — overlap-check bodies call exit 1 on conflict.
#
# Signal-path cleanup: the RETURN trap fires when this function returns normally.
# When the body calls `exit 1`, the RETURN trap does NOT fire (it is a script exit).
# To handle that case, _overlap_lock_dir is a script-global read by the EXIT traps
# in do_scope_from and do_scoped — they rm -rf it before clearing _sfm_active_scope_file.
#
# Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — mkdir-lock.
_with_overlap_lock() {
  local lock_dir="${base}/.overlap-gate.lock"
  local timeout_s=10
  local waited=0
  mkdir -p "$base" 2>/dev/null
  while ! mkdir "$lock_dir" 2>/dev/null; do
    # Inspect holder PID; reap stale (dead PID) locks.
    local held_pid
    held_pid=$(cat "${lock_dir}/pid" 2>/dev/null || echo "")
    if [[ -n "$held_pid" ]] && ! _cs_pid_alive "$held_pid"; then
      echo "WARNING: reaping stale overlap-gate lock (dead PID ${held_pid})" >&2
      rm -rf "$lock_dir" 2>/dev/null
      continue
    fi
    if (( waited >= timeout_s )); then
      # Fail-loud — no degraded-mode fallback (Patrik finding 2).
      # The mkdir primitive is universal; timeout means a real contention problem.
      echo "ERROR: overlap-gate lock timeout (${timeout_s}s); held by PID ${held_pid:-?}" >&2
      return 1
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done
  echo "$$" > "${lock_dir}/pid"
  # Expose lock dir to EXIT traps in do_scope_from / do_scoped so they can clean up
  # when the body calls exit 1 (RETURN trap does not fire on script exit).
  _overlap_lock_dir="$lock_dir"
  # RETURN trap: fire on normal function return. Redundant with explicit rm below
  # but guards against early-return paths (e.g., unexpected errors in the body that
  # propagate as non-exit failures).
  trap 'rm -rf "${_overlap_lock_dir:-}" 2>/dev/null; _overlap_lock_dir=""' RETURN
  "$@"
  local rc=$?
  rm -rf "$lock_dir" 2>/dev/null
  _overlap_lock_dir=""
  trap - RETURN
  return $rc
}

# _do_scope_from_overlap_check_and_publish <active_scope_file> <base> <session_id> <handoff_files_ref> <scope_set_ref>
# Purpose: write this session's handoff scope to active-scope.txt and check for
# file-level collisions with peer sessions' declared scopes. Runs inside
# _with_overlap_lock so the write + check are atomic (no TOCTOU window).
# Uses bash namerefs for array/assoc-array arguments (bash 4.3+; we run 5.3).
# Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — inner helper.
_do_scope_from_overlap_check_and_publish() {
  local active_scope_file="$1"
  local _base="$2"
  local _session_id="$3"
  local -n _handoff_files_ref="$4"   # indexed array: files to write to active-scope.txt
  local -n _scope_set_ref="$5"       # assoc array: files to check against peers

  # Write this session's scope (replaces step 5 write inside the lock).
  if [[ ${#_handoff_files_ref[@]} -gt 0 ]]; then
    printf '%s\n' "${_handoff_files_ref[@]}" > "$active_scope_file"
  else
    : > "$active_scope_file"
  fi

  # Check peers for scope collisions (step 6 overlap gate, inside the lock).
  if [[ -n "$_base" && -d "$_base" ]]; then
    for _sfop_peer_sdir in "${_base}"/*/; do
      [[ -d "$_sfop_peer_sdir" ]] || continue
      local _sfop_peer_id
      _sfop_peer_id=$(basename "$_sfop_peer_sdir")
      [[ "$_sfop_peer_id" == "$_session_id" ]] && continue
      [[ "$_sfop_peer_id" == ".archive" ]] && continue
      [[ "$_sfop_peer_id" == ".agents" ]] && continue
      local _sfop_peer_scope="${_sfop_peer_sdir}active-scope.txt"
      [[ -f "$_sfop_peer_scope" ]] || continue
      while IFS= read -r _sfop_path; do
        [[ -z "$_sfop_path" ]] && continue
        if [[ -v "_scope_set_ref[$_sfop_path]" ]]; then
          echo "ERROR: scope overlaps with session ${_sfop_peer_id}'s handoff at ${_sfop_path}; resolve via explicit-path commit." >&2
          exit 1
        fi
      done < "$_sfop_peer_scope"
    done
  fi
}

# _do_scoped_orphan_overlap_check_and_publish <active_scope_file> <base> <session_id> <orphan_resolved_ref> <union_scope_set_ref>
# Purpose: append resolved orphan paths to active-scope.txt and check the union
# (handoff scope + orphans) for collisions with peer sessions. Runs inside
# _with_overlap_lock (Fix 6). Only called from do_scoped's --include-orphans path.
# Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — inner helper.
_do_scoped_orphan_overlap_check_and_publish() {
  local active_scope_file="$1"
  local _base="$2"
  local _session_id="$3"
  local -n _orphan_resolved_ref="$4"   # indexed array: orphan files to append
  local -n _union_scope_set_ref="$5"   # assoc array: full union for overlap check

  # Append resolved orphan paths to active-scope.txt (additive in combined-mode;
  # initial write in pure default-mode — file was created empty above).
  if [[ -n "$active_scope_file" && ${#_orphan_resolved_ref[@]} -gt 0 ]]; then
    printf '%s\n' "${_orphan_resolved_ref[@]}" >> "$active_scope_file"
  fi

  # Overlap gate: check union against peer sessions (same logic as step 6 but on union).
  if [[ -n "$_base" && -d "$_base" ]]; then
    for _sdop_peer_sdir in "${_base}"/*/; do
      [[ -d "$_sdop_peer_sdir" ]] || continue
      local _sdop_peer_id
      _sdop_peer_id=$(basename "$_sdop_peer_sdir")
      [[ "$_sdop_peer_id" == "$_session_id" ]] && continue
      [[ "$_sdop_peer_id" == ".archive" ]] && continue
      [[ "$_sdop_peer_id" == ".agents" ]] && continue
      local _sdop_peer_scope="${_sdop_peer_sdir}active-scope.txt"
      [[ -f "$_sdop_peer_scope" ]] || continue
      while IFS= read -r _sdop_path; do
        [[ -z "$_sdop_path" ]] && continue
        if [[ -v "_union_scope_set_ref[$_sdop_path]" ]]; then
          echo "ERROR: --include-orphans: '${_sdop_path}' is already claimed by session ${_sdop_peer_id}." >&2
          echo "Resolve: wait for that session to finish, or use explicit-path commit without the helper." >&2
          exit 1
        fi
      done < "$_sdop_peer_scope"
    done
  fi
}

# ---------------------------------------------------------------------------
# Structured pre-commit summary printer
# ---------------------------------------------------------------------------

# print_summary <staged_count> <staged_list_nl> <orphan_count> <orphan_list_nl> <other_count> <other_list_nl>
print_summary() {
  local staged_count="$1"
  local staged_list="$2"
  local orphan_count="$3"
  local orphan_list="$4"
  local other_count="$5"
  local other_list="$6"

  echo "" >&2
  echo "Scope: ${staged_count} file(s) staged" >&2
  if [[ -n "$staged_list" ]]; then
    while IFS= read -r f; do
      [[ -n "$f" ]] && echo "  ${f}" >&2
    done <<< "$staged_list"
  fi

  echo "Orphans (dirty, no session claim): ${orphan_count} file(s) — NOT STAGED" >&2
  if [[ -n "$orphan_list" ]]; then
    while IFS= read -r f; do
      [[ -n "$f" ]] && echo "  ${f}" >&2
    done <<< "$orphan_list"
  fi

  echo "Other-session-owned (excluded): ${other_count} file(s)" >&2
  if [[ -n "$other_list" ]]; then
    while IFS= read -r f; do
      [[ -n "$f" ]] && echo "  ${f}" >&2
    done <<< "$other_list"
  fi
  echo "" >&2
}

# ---------------------------------------------------------------------------
# BLANKET MODE — foreign-staging pre-check
# ---------------------------------------------------------------------------
#
# _blanket_check_foreign_staging <current_session_id>
#   Warn on stderr when --blanket is about to commit files claimed by sibling
#   sessions.  Advisory only: does NOT block the commit.
#
# Spec backlink: tasks/coordinator-improvement-queue.md — blanket pre-check entry.
#
# Algorithm:
#   1. Collect touched.txt paths from every live sibling session → $foreign_paths
#   2. Collect would-be-staged paths via git status --porcelain → $prospective_paths
#      (matches what git add -A will see, not --cached which is pre-add)
#   3. Emit WARN block for any intersection, unless COORDINATOR_BLANKET_ACCEPT_FOREIGN=1
_blanket_check_foreign_staging() {
  local current_sid="${1:?session_id required}"

  # Silently skip if the environment opt-out is set
  if [[ "${COORDINATOR_BLANKET_ACCEPT_FOREIGN:-}" == "1" ]]; then
    return 0
  fi

  local base
  base=$(_cs_sessions_dir) || return 0
  [[ -d "$base" ]] || return 0

  # --- 1. Build foreign_paths: paths claimed by live sibling sessions ----------
  # mapfile requires bash 4+; cs_live_session_ids already uses bash 4 features so
  # this is safe.  Use process substitution to avoid subshell variable scoping.
  local -a live_sids=()
  mapfile -t live_sids < <(cs_live_session_ids 2>/dev/null || true)

  # Map each foreign path to the short session id that claims it.
  # Format: "path|sid-short"  (pipe separator avoids spaces-in-paths issues)
  local -a foreign_entries=()
  local sid
  for sid in "${live_sids[@]:-}"; do
    [[ -z "$sid" ]] && continue
    [[ "$sid" == "$current_sid" ]] && continue
    local tfile="${base}/${sid}/touched.txt"
    [[ -f "$tfile" ]] || continue
    local sid_short="${sid:0:8}"
    local fpath
    while IFS= read -r fpath; do
      [[ -z "$fpath" ]] && continue
      foreign_entries+=("${fpath}|${sid_short}")
    done < "$tfile"
  done

  # Nothing foreign at all — fast exit
  if [[ ${#foreign_entries[@]} -eq 0 ]]; then
    return 0
  fi

  # --- 2. Build prospective_paths: what git add -A would stage -----------------
  local -a prospective_paths=()
  local status_line path_col
  while IFS= read -r status_line; do
    [[ -z "$status_line" ]] && continue
    local xy="${status_line:0:2}"
    local rest="${status_line:3}"
    if [[ "$xy" == R* || "$xy" == *R ]]; then
      # Rename line: "old -> new" — take the post-arrow path
      path_col="${rest##* -> }"
    else
      path_col="$rest"
    fi
    prospective_paths+=("$path_col")
  done < <(git status --porcelain 2>/dev/null || true)

  if [[ ${#prospective_paths[@]} -eq 0 ]]; then
    return 0
  fi

  # --- 3. Intersection: which prospective paths are also foreign ---------------
  local -a overlap_entries=()
  local entry fp_sid fp_path ppath
  for entry in "${foreign_entries[@]}"; do
    fp_path="${entry%%|*}"
    fp_sid="${entry##*|}"
    for ppath in "${prospective_paths[@]}"; do
      if [[ "$ppath" == "$fp_path" ]]; then
        overlap_entries+=("  ${fp_path}   (claimed by ${fp_sid})")
        break
      fi
    done
  done

  # --- 4. Emit WARN block if any overlap found ---------------------------------
  if [[ ${#overlap_entries[@]} -gt 0 ]]; then
    local count=${#overlap_entries[@]}
    {
      echo "WARN: --blanket about to commit ${count} path(s) claimed by sibling session(s):"
      local line
      for line in "${overlap_entries[@]}"; do
        echo "$line"
      done
      echo "If this is intentional (cross-session sweep), set COORDINATOR_BLANKET_ACCEPT_FOREIGN=1 to suppress this warning."
      echo "Proceeding with commit."
    } >&2
  fi

  return 0
}

# ---------------------------------------------------------------------------
# BLANKET MODE
# ---------------------------------------------------------------------------

do_blanket() {
  local session_id="$1"

  # Carve-out enforcement: only valid from session-start or workday-complete
  local invoking="${CLAUDE_INVOKING_COMMAND:-}"
  local allowed=false

  if [[ "$invoking" == "session-start" || "$invoking" == "workday-complete" || \
        "$invoking" == "update-docs" || "$invoking" == "relay-protocol" || \
        "$invoking" == "distillation" ]]; then
    allowed=true
  fi

  # Fallback: inspect parent process command line
  if [[ "$allowed" == false ]]; then
    local ppid_cmd=""
    if [[ -r "/proc/$PPID/cmdline" ]]; then
      ppid_cmd=$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null || true)
    else
      ppid_cmd=$(ps -p "$PPID" -o command= 2>/dev/null || true)
    fi
    if [[ "$ppid_cmd" == *"session-start.md"* || "$ppid_cmd" == *"workday-complete.md"* || \
          "$ppid_cmd" == *"update-docs.md"* || "$ppid_cmd" == *"relay-protocol.md"* || \
          "$ppid_cmd" == *"distillation"* ]]; then
      allowed=true
    fi
  fi

  if [[ "$allowed" == false ]]; then
    cat >&2 <<'ERR'
ERROR: --blanket is only valid from authorized sweep ceremonies: /session-start, /workday-complete, /update-docs, relay-protocol, or distillation.
Use scoped staging (default) or COORDINATOR_OVERRIDE_SCOPE=1 for emergencies.
ERR
    exit 1
  fi

  # Log this invocation
  local base sdir log_file
  base=$(_cs_sessions_dir) || true
  if [[ -n "$base" && -n "$session_id" ]]; then
    sdir="${base}/${session_id}"
    mkdir -p "$sdir"
    log_file="${sdir}/blanket-invocations.log"
    echo "$(_cs_now_iso) invoking_command=${invoking:-unknown}" >> "$log_file"
  fi

  # Foreign-staging pre-check: warn if sibling sessions claim any prospective paths.
  _blanket_check_foreign_staging "$session_id"

  # Stage everything (this is the ONE sanctioned use of git add -A)
  # Sentinel 1: capture HEAD before commit so we can detect silent no-ops.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 1.
  local _pre_head
  _pre_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  git add -A
  # Sentinel 2: wrap commit call so mid-call failures (hook reject, detached HEAD)
  # surface as a FAIL line rather than a silent non-zero exit.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 2.
  if ! git commit -m "$SUBJECT"; then
    local _rc=$?
    echo "FAIL: git commit returned ${_rc} in do_blanket" >&2
    exit 2
  fi
  local _post_head
  _post_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  if [[ "$_pre_head" == "$_post_head" ]]; then
    echo "FAIL: helper produced no commit (reason: HEAD unchanged after do_blanket commit attempt)" >&2
    exit 2
  fi
}

# ---------------------------------------------------------------------------
# SCOPE-FROM MODE
# ---------------------------------------------------------------------------

do_scope_from() {
  local session_id="$1"

  # The handoff scope: field is the declarative truth for what this session owns.
  # Cross-session subtraction was removed 2026-05-05 (Issue C, plan
  # docs/plans/2026-05-05-session-misidentification-fix.md): the helper no longer
  # reads any session's touched.txt in --scope-from mode. Identity-resolution
  # bugs (last-writer-wins sentinel under concurrent EMs / subagent SessionStart)
  # were causing the helper to read the wrong session's touched.txt and exclude
  # the calling session's own scope. The handoff scope is now load-bearing for
  # commit safety; overlapping scopes are caught by the runtime overlap gate
  # (step 5 below), not by post-hoc identity-keyed subtraction.

  # 1. Verify handoff file exists
  if [[ ! -f "$SCOPE_FROM_PATH" ]]; then
    echo "ERROR: --scope-from path does not exist: ${SCOPE_FROM_PATH}" >&2
    exit 1
  fi

  # 2. Parse frontmatter scope: array
  local handoff_scope_raw
  if ! handoff_scope_raw=$(parse_scope_from_frontmatter "$SCOPE_FROM_PATH"); then
    exit 1
  fi

  local handoff_pathspecs=()
  while IFS= read -r ps; do
    [[ -n "$ps" ]] && handoff_pathspecs+=("$ps")
  done <<< "$handoff_scope_raw"

  # 3. Validate each pathspec
  for ps in "${handoff_pathspecs[@]}"; do
    if ! validate_pathspec "$ps"; then
      echo "ERROR: Malformed or invalid pathspec in scope: '${ps}'" >&2
      exit 1
    fi
  done

  # 4. Expand handoff pathspecs to a concrete file list
  local handoff_files=()
  for ps in "${handoff_pathspecs[@]}"; do
    while IFS= read -r f; do
      [[ -n "$f" ]] && handoff_files+=("$f")
    done < <(git ls-files -- "$ps" 2>/dev/null; git ls-files --others --exclude-standard -- "$ps" 2>/dev/null)
  done

  # Build a hash set of declared-scope files for O(1) membership tests
  declare -A scope_set
  for f in "${handoff_files[@]}"; do
    [[ -n "$f" ]] && scope_set["$f"]=1
  done

  local base
  base=$(_cs_sessions_dir) || true

  # Script-globals: the active-scope.txt path for this scope-from run and a
  # sentinel indicating that the trap was installed by do_scope_from (so that
  # do_scoped — when called as a delegate — does not double-install a trap on
  # the same file). NOT declared local so the EXIT trap and do_scoped both see
  # them after do_scope_from returns on error paths.
  # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 5 — Patrik finding 0.
  _sfm_active_scope_file=""
  _sfm_trap_installed=0

  # 5. Side-channel write: declare this session's active scope (best-effort
  # session id is sufficient — file is keyed by session-dir, not by identity-
  # accuracy, and even an imprecise session id distinguishes from siblings).
  if [[ -n "$base" && -n "$session_id" ]]; then
    local sdir="${base}/${session_id}"
    mkdir -p "$sdir"
    _sfm_active_scope_file="${sdir}/active-scope.txt"
    # Install trap BEFORE the write so error paths clean up the file.
    # Also cleans up the overlap-gate lock if a body fn called exit 1 while
    # holding it (RETURN trap does not fire on script exit — see _with_overlap_lock).
    # Spec backlink: Patrik review fix-1 — active-scope.txt leak on error paths.
    # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — lock EXIT cleanup.
    trap 'rm -rf "${_overlap_lock_dir:-}" 2>/dev/null; _overlap_lock_dir=""; [ -n "${_sfm_active_scope_file:-}" ] && rm -f "${_sfm_active_scope_file:-}"' EXIT INT TERM HUP
    # Step 5 write + step 6 overlap check happen inside the lock (Fix 6) to close
    # the TOCTOU window between reading peers and writing own scope.
    # Lock is narrow: released before git add / git commit.
    # sdir already created above (line ~639); _with_overlap_lock also calls mkdir -p "$base".
    _with_overlap_lock _do_scope_from_overlap_check_and_publish \
      "$_sfm_active_scope_file" "$base" "$session_id" handoff_files scope_set || exit $?
  fi

  # 6. Runtime overlap gate is now inside _do_scope_from_overlap_check_and_publish
  # (called above under _with_overlap_lock). This comment preserved for step numbering
  # continuity — the lock closes the TOCTOU window that existed between the original
  # read-peers and write-own-scope sequence (Patrik finding 7 / Fix 6).
  # No inline overlap-gate loop here — it moved to the helper.

  # 6b. Combined-mode --include-orphans processing (Phase 2).
  # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 5 — delegate to do_scoped.
  #
  # do_scope_from has now published active-scope.txt (step 5) and checked the handoff
  # scope against peers (step 6). Orphan resolution, union-scope overlap gate, audit
  # log, and commit are all handled by do_scoped's --include-orphans path — which is
  # the single canonical implementation. Delegating here eliminates the ~80-line
  # duplicated block that lived here previously (Patrik finding 0).
  if [[ ${#INCLUDE_ORPHANS[@]} -gt 0 ]]; then
    # Set the sentinel BEFORE calling do_scoped so it skips the double-trap-install
    # on _active_scope_file. Greppable > clever: explicit name, not path-as-signal.
    _sfm_trap_installed=1
    do_scoped "$session_id"
    return $?
  fi

  # 7. Determine which declared-scope files are dirty (intersect scope ∩ git-status)
  # No-orphan path only: scope_set contains only handoff files.
  local dirty_files=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && dirty_files+=("$f")
  done < <(
    { git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u
  )

  local my_scope=()
  local out_of_scope_dirty=()
  for f in "${dirty_files[@]:-}"; do
    [[ -z "$f" ]] && continue
    if [[ -v "scope_set[$f]" ]]; then
      my_scope+=("$f")
    else
      out_of_scope_dirty+=("$f")
    fi
  done

  # 8. Out-of-scope dirty check (Issue C plan, second-order behavior change).
  # Files this session edited but did NOT declare in handoff scope are not
  # staged. If any such files exist, the helper exits non-zero with a hint
  # listing them, unless --allow-out-of-scope-dirty was passed.
  if [[ ${#out_of_scope_dirty[@]} -gt 0 ]]; then
    if [[ "$ALLOW_OUT_OF_SCOPE_DIRTY" == "1" ]]; then
      # Honor the flag consistently in both normal and dry-run modes: warn but continue.
      echo "WARNING: ${#out_of_scope_dirty[@]} dirty file(s) outside declared scope (not staged; --allow-out-of-scope-dirty in effect):" >&2
      for f in "${out_of_scope_dirty[@]}"; do echo "  ${f}" >&2; done
    else
      # Error in both normal and dry-run modes so --allow-out-of-scope-dirty has consistent
      # semantics regardless of whether --dry-run is also passed.
      echo "ERROR: ${#out_of_scope_dirty[@]} dirty file(s) outside declared scope:" >&2
      for f in "${out_of_scope_dirty[@]}"; do echo "  ${f}" >&2; done
      echo "Resolve: include them in the handoff scope, stash them, or pass --allow-out-of-scope-dirty." >&2
      exit 1
    fi
  fi

  if [[ "${MODE}" == "dry-run" ]]; then
    # No-orphan path only (--include-orphans delegates to do_scoped before reaching here).
    echo "DRY RUN — would stage ${#my_scope[@]} file(s):" >&2
    for f in "${my_scope[@]:-}"; do echo "  $f" >&2; done
    # Out-of-scope dirty files were already reported above (error+exit or warning).
    echo "(no git add or commit executed)" >&2
    exit 0
  fi

  # 9. Stage and commit — empty-array guard matches do_scoped line ~1079.
  # Without this guard, an empty my_scope produces `git add --` with no args,
  # which emits an obscure error instead of the actionable message below.
  local staged_count=${#my_scope[@]}
  if [[ ${#my_scope[@]} -eq 0 ]]; then
    echo "ERROR: declared scope filtered to zero dirty files — nothing to commit." >&2
    exit 1
  fi
  # Sentinel 1: capture HEAD before commit to detect silent no-ops.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 1.
  local _pre_head
  _pre_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  printf '%s\0' "${my_scope[@]}" | xargs -0 git add --
  # Sentinel 2: wrap commit call so mid-call failures surface as a FAIL line.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 2.
  if ! git commit -m "$SUBJECT"; then
    local _rc=$?
    echo "FAIL: git commit returned ${_rc} in do_scope_from" >&2
    exit 2
  fi
  local _post_head
  _post_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  if [[ "$_pre_head" == "$_post_head" ]]; then
    echo "FAIL: helper produced no commit (reason: HEAD unchanged after do_scope_from commit attempt)" >&2
    exit 2
  fi

  # Clean up active-scope.txt — declared scope is no longer active after commit succeeds.
  # Without this, peer sessions read stale entries and false-positive on overlap gate.
  # Use the shared helper so both do_scope_from and do_scoped (combined-mode) share one path.
  _cleanup_active_scope

  # Build display list for print_summary (no orphan annotation needed: no-orphan path)
  local _sfm_display_list=()
  for _sfm_sf in "${my_scope[@]}"; do
    _sfm_display_list+=("$_sfm_sf")
  done

  print_summary "$staged_count" "$(printf '%s\n' "${_sfm_display_list[@]:-}")" \
    0 "" \
    0 ""
}

# ---------------------------------------------------------------------------
# OVERRIDE MODE helper
# ---------------------------------------------------------------------------

do_override() {
  local session_id="$1"

  echo "WARNING: COORDINATOR_OVERRIDE_SCOPE=1 is set — audit-trail-degraded path." >&2
  echo "         Staging all dirty files. This will be logged." >&2

  # Collect dirty files for the log
  local dirty_files=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && dirty_files+=("$f")
  done < <(
    { git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u
  )

  # Log the override
  local base
  base=$(_cs_sessions_dir) || true
  if [[ -n "$base" && -n "$session_id" ]]; then
    local sdir="${base}/${session_id}"
    mkdir -p "$sdir"
    local log_file="${sdir}/overrides.log"
    {
      echo "=== Override at $(_cs_now_iso) ==="
      echo "Subject: ${SUBJECT}"
      echo "Files staged:"
      printf '  %s\n' "${dirty_files[@]:-}"
      echo ""
    } >> "$log_file"
  fi

  # Sentinel 1: capture HEAD before commit to detect silent no-ops.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 1.
  local _pre_head
  _pre_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  git add -A
  # Sentinel 2: wrap commit call so mid-call failures surface as a FAIL line.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 2.
  if ! git commit -m "$SUBJECT"; then
    local _rc=$?
    echo "FAIL: git commit returned ${_rc} in do_override" >&2
    exit 2
  fi
  local _post_head
  _post_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  if [[ "$_pre_head" == "$_post_head" ]]; then
    echo "FAIL: helper produced no commit (reason: HEAD unchanged after do_override commit attempt)" >&2
    exit 2
  fi
}

# ---------------------------------------------------------------------------
# DEFAULT / DRY-RUN MODE (main scoped path)
# ---------------------------------------------------------------------------

do_scoped() {
  local session_id="$1"
  # Paths claimed via --include-orphans; populated later if the flag was passed.
  # Declared here so all code paths (dry-run, error branches, commit) see the var.
  _orphan_claimed_paths=()
  # active-scope.txt path (set by --include-orphans pure default-mode; used in trap).
  # NOT declared local so the trap function can still see it after do_scoped returns.
  _active_scope_file=""
  # Temp files for cs_compute_scope capture. Script-globals (not local) so the
  # consolidated trap below can see them after do_scoped returns on error paths.
  tmpout=""
  tmperr=""

  # Single consolidated trap covering EXIT INT TERM HUP. Guards every temp/scope
  # artifact declared above. ${var:-} guards required — set -u; trap runs at any
  # exit point including before the variables are assigned their mktemp paths.
  # Spec backlink: Patrik review fix-2 — trap-collision consolidation.
  #
  # When do_scope_from delegates here (_sfm_trap_installed=1), it has already
  # installed its own trap on _sfm_active_scope_file (== _active_scope_file path).
  # Skip the duplicate rm to avoid racing the do_scope_from trap on the same file.
  # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 5 — Patrik finding 0.
  #
  # Also cleans up the overlap-gate lock dir if a body fn called exit 1 while
  # holding it (RETURN trap does not fire on script exit — see _with_overlap_lock).
  # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — lock EXIT cleanup.
  trap 'rm -f "${tmpout:-}" "${tmperr:-}"; rm -rf "${_overlap_lock_dir:-}" 2>/dev/null; _overlap_lock_dir=""; [[ "${_sfm_trap_installed:-0}" -ne 1 ]] && [ -n "${_active_scope_file:-}" ] && rm -f "${_active_scope_file:-}"' EXIT INT TERM HUP

  # Issue C fail-closed gate: default mode is unsafe under concurrent sessions
  # because it relies on session-id sentinel resolution, which is
  # last-writer-wins under subagent SessionStart and concurrent EMs (see
  # docs/plans/2026-05-05-session-misidentification-fix.md). When >1 live
  # session is detected, refuse to proceed and direct the caller to
  # --scope-from or COORDINATOR_OVERRIDE_SCOPE=1 with explicit-path staging.
  #
  # Exception: combined-mode (do_scope_from delegating via _sfm_trap_installed=1).
  # do_scope_from already handled identity resolution and the handoff-scope overlap
  # gate, so concurrent sessions are expected and safe at this point.
  if [[ "${_sfm_trap_installed:-0}" -ne 1 ]]; then
    local _live_ids=()
    mapfile -t _live_ids < <(cs_live_session_ids 2>/dev/null || true)
    local _live_count=${#_live_ids[@]}
    if [[ "$_live_count" -gt 1 ]]; then
      echo "ERROR: multiple live sessions detected (${_live_count}); default-mode commit is unsafe under concurrency." >&2
      for sid_line in "${_live_ids[@]}"; do
        echo "  ${sid_line}" >&2
      done
      echo "Resolve: use --scope-from <handoff> for workstream commits, or COORDINATOR_OVERRIDE_SCOPE=1 with explicit-path staging for emergencies." >&2
      exit 1
    fi
  fi

  # Read my touched.txt for post-filtering (mtime-only orphan exclusion)
  # cs_compute_scope adds mtime-dirty unclaimed files to my_scope, but per
  # plan orphan policy those must only be warned, never auto-staged.
  # We enforce this here by removing from my_scope any file that:
  #   - is NOT in my touched.txt
  #   - is NOT claimed by another session (i.e., is an orphan)
  local my_touched=()
  local base
  base=$(_cs_sessions_dir) || true
  if [[ -n "$base" && -n "$session_id" && -f "${base}/${session_id}/touched.txt" ]]; then
    # Dedup-on-read: sort -u collapses any duplicate lines that may have landed
    # under concurrent append-only writes (Phase 3a, plans/safe-commit-fixes.md § Phase 3a).
    # LC_ALL=C prevents locale-sensitive collation differences from producing
    # non-deterministic results across environments.
    while IFS= read -r t; do
      [[ -n "$t" ]] && my_touched+=("$t")
    done < <(LC_ALL=C sort -u "${base}/${session_id}/touched.txt")
  fi

  # Issue A: union dispatched-agent touched files into my_touched.
  # Per docs/plans/2026-05-05-issue-a-agent-id-linkage.md (Patrik APPROVED_WITH_NOTES v3).
  # The .agents/<aid>/em-session-id.txt back-pointer makes the read path
  # sentinel-independent — the candidate em-sid set (own session + live siblings
  # via cs_live_session_ids) lets the helper recover from sentinel pollution
  # by an executor's SessionStart overwriting .current-session-id.
  if [[ -n "$base" && -d "${base}/.agents" ]]; then
    declare -A em_candidates
    em_candidates["$session_id"]=1
    while IFS= read -r sid_token; do
      [[ -n "$sid_token" ]] && em_candidates["$sid_token"]=1
    done < <(cs_live_session_ids 2>/dev/null)

    for agent_dir in "${base}/.agents"/*/; do
      [[ -d "$agent_dir" ]] || continue
      local backptr="${agent_dir}em-session-id.txt"
      [[ -f "$backptr" ]] || continue
      local em_sid
      em_sid=$(head -1 "$backptr" 2>/dev/null)
      [[ -z "$em_sid" ]] && continue  # malformed back-pointer; soft-skip
      [[ -v "em_candidates[$em_sid]" ]] || continue

      local agent_touched="${agent_dir}touched.txt"
      [[ -f "$agent_touched" ]] || continue
      while IFS= read -r f; do
        [[ -n "$f" ]] && my_touched+=("$f")
      done < "$agent_touched"
    done
  fi

  # Capture cs_compute_scope output: stdout = my scope, stderr = skip + orphan messages
  local scope_stdout scope_stderr
  tmpout=$(mktemp)
  tmperr=$(mktemp)

  cs_compute_scope "$session_id" > "$tmpout" 2> "$tmperr"

  scope_stdout=$(cat "$tmpout")
  scope_stderr=$(cat "$tmperr")
  rm -f "$tmpout" "$tmperr"
  tmpout=""
  tmperr=""

  # Parse raw scope from cs_compute_scope stdout (may include mtime-added orphans)
  local raw_scope=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && raw_scope+=("$line")
  done <<< "$scope_stdout"

  # Post-filter: separate legitimate scope (in my touched.txt) from mtime-only orphans
  # A file is an mtime-only orphan if:
  #   - cs_compute_scope included it (so no other session claims it)
  #   - it is NOT in my touched.txt
  # Per plan orphan policy: warn only, do NOT stage.
  #
  # Additionally: cs_compute_scope returns files from touched.txt regardless of
  # whether they're currently dirty. Filter my_scope to only dirty files so that
  # clean-but-touched files (likely reverted) don't cause git commit failures.
  local _current_dirty_list=()
  while IFS= read -r _cdf; do
    [[ -n "$_cdf" ]] && _current_dirty_list+=("$_cdf")
  done < <({ git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u)
  declare -A _current_dirty_set
  for _cdf in "${_current_dirty_list[@]:-}"; do
    [[ -n "$_cdf" ]] && _current_dirty_set["$_cdf"]=1
  done

  local my_scope=()
  local mtime_orphans=()
  local _clean_touched=()  # in touched.txt but not dirty (Case C candidates)
  declare -A touched_set
  for t in "${my_touched[@]:-}"; do
    [[ -n "$t" ]] && touched_set["$t"]=1
  done
  for candidate in "${raw_scope[@]:-}"; do
    [[ -z "$candidate" ]] && continue
    if [[ -n "${touched_set[$candidate]+x}" ]]; then
      # In touched.txt — only add to my_scope if actually dirty
      if [[ -v "_current_dirty_set[$candidate]" ]]; then
        my_scope+=("$candidate")
      else
        _clean_touched+=("$candidate")
      fi
    else
      # Not in my touched.txt — treat as mtime-only orphan
      mtime_orphans+=("$candidate")
    fi
  done

  # Parse other-session exclusions from stderr (skipping ... lines)
  local other_excluded_files=()
  while IFS= read -r line; do
    if [[ "$line" == "skipping "* ]]; then
      other_excluded_files+=("$line")
    fi
  done <<< "$scope_stderr"

  # Merge orphans: library-detected ones (from stderr) + mtime-only ones we post-filtered
  # Library stderr emits "orphan: <path>"; collect those too
  local orphan_files=()
  while IFS= read -r line; do
    if [[ "$line" == "orphan: "* ]]; then
      orphan_files+=("${line#orphan: }")
    fi
  done <<< "$scope_stderr"
  # Add mtime-only orphans that the library didn't mark (it thought they were ours)
  if [[ ${#mtime_orphans[@]} -gt 0 ]]; then
    for mto in "${mtime_orphans[@]}"; do
      [[ -n "$mto" ]] || continue
      orphan_files+=("$mto")
      echo "orphan (mtime-only, not in touched.txt): ${mto}" >&2
    done
  fi

  # ---------------------------------------------------------------------------
  # Phase 2: --include-orphans processing
  # Spec backlink: plans/safe-commit-fixes.md § Phase 2 — --include-orphans flag spec.
  # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 5 — combined-mode delegation.
  #
  # _combined_mode=1 means do_scope_from delegated here via _sfm_trap_installed=1.
  # In that case active-scope.txt already exists (written by do_scope_from step 5);
  # we point _active_scope_file at it without re-creating it or installing a second trap.
  # In pure default-mode (_sfm_trap_installed=0), we create active-scope.txt fresh.
  # ---------------------------------------------------------------------------
  if [[ ${#INCLUDE_ORPHANS[@]} -gt 0 ]]; then
    local _combined_mode=0
    # Use the explicit sentinel — greppable > file-presence heuristic (Patrik finding 0).
    if [[ "${_sfm_trap_installed:-0}" -eq 1 ]]; then
      _combined_mode=1
    fi

    if [[ -n "$base" && -n "$session_id" ]]; then
      _active_scope_file="${base}/${session_id}/active-scope.txt"
    fi

    # Pure default-mode: write active-scope.txt for the overlap gate.
    # The consolidated EXIT trap at the top of do_scoped handles cleanup on all exit paths.
    # Trap guards _active_scope_file deletion only when _sfm_trap_installed=0 (see trap above).
    # SIGKILL leaks active-scope.txt; long-tail cleanup via cs_reap_stale at 24h staleness.
    if [[ "$_combined_mode" -eq 0 && -n "$base" && -n "$session_id" ]]; then
      mkdir -p "${base}/${session_id}"
      : > "$_active_scope_file"
    fi

    # Resolve pathspecs to concrete dirty files
    local _orphan_candidate_files=()
    for _ops in "${INCLUDE_ORPHANS[@]}"; do
      # Validate pathspec
      if ! validate_pathspec "$_ops"; then
        echo "ERROR: --include-orphans: malformed or invalid pathspec '${_ops}'" >&2
        exit 1
      fi
      while IFS= read -r _of; do
        [[ -n "$_of" ]] && _orphan_candidate_files+=("$_of")
      done < <(git ls-files -- "$_ops" 2>/dev/null; git ls-files --others --exclude-standard -- "$_ops" 2>/dev/null)
    done

    if [[ ${#_orphan_candidate_files[@]} -eq 0 ]]; then
      echo "WARNING: --include-orphans: no files matched the given pathspec(s): ${INCLUDE_ORPHANS[*]}" >&2
    fi

    # Filter to only dirty files (no point staging clean files as orphans)
    local _dirty_set=()
    while IFS= read -r _ddf; do
      [[ -n "$_ddf" ]] && _dirty_set+=("$_ddf")
    done < <({ git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u)
    declare -A _dirty_map
    for _ddf in "${_dirty_set[@]:-}"; do
      [[ -n "$_ddf" ]] && _dirty_map["$_ddf"]=1
    done

    local _orphan_resolved=()
    for _orf in "${_orphan_candidate_files[@]:-}"; do
      [[ -z "$_orf" ]] && continue
      if [[ -v "_dirty_map[$_orf]" ]]; then
        _orphan_resolved+=("$_orf")
      fi
    done

    # Build union of declared scope (from active-scope.txt if combined-mode) and orphan paths
    # Both must clear the overlap gate before any append succeeds (Patrik R3 #23).
    declare -A _union_scope_set
    if [[ "$_combined_mode" -eq 1 && -f "$_active_scope_file" ]]; then
      while IFS= read -r _usf; do
        [[ -n "$_usf" ]] && _union_scope_set["$_usf"]=1
      done < "$_active_scope_file"
    fi
    for _orf in "${_orphan_resolved[@]:-}"; do
      [[ -n "$_orf" ]] && _union_scope_set["$_orf"]=1
    done

    # Overlap gate + active-scope.txt append under lock (Fix 6): check union against
    # peer sessions and append orphan paths to active-scope.txt atomically so no
    # concurrent session can interleave their check+publish with ours (TOCTOU closure).
    # Lock scope is narrow — released before git add / git commit.
    # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 6 — do_scoped wrap.
    if [[ -n "$base" ]]; then
      _with_overlap_lock _do_scoped_orphan_overlap_check_and_publish \
        "$_active_scope_file" "$base" "$session_id" _orphan_resolved _union_scope_set || exit $?
    fi

    # Write audit log
    if [[ -n "$base" && -n "$session_id" ]]; then
      local _claim_log="${base}/${session_id}/orphan-claims.log"
      {
        echo "=== Claim at $(_cs_now_iso) ==="
        echo "Pathspecs: ${INCLUDE_ORPHANS[*]}"
        echo "Resolved dirty files:"
        printf '  %s\n' "${_orphan_resolved[@]:-}"
        echo ""
      } >> "$_claim_log"
    fi

    _orphan_claimed_paths=("${_orphan_resolved[@]:-}")

    # Remove claimed paths from orphan_files so print_summary doesn't double-list them
    if [[ ${#_orphan_claimed_paths[@]} -gt 0 ]]; then
      declare -A _claimed_set
      for _cp in "${_orphan_claimed_paths[@]}"; do
        [[ -n "$_cp" ]] && _claimed_set["$_cp"]=1
      done
      local _filtered_orphans=()
      for _of in "${orphan_files[@]:-}"; do
        [[ -n "$_of" ]] || continue
        [[ -v "_claimed_set[$_of]" ]] || _filtered_orphans+=("$_of")
      done
      orphan_files=("${_filtered_orphans[@]+"${_filtered_orphans[@]}"}")
    fi
  fi
  # ---------------------------------------------------------------------------
  # End --include-orphans processing
  # ---------------------------------------------------------------------------

  # Dry-run: print and exit without committing
  if [[ "$MODE" == "dry-run" ]]; then
    echo "DRY RUN — would stage ${#my_scope[@]} file(s):" >&2
    for f in "${my_scope[@]:-}"; do echo "  $f" >&2; done
    if [[ ${#_orphan_claimed_paths[@]} -gt 0 ]]; then
      echo "Orphan-claimed (would also stage): ${#_orphan_claimed_paths[@]} file(s):" >&2
      for f in "${_orphan_claimed_paths[@]}"; do echo "  ${f}  (orphan-claimed)" >&2; done
    fi
    if [[ ${#orphan_files[@]} -gt 0 ]]; then
      echo "Orphans (not staged): ${#orphan_files[@]} file(s):" >&2
      for f in "${orphan_files[@]}"; do echo "  $f" >&2; done
    fi
    if [[ ${#other_excluded_files[@]} -gt 0 ]]; then
      echo "Excluded (other-session-owned): ${#other_excluded_files[@]}" >&2
    fi
    echo "(no git add or commit executed)" >&2
    exit 0
  fi

  # Validate we have something to stage — four-case branched diagnosis (Phase 1).
  # Spec backlink: plans/safe-commit-fixes.md § Phase 1 — do_scoped branched error.
  # Cases A/B/C require the session to have resolved (not Case D — "no live session"
  # — which is handled upstream when resolve_session_id returns nothing).
  # Skip the error block if --include-orphans claimed paths to commit (Phase 2):
  # _orphan_claimed_paths being non-empty means we have something to stage even
  # if my_scope is empty.
  if [[ ${#my_scope[@]} -eq 0 && ${#_orphan_claimed_paths[@]} -eq 0 ]]; then
    # Determine working-tree dirty state for diagnosis
    local _dirty_list=()
    while IFS= read -r _df; do
      [[ -n "$_df" ]] && _dirty_list+=("$_df")
    done < <({ git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u)

    local _dirty_count=${#_dirty_list[@]}

    if [[ ${#_clean_touched[@]} -gt 0 ]]; then
      # Case C: touched.txt has entries but those files are clean now (likely reverted).
      # my_scope is empty because all touched files were filtered out as clean.
      echo "NOTE: Edit/Write fired on these path(s), but they are clean now (likely reverted):" >&2
      printf '  %s\n' "${_clean_touched[@]}" >&2
      if [[ ${#orphan_files[@]} -gt 0 ]]; then
        echo "Working tree dirty (unclaimed): ${#orphan_files[@]} file(s):" >&2
        printf '  %s\n' "${orphan_files[@]}" >&2
      fi
      exit 1
    elif [[ ${#my_touched[@]} -eq 0 && "$_dirty_count" -gt 0 ]]; then
      # Case B: sentinel valid, touched.txt empty, dirty tree exists
      # (files touched via Bash/hooks/install-scripts — not tracked by Edit/Write hook)
      echo "ERROR: ${_dirty_count} dirty file(s) but none claimed by this session via Edit/Write." >&2
      echo "These are likely hook-touched or install-script-touched files." >&2
      echo "To stage them, use one of:" >&2
      echo "  coordinator-safe-commit --include-orphans <pathspec>...  (preferred — audited, overlap-checked)" >&2
      echo "  git reset && git add -- <paths> && git commit -m \"<subject>\"  (fallback)" >&2
      echo "Dirty file(s):" >&2
      printf '  %s\n' "${_dirty_list[@]}" >&2
      exit 1
    elif [[ ${#my_touched[@]} -eq 0 && "$_dirty_count" -eq 0 ]]; then
      # Case A: sentinel valid, touched.txt absent/empty, working tree clean
      echo "NOTE: Nothing to commit — no Edit/Write fired this session and the working tree is clean." >&2
      exit 0
    else
      # Case D: session dir genuinely missing (sentinel was stale, PID scan also failed)
      # This should only be reached when session_id resolved to something but its dir
      # was deleted between resolution and here — treat as "no live session".
      echo "ERROR: No live session scope detected. The session directory may have been archived or reaped." >&2
      echo "Fallback: bypass the helper with explicit-path commit:" >&2
      echo "  git add -- <your-paths>" >&2
      echo "  git commit -m \"<subject>\"" >&2
      exit 1
    fi
  fi

  # Stage explicitly using xargs -0 to handle spaces in paths
  if [[ ${#my_scope[@]} -gt 0 ]]; then
    printf '%s\0' "${my_scope[@]}" | xargs -0 git add --
  fi

  # Stage any orphan-claimed files (--include-orphans, Phase 2)
  if [[ ${#_orphan_claimed_paths[@]} -gt 0 ]]; then
    printf '%s\0' "${_orphan_claimed_paths[@]}" | xargs -0 git add --
  fi

  # Sentinel 1: capture HEAD before commit to detect silent no-ops.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 1.
  local _pre_head
  _pre_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")

  # Sentinel 2: wrap commit call so mid-call failures surface as a FAIL line.
  # Spec backlink: plans/2026-05-13-safe-commit-demote-to-sweep.md § Chunk 1 — Sentinel 2.
  if ! git commit -m "$SUBJECT"; then
    local _rc=$?
    echo "FAIL: git commit returned ${_rc} in do_scoped" >&2
    exit 2
  fi

  local _post_head
  _post_head=$(git rev-parse HEAD 2>/dev/null || echo "INITIAL")
  if [[ "$_pre_head" == "$_post_head" ]]; then
    echo "FAIL: helper produced no commit (reason: HEAD unchanged after do_scoped commit attempt)" >&2
    exit 2
  fi

  # Success-path cleanup: remove active-scope.txt so peer sessions do not
  # false-positive on the overlap gate. Called here for both pure default-mode
  # (--include-orphans only) and combined-mode (do_scope_from delegated here).
  # In combined-mode this also clears _sfm_active_scope_file so do_scope_from's
  # EXIT trap guard is a no-op when the function returns normally.
  # Spec backlink: plans/safe-commit-fixes-5-and-6.md § Fix 5 — _cleanup_active_scope.
  if [[ ${#_orphan_claimed_paths[@]} -gt 0 ]]; then
    _cleanup_active_scope
  fi

  # Print structured summary (to stderr so it doesn't pollute capture)
  # Annotate orphan-claimed paths with (orphan-claimed) suffix in the staged list
  local _display_staged_list=()
  for _sf in "${my_scope[@]:-}"; do
    [[ -n "$_sf" ]] && _display_staged_list+=("$_sf")
  done
  if [[ ${#_orphan_claimed_paths[@]} -gt 0 ]]; then
    for _ocf in "${_orphan_claimed_paths[@]}"; do
      [[ -n "$_ocf" ]] && _display_staged_list+=("${_ocf}  (orphan-claimed)")
    done
  fi
  local _total_staged=$(( ${#my_scope[@]} + ${#_orphan_claimed_paths[@]} ))

  print_summary \
    "${_total_staged}" \
    "$(printf '%s\n' "${_display_staged_list[@]+"${_display_staged_list[@]}"}")" \
    "${#orphan_files[@]}" \
    "$(printf '%s\n' "${orphan_files[@]+"${orphan_files[@]}"}")" \
    "${#other_excluded_files[@]}" \
    "$(printf '%s\n' "${other_excluded_files[@]+"${other_excluded_files[@]}"}")"
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

main() {
  # Issue B: --expected-branch deterministic branch-pin gate. Fails-closed
  # before any staging if the active branch doesn't match the expected one.
  # Per docs/plans/2026-05-05-issue-b-expected-branch-flag.md.
  if [[ -n "$EXPECTED_BRANCH" ]]; then
    local _current_branch
    _current_branch=$(git branch --show-current 2>/dev/null)
    # Case-insensitive compare: HEAD's stored case may differ from the on-disk
    # canonical case on Windows (.git/HEAD literal vs ref-file). Both forms
    # describe the same branch — compare case-insensitively. (lessons.md:3,
    # 2026-05-07 HTTPS-autopush case-mismatch.)
    if [[ "${_current_branch,,}" != "${EXPECTED_BRANCH,,}" ]]; then
      echo "ERROR: branch mismatch — current is '${_current_branch:-<detached>}', expected '${EXPECTED_BRANCH}'." >&2
      echo "Reflog (current branch):" >&2
      if [[ -n "$_current_branch" ]]; then
        git reflog "$_current_branch" -3 2>/dev/null | sed 's/^/  /' >&2 || true
      fi
      echo "Reflog (expected branch):" >&2
      git reflog "$EXPECTED_BRANCH" -3 2>/dev/null | sed 's/^/  /' >&2 || true
      echo "Resolution: 'git checkout ${EXPECTED_BRANCH}' or correct the dispatch prompt's expected_branch." >&2
      exit 1
    fi
  fi

  # Resolve session ID (needed for all modes except dry-run of blanket)
  local session_id=""

  if [[ "$MODE" != "blanket" ]]; then
    # For non-blanket modes we always need a session ID
    if ! session_id=$(resolve_session_id); then
      # Error already printed by resolve_session_id
      exit 1
    fi
    if [[ -z "$session_id" ]]; then
      echo "ERROR: Could not resolve session ID." >&2
      exit 1
    fi
  else
    # For blanket mode, try to resolve for logging purposes, but don't fail if absent
    session_id=$(resolve_session_id 2>/dev/null) || session_id=""
  fi

  # COORDINATOR_OVERRIDE_SCOPE=1 intercepts default mode only
  if [[ "${COORDINATOR_OVERRIDE_SCOPE:-}" == "1" && "$MODE" == "default" ]]; then
    do_override "$session_id"
    exit 0
  fi

  case "$MODE" in
    blanket)
      do_blanket "$session_id"
      ;;
    scope-from)
      do_scope_from "$session_id"
      ;;
    dry-run)
      do_scoped "$session_id"
      ;;
    default)
      do_scoped "$session_id"
      ;;
    *)
      echo "ERROR: Unknown mode: ${MODE}" >&2
      exit 1
      ;;
  esac
}

main "$@"
