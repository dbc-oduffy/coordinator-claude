# ~/.claude/machine-local/registry.toml  (TRACKED — shared baseline)
#
# Spec backlink: docs/plans/2026-05-19-machine-local-registry.md §4.2
#
# HAND-EDIT CAUTION — this file is git-tracked and shared across machines.
# Do NOT add machine-specific absolute paths here; they belong in registry.local.toml.
# Use `machine-local set <key> <value>` for per-machine values (writes to .local.toml).
# Direct edits to this file should be key DECLARATIONS (empty string values) or
# values that are truly identical on every machine you work from.
# If an EM or executor told you to add a path here, that is a bug — file it.
#
# Copy this file to registry.toml and fill in values for your machine.
# Values that differ per-machine go in registry.local.toml (gitignored).
# Single-machine operators can put all values here and skip the .local layer.

# Schema version. Bump on breaking key/format changes; readers warn on unknown.
schema = 1

# ---------------------------------------------------------------------------
# Cross-repo discovery — PRIMARY USE CASE.
#
# Key DECLARATIONS go here (tracked). Per-machine VALUES go in registry.local.toml.
# Single-machine operators can put values here directly and skip the .local layer.
#
# These keys replace the sibling-layout convention (../<sibling-repo>/) for
# triangular or multi-drive setups where a single shared parent folder is not
# feasible. See docs/wiki/machine-local-registry.md for the preference order.
# ---------------------------------------------------------------------------
"repos.coordinator_claude"     = ""
"repos.project_rag"            = ""
"repos.project_rag_ue_addon"   = ""
"repos.claude_unreal_holodeck" = ""

# ---------------------------------------------------------------------------
# Vendor / engine roots — place here ONLY if no concern file is loaded.
#
# If `unreal` is listed in `concerns` below, put unreal.* keys in unreal.toml
# instead. The unreal namespace is owned exclusively by the concern file when
# loaded — duplicating keys here causes confusing silent-shadowing.
#
# Uncomment if you are NOT using a concern file for these namespaces:
# "cuda.toolkit_root" = ""
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# publish.sh target registry (migrated from setup/publish-targets.sh).
#
# Array of pipe-separated rows. Two tuple shapes are supported:
#
#   Legacy 4-field:   "<plugin-name>|<mode>|<source-path>|<dest-path>"
#   Extended 5-field: "<plugin-name>|<mode>|<source-path>|<dest-path>|<native_slugs>"
#
# native_slugs (optional 5th field): comma-separated list of marketplace
# slugs that are EXPECTED in this target's content. publish.sh's personal-
# data audit treats these as expected matches instead of REVIEW hits. Use
# for publish targets whose published content naturally mentions another
# marketplace identity (e.g. a target shipping a marketplace-flavored plugin
# where the marketplace slug is part of the public identity).
#
# Uncomment and populate when you're ready to migrate from publish-targets.sh.
# Leaving this key absent (commented out) lets _load_targets fall through to
# the publish-targets.sh deprecation fallback.  Setting it to [] (empty array)
# is treated the same as absent — both fall through.
#
# Review: code-reviewer (F8) — empty-array default was misleading; operator
# copying the example as-is would get a silent empty-array path with no targets.
# "publish.targets" = []
# "publish.targets" = [
#   "coordinator-claude|mirror|/path/to/source/plugins/coordinator-claude|/path/to/coordinator-claude/plugins",
#   "example-target|manifest|/path/to/source/plugins/example-plugin|/path/to/example-publish-repo|your-marketplace-slug",
# ]

# ---------------------------------------------------------------------------
# Concern files.
#
# List concern names here so the reader knows to load them. When a concern is
# listed, that concern's namespace (e.g. "unreal.*") is owned exclusively by
# the concern file. Keys with the concern's prefix in registry.toml emit a
# warning and are ignored — the concern file wins.
#
# Only add a concern file for surfaces large enough to warrant isolation
# (>5 keys, or version-multiplexed values like Unreal 5.4/5.5/5.6).
# For simpler cases, inline the keys directly above.
#
# Uncomment and extend as needed:
# concerns = ["unreal", "cuda"]
concerns = ["project_rag", "unreal"]
# ---------------------------------------------------------------------------
