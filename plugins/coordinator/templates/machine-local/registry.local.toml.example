# ~/.claude/machine-local/registry.local.toml  (GITIGNORED — per-machine overrides)
#
# Spec backlink: docs/plans/2026-05-19-machine-local-registry.md §4.2
#
# This file holds your machine's actual values for keys DECLARED in registry.toml.
# It is gitignored — never committed. Each machine has its own copy.
#
# On Striker, repos.coordinator_claude might be "X:/coordinator-claude".
# On a Mac, the same key might be "~/work/coordinator-claude".
# Same key, different machine value, no merge conflicts.
#
# Single-machine operators: skip this file entirely and put values in registry.toml.
# The .local layer is opt-in for multi-machine setups.

schema = 1

# ---------------------------------------------------------------------------
# Per-machine repo paths.
# Uncomment and set the paths that exist on THIS machine.
# ---------------------------------------------------------------------------
# "repos.coordinator_claude"     = "X:/coordinator-claude"
# "repos.project_rag"            = "X:/project-rag"
# "repos.project_rag_ue_addon"   = "X:/project-rag-ue-addon"
# "repos.claude_unreal_holodeck" = "X:/claude-unreal-holodeck"

# ---------------------------------------------------------------------------
# Per-machine vendor / engine roots (if not using concern files).
# ---------------------------------------------------------------------------
# "cuda.toolkit_root" = "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4"
