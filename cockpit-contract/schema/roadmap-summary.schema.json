{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "description": "Owner-qualified repo identity: '<owner>/<repo>'. Owner carries the producing repo's own casing (producer-authoritative — there is no independent casing authority); no '.git' suffix. Consumers must not assume pre-normalization: normalizing to lower(owner)/lower(repo) for join, dedup, or storage keying is conformant. See DR-022. This owner-qualified string is the canonical cross-entity join anchor."
    },
    "coordinator_root_path": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "blocked",
        "shipped",
        "archived"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "github_graphql",
            "github_rest",
            "git_commit",
            "local_fs",
            "coordinator_artifact",
            "transcript_summary",
            "sec_edgar",
            "code_comparison"
          ]
        },
        "repo": {
          "type": "string",
          "description": "Owner-qualified repo identity: '<owner>/<repo>'. Owner carries the producing repo's own casing (producer-authoritative — there is no independent casing authority); no '.git' suffix. Consumers must not assume pre-normalization: normalizing to lower(owner)/lower(repo) for join, dedup, or storage keying is conformant. See DR-022. This owner-qualified string is the canonical cross-entity join anchor. repo: '' means the fact is NOT repo-anchored — see entity_anchor (entity-first claims with no repo to join on)."
        },
        "ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string"
                },
                "sha": {
                  "type": "string"
                }
              },
              "required": [
                "branch",
                "sha"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "derivation": {
          "type": "string",
          "enum": [
            "raw",
            "parsed",
            "rolled_up",
            "computed",
            "synthesized"
          ]
        },
        "entity_anchor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_kind",
        "repo",
        "ref",
        "path",
        "observed_at",
        "derivation",
        "entity_anchor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "github_graphql",
                  "github_rest",
                  "git_commit"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "local_fs",
                  "coordinator_artifact",
                  "transcript_summary",
                  "sec_edgar",
                  "code_comparison"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "repo": {
                "const": ""
              }
            },
            "required": [
              "repo"
            ]
          },
          "then": {
            "properties": {
              "entity_anchor": {
                "type": "object",
                "properties": {
                  "value": {
                    "not": {
                      "const": ""
                    }
                  }
                },
                "required": [
                  "kind",
                  "value"
                ]
              }
            },
            "required": [
              "entity_anchor"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "entity_anchor": {
                "type": "object"
              }
            },
            "required": [
              "entity_anchor"
            ]
          },
          "then": {
            "properties": {
              "entity_anchor": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": ""
                    }
                  },
                  "value": {
                    "not": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "horizon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "roadmap_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stub_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "blocks": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_by": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "deliverable_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "initiative": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "caption": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_meaningful_activity": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workstream_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "roadmap",
            "infra",
            "bug",
            "docs",
            "research",
            "refactor",
            "uncategorized",
            "queue-derived-baton"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "shipped_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "deliverable_status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "proposed",
            "planned",
            "in-progress",
            "in-review",
            "shipped",
            "abandoned"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "roll_up": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "number"
            },
            "by_status": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "pct_shipped": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "total",
            "by_status",
            "pct_shipped"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "critical_path": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scan_incomplete": {
      "type": "boolean"
    },
    "scan_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_hash": {
      "type": "object",
      "properties": {
        "algo": {
          "type": "string",
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 over the raw bytes of the whole source artifact at `source_path` — file-granular. This is a CHANGE-SIGNAL for consumer cache-invalidation on `(source_path, hex)`, NOT a record identity. See DECISIONS.md § D32."
        },
        "source_path": {
          "type": "string"
        }
      },
      "required": [
        "algo",
        "hex",
        "source_path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "repo",
    "coordinator_root_path",
    "path",
    "title",
    "created",
    "status",
    "provenance",
    "owner",
    "horizon",
    "roadmap_id",
    "stub_id",
    "items",
    "blocks",
    "blocked_by",
    "purpose",
    "deliverable_id",
    "initiative",
    "caption",
    "status_reason",
    "last_meaningful_activity",
    "workstream_type",
    "shipped_sha",
    "deliverable_status",
    "roll_up",
    "critical_path",
    "scan_incomplete",
    "scan_errors"
  ],
  "additionalProperties": false,
  "version": "4.5.0"
}
