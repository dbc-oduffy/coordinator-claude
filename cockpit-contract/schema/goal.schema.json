{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "repo": {
      "type": "string",
      "description": "Owner-qualified repo identity: '<owner>/<repo>'. Owner carries the producing repo's own casing (producer-authoritative — there is no independent casing authority); no '.git' suffix. Consumers must not assume pre-normalization: normalizing to lower(owner)/lower(repo) for join, dedup, or storage keying is conformant. See DR-022. This owner-qualified string is the canonical cross-entity join anchor. Empty string '' is the cross-repo-aggregate sentinel."
    },
    "coordinator_root_path": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "repo",
        "quarter",
        "year"
      ]
    },
    "period_value": {
      "type": "string"
    },
    "declared_by_machine": {
      "type": "string"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "done",
        "superseded",
        "dropped"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "github_graphql",
            "github_rest",
            "git_commit",
            "local_fs",
            "coordinator_artifact",
            "transcript_summary",
            "sec_edgar",
            "code_comparison"
          ]
        },
        "repo": {
          "type": "string",
          "description": "Owner-qualified repo identity: '<owner>/<repo>'. Owner carries the producing repo's own casing (producer-authoritative — there is no independent casing authority); no '.git' suffix. Consumers must not assume pre-normalization: normalizing to lower(owner)/lower(repo) for join, dedup, or storage keying is conformant. See DR-022. This owner-qualified string is the canonical cross-entity join anchor. repo: '' means the fact is NOT repo-anchored — see entity_anchor (entity-first claims with no repo to join on)."
        },
        "ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string"
                },
                "sha": {
                  "type": "string"
                }
              },
              "required": [
                "branch",
                "sha"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "derivation": {
          "type": "string",
          "enum": [
            "raw",
            "parsed",
            "rolled_up",
            "computed",
            "synthesized"
          ]
        },
        "entity_anchor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_kind",
        "repo",
        "ref",
        "path",
        "observed_at",
        "derivation",
        "entity_anchor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "github_graphql",
                  "github_rest",
                  "git_commit"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "local_fs",
                  "coordinator_artifact",
                  "transcript_summary",
                  "sec_edgar",
                  "code_comparison"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "repo": {
                "const": ""
              }
            },
            "required": [
              "repo"
            ]
          },
          "then": {
            "properties": {
              "entity_anchor": {
                "type": "object",
                "properties": {
                  "value": {
                    "not": {
                      "const": ""
                    }
                  }
                },
                "required": [
                  "kind",
                  "value"
                ]
              }
            },
            "required": [
              "entity_anchor"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "entity_anchor": {
                "type": "object"
              }
            },
            "required": [
              "entity_anchor"
            ]
          },
          "then": {
            "properties": {
              "entity_anchor": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": ""
                    }
                  },
                  "value": {
                    "not": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "content_hash": {
      "type": "object",
      "properties": {
        "algo": {
          "type": "string",
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 over the raw bytes of the whole source artifact at `source_path` — file-granular. This is a CHANGE-SIGNAL for consumer cache-invalidation on `(source_path, hex)`, NOT a record identity. See DECISIONS.md § D32."
        },
        "source_path": {
          "type": "string"
        }
      },
      "required": [
        "algo",
        "hex",
        "source_path"
      ],
      "additionalProperties": false
    },
    "weekly_perceptible": {
      "type": "boolean"
    },
    "parent_goal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "key_results_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "goal_id",
    "repo",
    "coordinator_root_path",
    "period",
    "period_value",
    "declared_by_machine",
    "declared_at",
    "text",
    "status",
    "provenance",
    "parent_goal_id"
  ],
  "additionalProperties": false,
  "version": "4.5.0"
}
