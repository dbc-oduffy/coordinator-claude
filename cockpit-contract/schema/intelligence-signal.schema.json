{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "description": "Owner-qualified repo identity: '<owner>/<repo>'. Owner carries the producing repo's own casing (producer-authoritative — there is no independent casing authority); no '.git' suffix. Consumers must not assume pre-normalization: normalizing to lower(owner)/lower(repo) for join, dedup, or storage keying is conformant. See DR-022. This owner-qualified string is the canonical cross-entity join anchor. Or \"\" for an entity-first fact (see provenance.entity_anchor)."
    },
    "coordinator_root_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "signal_id": {
      "type": "string"
    },
    "bucket": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "github_graphql",
            "github_rest",
            "git_commit",
            "local_fs",
            "coordinator_artifact",
            "transcript_summary",
            "sec_edgar",
            "code_comparison"
          ]
        },
        "repo": {
          "type": "string",
          "description": "Owner-qualified repo identity: '<owner>/<repo>'. Owner carries the producing repo's own casing (producer-authoritative — there is no independent casing authority); no '.git' suffix. Consumers must not assume pre-normalization: normalizing to lower(owner)/lower(repo) for join, dedup, or storage keying is conformant. See DR-022. This owner-qualified string is the canonical cross-entity join anchor. repo: '' means the fact is NOT repo-anchored — see entity_anchor (entity-first claims with no repo to join on)."
        },
        "ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string"
                },
                "sha": {
                  "type": "string"
                }
              },
              "required": [
                "branch",
                "sha"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "derivation": {
          "type": "string",
          "enum": [
            "raw",
            "parsed",
            "rolled_up",
            "computed",
            "synthesized"
          ]
        },
        "entity_anchor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_kind",
        "repo",
        "ref",
        "path",
        "observed_at",
        "derivation",
        "entity_anchor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "github_graphql",
                  "github_rest",
                  "git_commit"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "local_fs",
                  "coordinator_artifact",
                  "transcript_summary",
                  "sec_edgar",
                  "code_comparison"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "repo": {
                "const": ""
              }
            },
            "required": [
              "repo"
            ]
          },
          "then": {
            "properties": {
              "entity_anchor": {
                "type": "object",
                "properties": {
                  "value": {
                    "not": {
                      "const": ""
                    }
                  }
                },
                "required": [
                  "kind",
                  "value"
                ]
              }
            },
            "required": [
              "entity_anchor"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "entity_anchor": {
                "type": "object"
              }
            },
            "required": [
              "entity_anchor"
            ]
          },
          "then": {
            "properties": {
              "entity_anchor": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": ""
                    }
                  },
                  "value": {
                    "not": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "mention_count": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sentiment_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_window": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "display_order": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "sha256 hex of the backing ledger claim's canonical body — the projection-render join anchor (project-rag fleet identity). Nullable on the shared contract; example-market-data-repo enforces non-null producer-side per cgs-03. Bare scalar join key (join on equality) — deliberately NOT the structured ContentHash provenance shape."
    },
    "claim_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Informational: project-rag producer-local surrogate id. NOT a fleet-stable join key — join on content_key, never on this."
    },
    "coverage_scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Reachable surfaces actually sampled for this signal, as a set (e.g. ['youtube','press']) — the coverage-bias qualifier for sentiment_score. Array, not a flattened string: consumers do surface-membership queries."
    },
    "sampling_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Engagement-weighted / not-a-population-estimate qualifier for the coverage-bias objectivity spine."
    },
    "market_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "OPEN STRING market-scope descriptor (e.g. subject_repo | market_category | peer). This is a signal-level descriptor and is explicitly NOT the D25/EmissionScope `scope` discriminant — it MUST be excluded from any future corpus-wide scope-conformance mechanism (see DD-2 latent-gap note)."
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scalar point-estimate confidence for the signal."
    },
    "confidence_interval": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Confidence band as an ordered [lo, hi] numeric tuple in [0,1] around the scalar `confidence` point-estimate — NOT an interval around sentiment_score. Present-as-null. Wire shape confirmed by example-market-data-repo + cockpit 2026-07-14 (see D30)."
    },
    "measurement_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "OPEN STRING measurement provenance (e.g. structured_source | llm_extracted | human_verified | judge_panel — documented, not frozen; per docs/decisions/2026-07-14-reference-only-citation-emission-surface.md)."
    }
  },
  "required": [
    "repo",
    "coordinator_root_path",
    "signal_id",
    "bucket",
    "label",
    "observed_at",
    "provenance",
    "mention_count",
    "sentiment_score",
    "source_refs",
    "observed_window",
    "display_order",
    "content_key",
    "claim_id",
    "coverage_scope",
    "sampling_basis",
    "market_scope",
    "confidence",
    "confidence_interval",
    "measurement_basis"
  ],
  "additionalProperties": false,
  "version": "4.5.0"
}
