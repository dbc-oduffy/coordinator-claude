# .percolate-ignore — paths under this source plugin that should NOT publish.
# gitignore-shaped: directories with trailing /, file globs without.
# '**/' is not supported — multi-depth matches need explicit listing.
# Audited by /percolate Branch 0 on 2026-06-02 against
# ~/.claude/plugins/coordinator-claude/deep-research/. Tree is clean;
# all entries below are prophylactic (no current leaks).

# --- Authoring scratch ---
_archived/
scratch/
*.bak
*.tmp

# --- Editor / OS detritus ---
*.swp
*.swo
*~
*.orig
*.rej
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- Python build artifacts ---
__pycache__/
*.pyc
.pytest_cache/

# --- Node / JS build artifacts ---
node_modules/
coverage/
.nyc_output/

# --- Logs / temp output ---
*.log
htmlcov/
