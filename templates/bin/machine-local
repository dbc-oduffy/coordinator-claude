#!/usr/bin/env python3
# machine-local — thin forwarder for the machine-local registry reader.
#
# Spec backlink: docs/plans/2026-05-19-machine-local-registry.md §4.3
# Purpose: delegate all subcommands to _machine_local.py, resolving a Python
# interpreter portably. Users call this forwarder; _machine_local.py is the
# implementation and is intentionally underscore-prefixed to discourage direct
# invocation.
#
# LOCATION-INDEPENDENT FORWARDER: resolves _machine_local.py via the coordinator
# settings-home seam, so this script works correctly whether installed at
# <settings-home>/bin/machine-local (primary) or ~/.claude/bin/machine-local
# (transitional compat forwarder during the settings-home migration window).
# _real= target: COORDINATOR_SETTINGS_HOME -> ${CLAUDE_HOME:-$HOME}/.coordinator-claude-settings
# Spec backlink: docs/plans/2026-07-06-durable-substrate-to-settings-home.md § C4 -- _real= target
#
# EXTENSIONLESS ENTRYPOINT, PYTHON SHEBANG: this file keeps its installed name
# (`machine-local`, no extension) verbatim -- callers resolve it by that exact
# name (PATH lookup, co-located-file fallback, shutil.which()). Only the
# implementation language changed (bash -> python3); the on-disk name and the
# subprocess-exec contract are unchanged. Ported 2026-07-22 per the
# structural-bash-to-naked-Python campaign (coordinator.local.md).
#
# PORTABILITY: this forwarder can itself be launched under an interpreter that
# predates its own >=3.11 guard-check target (the shebang's `env python3` picks
# whatever `python3` resolves first on the caller's PATH, which under a stripped
# PATH or an old macOS system Python can be < 3.11). That is fine: everything
# below is plain, version-agnostic stdlib code (no 3.11+ syntax) -- its only job
# is to probe for a >=3.11 interpreter and exec _machine_local.py under it. The
# impl script is the one that actually requires >=3.11 and enforces it itself.

import os
import shutil
import subprocess
import sys

# Name of the interpreter-resolution cache written beside the impl. One line, one
# absolute interpreter path. See _cached_python / _cache_python below.
_PYTHON_CACHE_BASENAME = ".python-bin"


def _real_settings_bin() -> str:
    settings_home = os.environ.get("COORDINATOR_SETTINGS_HOME")
    if not settings_home:
        home = os.environ.get("CLAUDE_HOME") or os.environ.get("HOME") or os.environ.get("USERPROFILE") or ""
        settings_home = os.path.join(home, ".coordinator-claude-settings")
    return os.path.join(settings_home, "bin")


def _py311_ok(candidate: str) -> bool:
    try:
        result = subprocess.run(
            [candidate, "-c", "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return False
    return result.returncode == 0


#: Returned by _run_impl_in_process when the impl could not be LOADED, so the caller
#: can re-run it as a subprocess. A distinct sentinel and not None: `main()` returns
#: whatever its verb handler returned, and a handler that falls off the end returns
#: None implicitly. Overloading None would make that indistinguishable from a load
#: failure and re-run the WHOLE command in a subprocess -- executing a `set`/`unset`/
#: `array-*` mutation twice, silently, on a fast path built to be invisible.
_LOAD_FAILED = object()


def _run_impl_in_process(impl):
    """Run _machine_local.py inside THIS interpreter; return its rc, or _LOAD_FAILED.

    Callable only when the running interpreter already satisfies the impl's >=3.11
    guard — the caller checks. Loads the impl by absolute path rather than by module
    name so nothing depends on sys.path, and does not leave it in sys.modules under a
    name another importer could collide with (the dual-identity hazard that
    machine-local-registry.md §8(a) names).

    A SystemExit raised by the impl — its version guard, its argparse, its own verb
    returns — is the impl's exit code and is returned as such. Returning _LOAD_FAILED
    means the impl could not be LOADED at all (unreadable, truncated, syntactically
    broken mid-install); the caller then re-runs it as a subprocess so the operator
    sees the impl's real diagnostics instead of this forwarder's import traceback.
    A handler that returns a non-int (including an implicit None) is a RAN result,
    never a load failure, and is normalised to 0 here rather than re-run.

    Negative-spec: exceptions from the impl's own execution are NOT swallowed here.
    Only load failure falls back — a genuine impl bug must surface as a traceback, not
    be silently retried in a second process that will fail the same way.
    """
    import importlib.util

    try:
        spec = importlib.util.spec_from_file_location("_machine_local_impl", impl)
        if spec is None or spec.loader is None:
            return _LOAD_FAILED
        module = importlib.util.module_from_spec(spec)
    except (OSError, ImportError, ValueError):
        return _LOAD_FAILED

    try:
        spec.loader.exec_module(module)
    except SystemExit as exc:  # module-level version guard
        return exc.code if isinstance(exc.code, int) else 2
    except (OSError, SyntaxError, ImportError):
        return _LOAD_FAILED

    # Past this point the impl HAS run. Every return below is its result, never a
    # fallback signal -- re-running it in a subprocess here would repeat whatever
    # it already did.
    try:
        rc = module.main()
    except SystemExit as exc:
        rc = exc.code
    return rc if isinstance(rc, int) else 0


def _cached_python(bin_dir: str) -> str:
    """Return the previously-resolved interpreter path, or "" if unusable.

    The probe below costs up to six `python -c` SPAWNS to answer a question whose
    answer changes only when the operator installs or removes a Python. Caching it
    turns that into one file read. A cache entry naming an interpreter that no
    longer exists is simply ignored — the probe re-runs and rewrites it — so an
    uninstalled or moved Python self-heals rather than wedging the reader.

    Negative-spec: the cached path is NOT re-version-checked here. Re-probing to
    validate the cache would reintroduce the spawn the cache exists to remove. An
    interpreter downgraded BELOW 3.11 in place (same path, older version) is
    therefore possible, and lands on _machine_local.py's own version guard, which
    exits 2 with an actionable message — the same place the documented last-resort
    fallback below already lands. Correctness is preserved; only the diagnosis is
    one hop later.
    """
    try:
        with open(os.path.join(bin_dir, _PYTHON_CACHE_BASENAME)) as fh:
            candidate = fh.read().strip()
    except OSError:
        return ""
    return candidate if candidate and os.path.isfile(candidate) else ""


def _cache_python(bin_dir: str, python: str) -> None:
    """Record a freshly-probed interpreter path for the next invocation.

    Best-effort by contract: a read-only or unwritable settings-home must cost the
    caller a slow resolve, never a failed read. Written via tempfile + os.replace so
    a concurrent reader sees either the old entry or the new one, never a torn line —
    this machine routinely runs a dozen sessions that would otherwise interleave here.
    """
    target = os.path.join(bin_dir, _PYTHON_CACHE_BASENAME)
    tmp = "{}.{}.tmp".format(target, os.getpid())
    try:
        with open(tmp, "w") as fh:
            fh.write(python + "\n")
        os.replace(tmp, target)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def main() -> int:
    _real = _real_settings_bin()
    impl = os.path.join(_real, "_machine_local.py")

    if not os.path.isfile(impl):
        settings_home = _real[: -len("/bin")] if _real.endswith("/bin") else _real
        sys.stderr.write(f"machine-local: implementation not found at {impl}\n")
        sys.stderr.write(f"  Settings home: {settings_home}\n")
        sys.stderr.write(
            "  Remediation: re-run coordinator:install to seed the settings-home bin/ family.\n"
        )
        return 2  # operational failure (see _machine_local.py exit-code contract)

    # FAST PATH: this forwarder is itself Python. When the interpreter already
    # running it satisfies the impl's >=3.11 guard, there is nothing to resolve and
    # nothing to exec -- run the impl in-process and the whole invocation costs ONE
    # process instead of two-plus-probes. This is the common case on every machine
    # whose `python3` is current, which is every supported install: the probe ladder
    # below exists for the stripped-PATH/old-system-Python case (macOS 3.9), not for
    # the healthy one, and healthy callers should not pay for it.
    #
    # An explicit MACHINE_LOCAL_PYTHON is an operator instruction to run the impl
    # under THAT interpreter, so it outranks this path and falls through to the exec.
    if sys.version_info >= (3, 11) and not os.environ.get("MACHINE_LOCAL_PYTHON"):
        rc = _run_impl_in_process(impl)
        if rc is not _LOAD_FAILED:
            return rc
        # Import failed for a reason unrelated to the impl's own logic (a partially
        # written file, an unreadable path). Fall through to the spawn ladder so the
        # operator gets the impl's real error rather than an import traceback.

    # Resolve a Python interpreter that satisfies _machine_local.py's >=3.11
    # guard. Naively taking the first `python3` on PATH is a footgun: under a
    # stripped PATH (e.g. a daemon launched with PATH=/usr/bin:/bin) `python3`
    # resolves to macOS system Python 3.9, which trips the impl's version
    # guard and exits operational-fail -- indistinguishable downstream from a
    # genuinely-absent key. Probe candidates and pick the first that is
    # >=3.11 so the forwarder self-heals for ANY caller regardless of
    # inherited PATH. Cross-repo memo 2026-06-24 (daemon read-path).
    #
    # The probe's up-to-six spawns run only on a cache miss (_cached_python).
    python = os.environ.get("MACHINE_LOCAL_PYTHON") or _cached_python(_real)

    if not python:
        # Version-pinned names first (most likely >=3.11 even under a
        # stripped PATH that only carries an old generic python3), then the
        # generics (catch a new-enough python3/python whatever its minor
        # version, future-proofing past this list). Worst case ~6 probe
        # spawns before the real exec; MACHINE_LOCAL_PYTHON skips it.
        for cand in ("python3.14", "python3.13", "python3.12", "python3.11", "python3", "python"):
            resolved = shutil.which(cand)
            if resolved and _py311_ok(resolved):
                python = resolved
                _cache_python(_real, python)
                break

    if not python:
        # No >=3.11 interpreter found. Exec the first available python
        # anyway so the impl's own version guard emits its actionable
        # remediation (and the operational exit code), rather than dying
        # here with a vaguer message.
        for cand in ("python3", "python"):
            resolved = shutil.which(cand)
            if resolved:
                python = resolved
                break

    if not python:
        sys.stderr.write("machine-local: no python3 (or python) found on PATH\n")
        return 2  # operational failure (see _machine_local.py exit-code contract)

    argv = [python, impl] + sys.argv[1:]

    if os.name == "nt":
        # Windows has no true exec(): the CRT underlying os.execvp() SPAWNS a
        # new process and this parent returns/terminates immediately instead
        # of being replaced. That races the invoking shell's wait against the
        # grandchild's stdout flush -- `machine-local get <key> > file` can
        # observe a 0-byte file at a clean exit code, indistinguishable from
        # a genuinely-absent key (the file is correct moments later). Measured
        # on a live Windows box: cross-repo/archive/2026-08-07-claude-klabauter-
        # em-hook-console-allocation-ledger.md, Defect B. subprocess.run()
        # blocks this parent until the child exits, so its output is always
        # fully flushed before we return -- at the cost of a second process,
        # acceptable here since this leg is Windows-only.
        try:
            result = subprocess.run(argv)
        except OSError as exc:
            sys.stderr.write(f"machine-local: failed to spawn {python}: {exc}\n")
            return 2
        except KeyboardInterrupt:
            # Covers a Ctrl-C during child dispatch only, not the interpreter
            # probe above -- a SIGINT there still raises uncaught on both legs.
            return 130  # conventional SIGINT rc
        return result.returncode

    try:
        os.execvp(python, argv)
    except OSError as exc:
        sys.stderr.write(f"machine-local: failed to exec {python}: {exc}\n")
        return 2

    return 0  # unreachable on POSIX — execvp replaces this process on success


if __name__ == "__main__":
    sys.exit(main())
