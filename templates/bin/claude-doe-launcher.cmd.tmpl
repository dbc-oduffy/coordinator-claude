@echo off
setlocal enabledelayedexpansion
rem ---------------------------------------------------------------------------
rem claude-doe.cmd - first-class Windows launcher for the coordinator plugin.
rem
rem Generated by coordinator gen-claude-doe-launcher.py -- edit the template, not
rem this rendered copy.
rem   Template:   <DoE>/coordinator/templates/bin/claude-doe-launcher.cmd.tmpl
rem   Regenerate: <DoE>/coordinator/bin/gen-claude-doe-launcher.py
rem
rem Spec backlink: tasks/2026-07-14-install-dogfood-friction.md par F5 -- the
rem canonical launch surface `claude-doe` is a POSIX bash script. Git-for-Windows'
rem usr\bin (bash + the coreutils claude-doe needs: mktemp/grep/sha256sum) and
rem %USERPROFILE%\bin (jq, used by gen-settings-hooks on every launch) are NOT on
rem the Windows PATH, so `claude-doe` / `bash` / `jq` are not bare-invocable from
rem cmd/PowerShell/Windows Terminal. This launcher discovers the Git-for-Windows
rem install root at RUNTIME (no hardcoded path -- the hand-made stopgap this
rem replaces hardcoded "C:\Program Files\Git" <!-- foreign-path-ok: names the removed stopgap, not a real machine path -->, which breaks on a non-default
rem Git install location), prepends its shell bins to PATH, then execs the POSIX
rem wrapper. cwd is preserved (non-login shell) so claude starts in the current
rem directory.
rem
rem Git-for-Windows discovery order (first hit wins):
rem   1. `where git` -- resolves whatever git.exe is actually on THIS machine's
rem      PATH (handles custom install drives/locations, portable installs, etc).
rem      git.exe normally lives at <GitRoot>\cmd\git.exe or <GitRoot>\bin\git.exe;
rem      GitRoot is git.exe's grandparent directory in either shape.
rem   2. Common install locations, checked in order: %ProgramFiles%\Git,
rem      %ProgramFiles(x86)%\Git, %LocalAppData%\Programs\Git.
rem   3. Fail loud with remediation (do NOT silently guess and launch a broken
rem      bash -- see coordinator doctrine "detect-then-silently-pick is a
rem      footgun").
rem ---------------------------------------------------------------------------

set "GITROOT="

rem cmd.exe parses a parenthesized block by scanning for the matching ")" BEFORE
rem expanding variables, so a literal ")" inside such a block terminates it early.
rem "%ProgramFiles(x86)%" therefore cannot be referenced inside an if-block: the
rem ")" in "(x86)" closes the block and cmd dies with
rem   "%\Git was unexpected at this time."
rem which breaks EVERY launch. Hoist it into a paren-free variable out here, and
rem use that inside the blocks below. (Delayed expansion does not save you --
rem the block-termination happens at parse time.)
set "PF_X86=%ProgramFiles(x86)%"

rem --- Discovery 1: where git (first match on PATH) ---
rem Review: code-reviewer (Finding 1) -- a GITROOT hit here must be validated
rem (bin\bash.exe present) before it's locked in, or an unvalidated hit
rem forever blocks Discovery-2 (both gated on "if not defined GITROOT") --
rem matching Resolve-GitRoot's Test-Path check in the .ps1 sibling.
for /f "delims=" %%G in ('where git 2^>nul') do (
  if not defined GITROOT (
    set "GITEXE=%%G"
    for %%P in ("!GITEXE!") do set "GITEXEDIR=%%~dpP"
    rem GITEXEDIR is <GitRoot>\cmd\ or <GitRoot>\bin\ (trailing backslash) --
    rem strip the trailing slash then go up one level to GitRoot.
    for %%P in ("!GITEXEDIR:~0,-1!") do set "GITROOT=%%~dpP"
    for %%P in ("!GITROOT:~0,-1!") do set "GITROOT=%%~fP"
    if not exist "!GITROOT!\bin\bash.exe" set "GITROOT="
  )
)

rem --- Discovery 2: common install locations ---
if not defined GITROOT (
  if exist "%ProgramFiles%\Git\bin\bash.exe" set "GITROOT=%ProgramFiles%\Git"
)
if not defined GITROOT (
  if exist "%PF_X86%\Git\bin\bash.exe" set "GITROOT=%PF_X86%\Git"
)
if not defined GITROOT (
  if exist "%LocalAppData%\Programs\Git\bin\bash.exe" set "GITROOT=%LocalAppData%\Programs\Git"
)

rem --- Discovery 3: fail loud ---
if not defined GITROOT (
  echo claude-doe.cmd: could not locate a Git-for-Windows install. 1>&2
  rem Parens are escaped as ^( ^) -- an unescaped ")" would close this if-block.
  echo   Checked: where git, %%ProgramFiles%%\Git, %%ProgramFiles^(x86^)%%\Git, %%LocalAppData%%\Programs\Git 1>&2
  echo   Remediation: install Git for Windows ^(https://git-scm.com/download/win^), 1>&2
  echo   or launch claude-doe from a Git Bash terminal instead. 1>&2
  exit /b 1
)

if not exist "%GITROOT%\bin\bash.exe" (
  echo claude-doe.cmd: Git-for-Windows bash not found at "%GITROOT%\bin\bash.exe" 1>&2
  rem Parens escaped -- an unescaped ")" here closes the if-block early, which
  rem silently promotes the following "exit /b 1" to an UNCONDITIONAL statement:
  rem the launcher then exits 1 on every run even when bash.exe is present.
  echo   ^(resolved Git root: %GITROOT%^) 1>&2
  echo   Remediation: repair/reinstall Git for Windows, or launch claude-doe from a Git Bash terminal. 1>&2
  exit /b 1
)

set "GITUSR=%GITROOT%\usr\bin"
set "GITBIN=%GITROOT%\bin"
rem %USERPROFILE%\bin carries jq (used by gen-settings-hooks on every launch);
rem GITUSR carries bash + coreutils (mktemp/grep/sha256sum). The inherited
rem Windows PATH already carries node, the python3 shim, machine-local, claude.
set "PATH=%GITUSR%;%GITBIN%;%USERPROFILE%\bin;%PATH%"

rem Resolve the coordinator --plugin-dir via the POSIX wrapper (non-interactive,
rem side-effect free), then launch claude NATIVELY. Running the interactive claude
rem TUI *through* bash -c corrupts the Windows console input mode -- control keys
rem such as Enter (Ctrl+M) and Ctrl+C arrive stripped to plain letters -- so bash
rem is used ONLY to resolve the path; the interactive process must get a real
rem Windows console.
set "PLUGINDIR="
for /f "usebackq delims=" %%D in (`bash -c "claude-doe --print-plugin-dir"`) do set "PLUGINDIR=%%D"
if not defined PLUGINDIR (
  echo claude-doe.cmd: failed to resolve coordinator plugin dir ^(claude-doe --print-plugin-dir returned nothing^) 1>&2
  exit /b 1
)
call claude --plugin-dir "%PLUGINDIR%" %*
exit /b %ERRORLEVEL%