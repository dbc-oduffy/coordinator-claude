#!/usr/bin/env pwsh
# claude-doe.ps1 - first-class Windows (PowerShell) launcher for the coordinator plugin.
#
# Generated by coordinator gen-claude-doe-launcher.py -- edit the template, not
# this rendered copy.
#   Template:   <DoE>/coordinator/templates/bin/claude-doe-launcher.ps1.tmpl
#   Regenerate: <claude-klabauter>/coordinator/bin/gen-claude-doe-launcher.py
#
# Spec backlink: tasks/2026-07-14-install-dogfood-friction.md par F5 -- the
# canonical launch surface `claude-doe` is naked Python (ported 2026-07-22, no
# longer a POSIX bash script). This launcher resolves --plugin-dir by calling
# the co-located extensionless `claude-doe` DIRECTLY under python3 -- no
# Git-for-Windows bash hop. A prior revision shelled out to Git-for-Windows
# bash (`bash -c "claude-doe --print-plugin-dir"`) for this resolution and
# prepended its usr\bin/bin to PATH, on the theory that gen-settings-hooks
# needed jq (%USERPROFILE%\bin) on every launch and claude-doe needed bash
# coreutils. Both premises are now false: the per-launch gen-settings-hooks
# call was removed 2026-07-20 (see claude-doe's own header), and its
# replacement (coordinator_core/install/gen_settings_hooks.py) uses stdlib
# `json`, not jq, when it does run. claude-doe itself is naked Python with no
# bash/coreutils dependency. Git-for-Windows is therefore not required for an
# ordinary launch at all; this launcher no longer discovers or depends on it.
# cwd is preserved so claude starts in the current directory.
#
# NEGATIVE SPEC -- the interactive claude.exe must be a DIRECT child of the
# invoking shell. Not "eventually reached"; directly spawned. Any intermediate
# process between the shell and claude.exe -- cmd.exe, python.exe, a bash hop --
# corrupts the Windows console input mode: xterm focus-report sequences
# (ESC[I / ESC[O, DECSET 1004) stop being consumed and leak into the input
# stream as literal `[I`/`[O` text, keystrokes misroute to a phantom row, and
# the host shell's own prompt is left corrupted after exit. Bare claude.exe
# from pwsh works; the SAME claude.exe with the SAME args reached through
# pwsh -> cmd -> python does not. The difference is the nesting, nothing else.

$ErrorActionPreference = 'Stop'

# --- argv triage -----------------------------------------------------------
# Two DIFFERENT classes of claude-doe-own flag arrive in argv, and conflating
# them is exactly the console-corruption bug:
#
#   SELF-TERMINATING (--dry-run, --print-plugin-dir, --help, -h): the Python
#     wrapper answers these itself and exits. No interactive TUI is ever
#     rendered, so delegating the WHOLE invocation to it is safe -- and
#     necessary, since `claude` rejects them outright ("error: unknown option
#     '--dry-run'"). Handled BEFORE plugin-dir resolution: none of these flags
#     need it, matching claude-doe's own "--help must never require external
#     state" rule.
#
#   --doe-root <path> / --doe-root=<path>: NOT self-terminating. It is a
#     resolution INPUT to an otherwise ordinary interactive launch -- and it is
#     the shape the PowerShell `claude` shim uses on EVERY launch. Delegating
#     it hands the interactive TUI to the wrapper, putting claude.exe under
#     python.exe and violating the direct-child negative spec above. So
#     --doe-root is consumed HERE and folded into the non-interactive
#     --print-plugin-dir resolution below; it never becomes a delegated launch.
#
# This is a token-level scan with no positional awareness: if `claude` ever
# grew a flag that takes one of these names as its OWN value in a separate
# token, this loop would false-intercept on it. Accepted as safe today because
# `claude`'s flag surface takes no such value; if that ever changes, this needs
# a real positional argument-parsing model, not a bodge.
$selfFlags = @('--dry-run', '--print-plugin-dir', '--help', '-h')
$intercept = $false
$doeRoot = $null
$doeRootSeen = $false
$passthru = @()
$i = 0
while ($i -lt $args.Count) {
    $t = [string]$args[$i]
    if ($selfFlags -contains $t) {
        $intercept = $true
        $passthru += $args[$i]
    }
    elseif ($t -eq '--doe-root') {
        $doeRootSeen = $true
        # Last --doe-root wins, matching the Python wrapper's repeat semantics.
        # Parity is on REPEAT only, not on validation: the wrapper also rejects a
        # flag-shaped value (a following token starting with `--`), and this does
        # not. That case still fails correctly, just later and from further away
        # -- the value is folded into the --print-plugin-dir call, and the
        # wrapper rejects it there with its own exit 2, which propagates.
        # A trailing bare --doe-root leaves the value empty and is rejected
        # below rather than silently dropped.
        if ($i + 1 -lt $args.Count) { $doeRoot = [string]$args[$i + 1]; $i++ }
        else { $doeRoot = '' }
    }
    elseif ($t.StartsWith('--doe-root=', [System.StringComparison]::OrdinalIgnoreCase)) {
        $doeRootSeen = $true
        $doeRoot = $t.Substring('--doe-root='.Length)
    }
    else {
        $passthru += $args[$i]
    }
    $i++
}

if ($intercept) {
    # Delegate the ORIGINAL argv verbatim (@args, not @passthru) so the wrapper
    # sees any --doe-root too and reports against the same root.
    $wrapper = Join-Path $PSScriptRoot 'claude-doe'
    & python3 $wrapper @args
    exit $LASTEXITCODE
}

if ($doeRootSeen -and -not $doeRoot) {
    # The same failure the Python wrapper raises for a valueless --doe-root,
    # raised here because the wrapper never sees this argv on the interactive
    # path -- and exiting 2 to match it, which is the wrapper's code for a usage
    # error. Exiting 1 made the message identical to the wrapper's and the code
    # divergent, which is worse than either being plainly different.
    # Plain stderr write, NOT Write-Error: under `$ErrorActionPreference
    # = 'Stop'` Write-Error raises a terminating error, so the `exit` below
    # it would never run.
    [Console]::Error.WriteLine("claude-doe.ps1: --doe-root requires a path argument")
    exit 2
}

# Resolve the coordinator --plugin-dir via the co-located Python wrapper
# (non-interactive, side-effect free, stdout captured to a pipe), then launch
# claude NATIVELY. This resolution call is the ONE python3 hop the negative
# spec permits: it renders no TUI and never touches the console input mode.
# Capture RAW first, and read $LASTEXITCODE before touching the value. Trimming
# inline (`(& ...).Trim()`) throws "cannot call a method on a null-valued
# expression" whenever the child writes nothing to stdout -- which is exactly the
# failure case -- and under `$ErrorActionPreference = 'Stop'` that throw kills the
# script BEFORE the exit-code branch below can run, replacing a clean propagation
# with a PowerShell runtime error. Verified empirically, not assumed.
$wrapperPath = Join-Path $PSScriptRoot 'claude-doe'
$ppdArgs = @($wrapperPath)
if ($doeRoot) { $ppdArgs += @('--doe-root', $doeRoot) }
$ppdArgs += '--print-plugin-dir'
$pluginDirRaw = & python3 @ppdArgs
$ppdExitCode = $LASTEXITCODE
if ($ppdExitCode -ne 0) {
    # Non-zero exit: the child already explained itself on stderr (inherited
    # straight to this console, not captured above) -- propagate its code
    # rather than overwrite that message with "returned nothing".
    exit $ppdExitCode
}
# Only stdout is captured, so a multi-line child yields an array -- take the first
# line rather than stringifying the whole array into the --plugin-dir argument.
$pluginDir = ($pluginDirRaw | Select-Object -First 1)
if ($null -ne $pluginDir) { $pluginDir = ([string]$pluginDir).Trim() }
if (-not $pluginDir) {
    # Exit 0 with empty stdout is the genuinely-empty case -- this generic
    # text is only correct here.
    # Plain stderr write, NOT Write-Error: see the --doe-root branch above.
    [Console]::Error.WriteLine("claude-doe.ps1: failed to resolve coordinator plugin dir (claude-doe --print-plugin-dir returned nothing)")
    exit 1
}
# Resolve claude to the actual APPLICATION, not the PowerShell 'claude' function
# (which points back at this launcher chain) -- else this recurses infinitely.
# @passthru, not @args: the consumed --doe-root pair must not reach claude,
# which would reject it as an unknown option.
$claudeExe = (Get-Command claude -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source

# Open the harness cross-session-messaging gate for the child. The harness
# predicate short-circuits true on CLAUDE_CODE_HARBOR_KITE ahead of both its
# platform check and its GrowthBook read (bundle 2.1.232 onward), and without
# it an interactive Windows session binds no inbox at all: no
# messagingSocketPath, no peer address, and `SendMessage` refusals that cannot
# even name the address the caller should have used (the ref is
# sha256("session:" + messagingSocketPath), so no socket means no ref to quote).
#
# The POSIX chain gets this from claude-doe.py's os.environ.setdefault, which
# runs immediately before ITS launch call. This launcher never reaches that
# line: it invokes the wrapper once with --print-plugin-dir, which returns ~35
# lines above the setdefault and exits with its environment. The native spawn
# below is the direct-child invariant and must stay, so the gate has to be set
# here instead.
#
# PRESENCE test, not truthiness (`-not $env:...` is wrong here): the opt-out is
# the EMPTY STRING. "0" is a non-empty string and therefore TRUTHY to the
# harness's plain-JS predicate, so an operator exporting =0 would open the gate
# while believing they shut it -- document the empty string, never 0. pwsh
# stores an empty assignment as a real empty var (Test-Path -> True) and
# propagates it to the child as '', which the predicate reads as falsy; a
# truthiness guard would overwrite exactly that opt-out with '1'.
#
# Save/restore around the spawn: the shim invokes this launcher by path in the
# OPERATOR'S OWN pwsh process (the direct-child requirement), and $env: writes
# are process-wide regardless of scope -- an unrestored assignment would linger
# in the interactive shell after claude exits. Scoped launch variable, not a
# side effect on the operator's session.
$__cdlHarborKitePresent = Test-Path -LiteralPath Env:\CLAUDE_CODE_HARBOR_KITE
$__cdlHarborKitePrior = if ($__cdlHarborKitePresent) { $env:CLAUDE_CODE_HARBOR_KITE } else { $null }
if (-not $__cdlHarborKitePresent) { $env:CLAUDE_CODE_HARBOR_KITE = '1' }

# Export the resolved coordinator CLONE ROOT as the http-hook routing key
# (DR-http-hook-forwarder-fixed-port, Decision 1). The forwarder cannot route a
# fired hook to the right engine clone from the port alone -- the port is
# machine-global and single -- and `body.cwd` was refused as the key because it
# names the operator's live shell directory, not the clone the session launched
# from.
#
# The value names the STAMPED ENGINE clone, and is NOT derivable from
# $pluginDir. $pluginDir is <doctrine-clone>/coordinator, so its parent is the
# DOCTRINE clone -- which carries no `coordinator_core/_engine_stamp` and can
# never satisfy `front_door_routing :: resolve_route`, whose identity check is
# `is_engine_root`. Exporting it answered `root_unstamped` on every fire. The
# engine clone is reachable from no path arithmetic over $pluginDir at all; it
# has to be resolved from the machine-local channels below.
#
# Ladder, cheapest rung first, mirroring claude-doe.py ::
# _resolve_stamped_engine_root (claude-klabauter) -- the two must agree, and a
# disagreement produces no error anywhere, just a session the front door
# rejects:
#   1. <settings-home>/machine-local/.claude-klabauter-root -- one file read.
#   2. `repos.claude_klabauter` from registry.local.toml then registry.toml.
# Each candidate must be a directory AND carry a readable, non-empty stamp; an
# unstamped rung-1 pointer falls through to rung 2 rather than short-circuiting.
#
# NO SUBPROCESS, deliberately: this is the session-launch hot path, and
# `coordinator_core.engine_root`'s own rung 2 shells out to `machine-local` for
# this same key. The registry keys are flat, dotted and quoted at top level
# (`"repos.claude_klabauter" = '...'`), so a per-line regex is the whole read --
# no TOML parser needed for a top-level lookup.
#
# FAIL CLOSED on a miss: export NOTHING rather than an unstamped path.
# `key-absent` is the honest answer for a box with no published engine
# registered; a declared-but-wrong value would claim a routing intent never
# formed. Never blocks a launch -- the whole lookup is wrapped.
#
# setdefault, never overwrite: an operator who has already exported this key is
# pinning a clone deliberately, and this launcher must not silently override
# that.
#
# Save/restore is NOT optional here for the same reason as the kite above: this
# runs in the operator's own pwsh process, so an unrestored assignment would
# leak the clone root into their interactive shell and mis-route every session
# they launch afterwards by hand.
$__cdlCloneRootPresent = Test-Path -LiteralPath Env:\COORDINATOR_CLONE_ROOT
$__cdlCloneRootPrior = if ($__cdlCloneRootPresent) { $env:COORDINATOR_CLONE_ROOT } else { $null }
if (-not $__cdlCloneRootPresent) {
    $__cdlEngineRoot = $null
    try {
        $__cdlSettingsHome = $env:COORDINATOR_SETTINGS_HOME
        if (-not $__cdlSettingsHome) {
            # CLAUDE_HOME -> HOME -> USERPROFILE, the same order
            # claude-doe.py :: _resolve_home_for_clone_shim walks.
            $__cdlHomeDir = $env:CLAUDE_HOME
            if (-not $__cdlHomeDir) { $__cdlHomeDir = $env:HOME }
            if (-not $__cdlHomeDir) { $__cdlHomeDir = $env:USERPROFILE }
            if ($__cdlHomeDir) {
                $__cdlSettingsHome = Join-Path $__cdlHomeDir '.coordinator-claude-settings'
            }
        }
        if ($__cdlSettingsHome) {
            $__cdlMlDir = $env:MACHINE_LOCAL_REGISTRY_DIR
            if (-not $__cdlMlDir) { $__cdlMlDir = Join-Path $__cdlSettingsHome 'machine-local' }

            # ONE stamp gate, shared by both rungs. Two copies could gate
            # differently, and a rung that accepted an unstamped root would export
            # exactly the identity this whole change removed.
            # Only the stamp's BYTES matter (skew.write_engine_stamp's own
            # contract) -- readable and non-empty, never parsed.
            $__cdlIsStampedEngine = {
                param($Candidate)
                if (-not $Candidate) { return $false }
                if (-not (Test-Path -LiteralPath $Candidate -PathType Container)) { return $false }
                $stamp = Join-Path (Join-Path $Candidate 'coordinator_core') '_engine_stamp'
                $item = Get-Item -LiteralPath $stamp -ErrorAction SilentlyContinue
                return [bool]($item -and -not $item.PSIsContainer -and $item.Length -gt 0)
            }

            # Rung 1 -- the pointer, one file read.
            $__cdlPointed = (Get-Content -LiteralPath (Join-Path $__cdlMlDir '.claude-klabauter-root') -Raw -ErrorAction SilentlyContinue)
            if ($__cdlPointed) { $__cdlPointed = ([string]$__cdlPointed).Trim() }
            if (& $__cdlIsStampedEngine $__cdlPointed) { $__cdlEngineRoot = $__cdlPointed }

            # Rung 2 -- the registry, and LAZY: not read at all when rung 1
            # answered. The steady state on a healthy box is pointer-present-and-
            # stamped, so reading these two files there spent work for an answer
            # already in hand -- which contradicted this block's own hot-path
            # claim above. The .cmd leg was already lazy; this matches it.
            #
            # Per-machine local wins on collision, and the FIRST file carrying a
            # non-empty value ends the walk whether or not that value turns out to
            # be stamped -- registry.toml is not consulted behind a
            # registry.local.toml that answered.
            if (-not $__cdlEngineRoot) {
                foreach ($__cdlRegName in @('registry.local.toml', 'registry.toml')) {
                    $__cdlRegHit = ''
                    $__cdlRegLines = Get-Content -LiteralPath (Join-Path $__cdlMlDir $__cdlRegName) -ErrorAction SilentlyContinue
                    foreach ($__cdlLine in $__cdlRegLines) {
                        $__cdlMatch = [regex]::Match($__cdlLine, '^\s*"repos\.claude_klabauter"\s*=\s*(?:''([^'']*)''|"([^"]*)")')
                        if ($__cdlMatch.Success) {
                            $__cdlRegHit = if ($__cdlMatch.Groups[1].Success) { $__cdlMatch.Groups[1].Value } else { $__cdlMatch.Groups[2].Value }
                            break
                        }
                    }
                    $__cdlRegHit = $__cdlRegHit.Trim()
                    if ($__cdlRegHit) {
                        if (& $__cdlIsStampedEngine $__cdlRegHit) { $__cdlEngineRoot = $__cdlRegHit }
                        break
                    }
                }
            }
        }
    } catch {
        # Swallowed deliberately: a launch must never fail over a best-effort
        # routing-key lookup. The miss path is the fail-closed path below.
    }
    if ($__cdlEngineRoot) { $env:COORDINATOR_CLONE_ROOT = $__cdlEngineRoot }
}

# Export the http-hook override-channel CANARY. A `type: "http"` registration
# reaches the caller's environment only through interpolated headers -- the POST
# body carries no `env` key under any spelling -- and an `httpHookAllowedEnvVars`
# setting can veto a name by emptying its header rather than by erroring. An
# emptied override header is indistinguishable from a caller who set no
# override, and the guard resolves that ambiguity permissively, so the channel
# carries two discriminators: a STATIC literal that survives a veto, and this
# INTERPOLATED canary, which does not. Declared-plus-empty-canary is a vetoed
# channel and answers "the guard did not run"; undeclared is silent, so no
# legacy registration fails closed. Registration side is pinned by
# test_hooks_json_http_fail_open_boundary.py gate 5; this is the other half --
# an allowlisted canary the launcher never exports interpolates EMPTY on every
# fire, which reads as a permanent veto.
#
# The value is arbitrary and only ever tested for non-emptiness. It is not a
# secret, not a token, and grants nothing.
#
# setdefault on a PRESENCE test, same posture and same measured reason as the
# two exports above -- and here the empty string is meaningful rather than
# merely possible: an operator exporting it empty is simulating a veto, which a
# truthiness guard would silently overwrite with '1'.
#
# Save/restore for the same reason as the clone root: this runs in the
# operator's own pwsh process.
$__cdlProbeCanaryPresent = Test-Path -LiteralPath Env:\COORDINATOR_PROBE_CANARY
$__cdlProbeCanaryPrior = if ($__cdlProbeCanaryPresent) { $env:COORDINATOR_PROBE_CANARY } else { $null }
if (-not $__cdlProbeCanaryPresent) { $env:COORDINATOR_PROBE_CANARY = '1' }

# Export the front door's shared CREDENTIAL. `front_door._Handler.do_POST`
# reads it off the X-Coordinator-Door-Key header and SHORT-CIRCUITS to
# `credential_absent` before it resolves a route or consults its own key --
# there is no "no key configured, therefore allow" path -- so a session that
# launches without this exported answers every http-registered hook with
# `unroutable_response`'s loud did-not-run shape and the op never runs.
#
# WHY THIS LEG NEEDS ITS OWN COPY: the POSIX chain gets the key from
# claude-doe.py's `os.environ.setdefault` immediately before ITS launch call.
# This launcher never reaches that line -- same reason as the kite above: it
# invokes the wrapper only with --print-plugin-dir, which returns well above
# the setdefault and exits with its environment, and the native spawn below is
# the direct-child invariant. So the export has to happen here.
#
# READ-OR-MINT, NOT READ-ONLY: nothing else mints on this platform.
# `_FrontDoorContext._boot_credential` only ever calls `read_secret()`, and
# `ensure_secret()`'s sole caller is the POSIX leg this chain does not run --
# so a read-only export would leave a Windows box permanently keyless. Path,
# byte count and atomic-replace shape are claude-doe.py's verbatim, because a
# second spelling of the same secret is a second secret.
#
# NO python3 HOP: the resolution call above is the one hop this launcher's
# negative spec allows, and this runs natively rather than spending another.
#
# NEVER BLOCK A LAUNCH on the credential -- claude-doe.py's own posture. A
# throw here would cost the operator their session to protect a hook.
$__cdlDoorKeyPresent = Test-Path -LiteralPath Env:\COORDINATOR_DOOR_KEY
$__cdlDoorKeyPrior = if ($__cdlDoorKeyPresent) { $env:COORDINATOR_DOOR_KEY } else { $null }
if (-not $__cdlDoorKeyPresent) {
    try {
        $__cdlKeyBase = $env:XDG_CACHE_HOME
        if (-not $__cdlKeyBase) { $__cdlKeyBase = $env:LOCALAPPDATA }
        if (-not $__cdlKeyBase) { $__cdlKeyBase = Join-Path $HOME '.cache' }
        $__cdlKeyDir = Join-Path (Join-Path $__cdlKeyBase 'coordinator') 'warm'
        $__cdlKeyPath = Join-Path $__cdlKeyDir 'door-key'
        $__cdlKey = ''
        if (Test-Path -LiteralPath $__cdlKeyPath) {
            $__cdlKey = (Get-Content -LiteralPath $__cdlKeyPath -Raw -ErrorAction Stop).Trim()
        }
        if (-not $__cdlKey) {
            # 32 bytes -> 64 hex chars, matching secrets.token_hex(32). RNGCryptoServiceProvider
            # is obsolete in .NET Core; RandomNumberGenerator::GetBytes is the current spelling.
            $__cdlBytes = [byte[]]::new(32)
            [System.Security.Cryptography.RandomNumberGenerator]::Fill($__cdlBytes)
            $__cdlKey = -join ($__cdlBytes | ForEach-Object { $_.ToString('x2') })
            New-Item -ItemType Directory -Force -Path $__cdlKeyDir -ErrorAction Stop | Out-Null
            $__cdlKeyTmp = $__cdlKeyPath + '.tmp'
            # No trailing newline and no BOM: `read_secret()` strips, but
            # `credential_from_headers` compares the header byte-for-byte, and a
            # BOM would travel in the header and never match.
            [System.IO.File]::WriteAllText($__cdlKeyTmp, $__cdlKey, [System.Text.UTF8Encoding]::new($false))
            # 3-arg Move is the os.replace equivalent -- overwrites in one step,
            # so a concurrent reader never sees a partial value. Concurrent mints
            # race benignly: last writer wins and the loser's session simply reads
            # as unauthenticated at its next fire.
            [System.IO.File]::Move($__cdlKeyTmp, $__cdlKeyPath, $true)
        }
        if ($__cdlKey) { $env:COORDINATOR_DOOR_KEY = $__cdlKey }
    } catch {
        # Swallowed deliberately: a keyless session still launches and still
        # works for everything but http-registered hooks, which answer loudly.
    }
}
try {
    & $claudeExe --plugin-dir $pluginDir @passthru
} finally {
    if ($__cdlHarborKitePresent) {
        $env:CLAUDE_CODE_HARBOR_KITE = $__cdlHarborKitePrior
    } else {
        Remove-Item -LiteralPath Env:\CLAUDE_CODE_HARBOR_KITE -ErrorAction SilentlyContinue
    }
    if ($__cdlCloneRootPresent) {
        $env:COORDINATOR_CLONE_ROOT = $__cdlCloneRootPrior
    } else {
        Remove-Item -LiteralPath Env:\COORDINATOR_CLONE_ROOT -ErrorAction SilentlyContinue
    }
    if ($__cdlProbeCanaryPresent) {
        $env:COORDINATOR_PROBE_CANARY = $__cdlProbeCanaryPrior
    } else {
        Remove-Item -LiteralPath Env:\COORDINATOR_PROBE_CANARY -ErrorAction SilentlyContinue
    }
    if ($__cdlDoorKeyPresent) {
        $env:COORDINATOR_DOOR_KEY = $__cdlDoorKeyPrior
    } else {
        Remove-Item -LiteralPath Env:\COORDINATOR_DOOR_KEY -ErrorAction SilentlyContinue
    }
}
exit $LASTEXITCODE
