#!/usr/bin/env pwsh
# claude-doe.ps1 - first-class Windows (PowerShell) launcher for the coordinator plugin.
#
# Generated by coordinator gen-claude-doe-launcher.py -- edit the template, not
# this rendered copy.
#   Template:   <DoE>/coordinator/templates/bin/claude-doe-launcher.ps1.tmpl
#   Regenerate: <DoE>/coordinator/bin/gen-claude-doe-launcher.py
#
# Spec backlink: tasks/2026-07-14-install-dogfood-friction.md par F5 -- the
# canonical launch surface `claude-doe` is a POSIX bash script. Git-for-Windows'
# usr\bin (bash + the coreutils claude-doe needs: mktemp/grep/sha256sum) and
# %USERPROFILE%\bin (jq, used by gen-settings-hooks on every launch) are NOT on
# the Windows PATH, so `claude-doe` / `bash` / `jq` are not bare-invocable from
# PowerShell. This launcher discovers the Git-for-Windows install root at
# RUNTIME (no hardcoded path -- the hand-made stopgap it replaces hardcoded
# "C:\Program Files\Git" <!-- foreign-path-ok: names the removed stopgap, not a real machine path -->, which breaks on a non-default Git install location),
# prepends its shell bins to PATH for this process only, then execs the POSIX
# wrapper. cwd is preserved so claude starts in the current directory.
#
# Git-for-Windows discovery order (first hit wins):
#   1. `Get-Command git` -- resolves whatever git.exe is actually on THIS
#      machine's PATH. git.exe normally lives at <GitRoot>\cmd\git.exe or
#      <GitRoot>\bin\git.exe; GitRoot is git.exe's grandparent directory.
#   2. Common install locations: $env:ProgramFiles\Git,
#      ${env:ProgramFiles(x86)}\Git, $env:LocalAppData\Programs\Git.
#   3. Fail loud with remediation.

$ErrorActionPreference = 'Stop'

function Resolve-GitRoot {
    $gitCmd = Get-Command git -ErrorAction SilentlyContinue
    if ($gitCmd) {
        # git.exe path is <GitRoot>\cmd\git.exe or <GitRoot>\bin\git.exe.
        $gitExeDir = Split-Path -Parent $gitCmd.Source
        $candidate = Split-Path -Parent $gitExeDir
        if (Test-Path (Join-Path $candidate 'bin\bash.exe')) {
            return $candidate
        }
    }

    $candidates = @(
        (Join-Path $env:ProgramFiles 'Git'),
        (Join-Path ${env:ProgramFiles(x86)} 'Git'),
        (Join-Path $env:LocalAppData 'Programs\Git')
    )
    foreach ($c in $candidates) {
        if ($c -and (Test-Path (Join-Path $c 'bin\bash.exe'))) {
            return $c
        }
    }
    return $null
}

$gitRoot = Resolve-GitRoot
if (-not $gitRoot) {
    Write-Error @"
claude-doe.ps1: could not locate a Git-for-Windows install.
  Checked: Get-Command git, `$env:ProgramFiles\Git, `${env:ProgramFiles(x86)}\Git, `$env:LocalAppData\Programs\Git
  Remediation: install Git for Windows (https://git-scm.com/download/win),
  or launch claude-doe from a Git Bash terminal instead.
"@
    exit 1
}

$gitUsr = Join-Path $gitRoot 'usr\bin'
$gitBin = Join-Path $gitRoot 'bin'
$userBin = Join-Path $env:USERPROFILE 'bin'

# Process-local PATH prepend only -- does not touch the persistent user/machine PATH.
$env:PATH = "$gitUsr;$gitBin;$userBin;$env:PATH"

$bashExe = Join-Path $gitBin 'bash.exe'

# Resolve the coordinator --plugin-dir via the POSIX wrapper (non-interactive,
# side-effect free), then launch claude NATIVELY. Running the interactive claude
# TUI *through* bash corrupts the Windows console input mode, so bash resolves the
# path only; the interactive process gets a real Windows console.
$pluginDir = (& $bashExe -c 'claude-doe --print-plugin-dir').Trim()
if (-not $pluginDir) {
    Write-Error "claude-doe.ps1: failed to resolve coordinator plugin dir (claude-doe --print-plugin-dir returned nothing)"
    exit 1
}
# Resolve claude to the actual APPLICATION, not the PowerShell 'claude' function
# (which points back at this launcher chain) -- else this recurses infinitely.
$claudeExe = (Get-Command claude -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source
& $claudeExe --plugin-dir $pluginDir @args
exit $LASTEXITCODE