#!/usr/bin/env python3
# resolve-coordinator-clone — fixed-path out-of-tree entry shim (python-direct).
#
# Naked-Python port of the retired bash shim (2026-07-22 de-bash campaign,
# templates/bin wave). Out-of-tree consumers (project-rag, project-rag-ue-addon,
# example-game-workbench-repo) call this ONE fixed path instead of each hand-rolling
# a find-the-resolver locator:
#
#     ~/.claude/bin/resolve-coordinator-clone --for-content
#     ~/.claude/bin/resolve-coordinator-clone --for-git-ops
#
# The shim's only job is to LOCATE lib/resolve-coordinator-clone.py — the
# chicken-and-egg an out-of-tree caller cannot solve (the lib lives inside the
# very clone it resolves) — and then run it, passing all args through. The LIB
# owns ALL content/git-ops precedence; this shim only finds the lib. Its
# locate-ladder is a deliberate SUBSET of the lib's (just find the file),
# centralized in ONE coordinator-owned file instead of N hand-rolled consumer
# copies.
#
# Position-independent BY DESIGN: it does NOT use its own file location to find
# the lib (that would just relocate the consumer's chicken-and-egg). It anchors
# on the fixed ${CLAUDE_HOME:-$HOME}/.claude home. Every installed copy is
# therefore byte-identical (satisfies the verify-templates-bin-sync byte-
# identity gate).
#
# CLAUDE_HOME is a $HOME SUBSTITUTE, not a .claude substitute (matches the lib's
# _claude_home_dir and install-substrate's _install_base): CLAUDE_HOME=/tmp/sb
# redirects the whole install to /tmp/sb/.claude/. The `.claude` suffix is
# appended here, NOT folded into the default — a bare CLAUDE_HOME-or-HOME/.claude
# default would silently break the sandbox/CI escape hatch CLAUDE_HOME exists to
# provide.
#
# Public contract surface: this fixed path + the lib's --for-content/
# --for-git-ops flags (aliases --content-root/--clone-root) + the
# CLAUDE_PLUGIN_ROOT/COORDINATOR_ROOT/COORDINATOR_CLONE/CLAUDE_HOME env
# overrides. CONTRACT STABILITY: these are append-only — removing/renaming any
# is a breaking change requiring a coordinated cross-repo memo wave to the
# three consumers (project-rag / project-rag-ue-addon / example-game-workbench-repo),
# never a silent edit.
#
# Spec backlink: docs/plans/2026-06-23-coordinator-owned-resolver-shim.md
# Spec backlink: docs/plans/2026-07-19-debash-coordinator-windows.md § Wave E2 (E2-c)
#
# Retired: the bash trampoline this shim used to exec bash against
# (coordinator/lib/resolve-coordinator-clone.sh) is deleted — the lib itself
# has been Python (resolve-coordinator-clone.py) since the 2026-07-21 de-bash
# campaign, and this shim now locates + runs that file directly. Do NOT
# reintroduce a bash re-exec here; a `.cmd` that shells out to `bash.exe` was
# exactly the defect this port eliminates.

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

_LIB_REL = Path("lib") / "resolve-coordinator-clone.py"


def _home_dir() -> Path:
    return Path(os.environ.get("CLAUDE_HOME") or os.environ.get("HOME") or os.environ.get("USERPROFILE") or "") / ".claude"


def _settings_home_dir() -> Path | None:
    override = os.environ.get("COORDINATOR_SETTINGS_HOME")
    if override:
        return Path(override)
    home = os.environ.get("CLAUDE_HOME") or os.environ.get("HOME") or os.environ.get("USERPROFILE")
    if not home:
        return None
    return Path(home) / ".coordinator-claude-settings"


def _flatten_registry(data: dict, _prefix: str = "") -> dict:
    """Flatten nested registry TOML tables to dotted keys.

    Mirrors `_machine_local.py::_flatten_nested` (the canonical registry
    reader) so this shim's minimal reader accepts the same natural
    `[repos]\\nclaude_klabauter = "..."` table form as the flat dotted-key
    form, instead of silently missing nested tables.
    """
    result: dict = {}
    for k, v in data.items():
        full_key = f"{_prefix}{k}"
        if isinstance(v, dict):
            result.update(_flatten_registry(v, _prefix=f"{full_key}."))
        else:
            result[full_key] = v
    return result


def _is_stamped_engine(root: str) -> bool:
    """True when `root` is a built engine: `coordinator_core/_engine_stamp`
    exists and is non-empty. A claude-klabauter working tree carries no stamp
    and is never an engine."""
    try:
        return bool((Path(root) / "coordinator_core" / "_engine_stamp").read_bytes())
    except OSError:
        return False


def _engine_root() -> str | None:
    """Resolve the published claude-klabauter engine root; never a
    claude-klabauter tree. The shim only locates lib/resolve-coordinator-clone.py
    inside it.

      1. $COORDINATOR_ENGINE_ROOT, accepted only when stamped
      2. <settings-home>/machine-local/registry.local.toml (checked first),
         falling back to registry.toml — key "repos.claude_klabauter",
         accepting both the flat dotted form and a nested [repos] table
         (flattened to dotted keys, mirroring
         `_machine_local.py::_flatten_nested`); accepted only when stamped,
         and an empty-string value is a sentinel placeholder
    """
    root = os.environ.get("COORDINATOR_ENGINE_ROOT")
    if root and _is_stamped_engine(root):
        return root

    settings_home = _settings_home_dir()
    if settings_home is not None:
        try:
            import tomllib

            reg_dir = settings_home / "machine-local"
            for reg_name in ("registry.local.toml", "registry.toml"):
                reg = reg_dir / reg_name
                if not reg.is_file():
                    continue
                try:
                    with reg.open("rb") as fh:
                        data = tomllib.load(fh)
                except (OSError, tomllib.TOMLDecodeError):
                    continue
                v = _flatten_registry(data).get("repos.claude_klabauter")
                if isinstance(v, str) and v and _is_stamped_engine(v):
                    return v
        except ImportError:
            pass

    return None


_POINTER_NAMES = (
    ".coordinator-content-root",
    ".content-root",  # compat-fallback: legacy pointer name
)


def _content_root_pointer() -> str:
    # Settings-home pointer first, then the ~/.claude pointer; the
    # content-root name wins over the legacy name at each location.
    settings_home = _settings_home_dir()
    locations = []
    if settings_home is not None:
        locations.append(settings_home / "machine-local")
    locations.append(_home_dir())
    for location in locations:
        for name in _POINTER_NAMES:
            try:
                root = (location / name).read_text(encoding="utf-8").strip()
            except OSError:
                continue
            if root:
                return root
    return ""


_VERSION_RE = re.compile(r"^(\d+)(?:\.(\d+))?(?:\.(\d+))?")


def _version_key(dirname: str) -> tuple[int, int, int]:
    m = _VERSION_RE.match(dirname)
    if not m:
        return (0, 0, 0)
    a, b, c = m.groups()
    return (int(a or 0), int(b or 0), int(c or 0))


def _locate_lib() -> Path | None:
    # 1. Env override — any root the caller pins that holds the lib file wins
    #    (harness injection, test sandboxes, explicit overrides). Tried in
    #    the lib's own root precedence: CLAUDE_PLUGIN_ROOT (content tier 1),
    #    COORDINATOR_ROOT (content tier 2), COORDINATOR_CLONE (git-ops root —
    #    also a valid lib-file location). The shim only needs to FIND the lib
    #    here; the lib re-applies full precedence.
    for env_var in ("CLAUDE_PLUGIN_ROOT", "COORDINATOR_ROOT", "COORDINATOR_CLONE"):
        root = os.environ.get(env_var)
        if root and (Path(root) / _LIB_REL).is_file():
            return Path(root) / _LIB_REL

    # 2. Cold-readable content-root pointer (projected from the machine-local
    #    registry at install / session-init self-heal). Under maximalist the
    #    lib lives at <DoE>/coordinator/lib/... where <DoE> is the pointer's
    #    single line; this tier survives Phase-2 flat-tree removal cold.
    #    Placed ABOVE the flat layout (the Phase-2-doomed tree) and BELOW env
    #    overrides.
    content_root = _content_root_pointer()
    if content_root:
        candidate = Path(content_root) / "coordinator" / _LIB_REL
        if candidate.is_file():
            return candidate

    # 2b. Published engine root (see _engine_root()): the executable surface
    #     lives in the engine's coordinator/ tree, not coordinator-content-repo's.
    engine_root = _engine_root()
    if engine_root:
        candidate = Path(engine_root) / "coordinator" / _LIB_REL
        if candidate.is_file():
            return candidate

    # 3. Flat layout (source_is_live / single-clone install). Flat before
    #    versioned cache: on a source_is_live machine the live tree's lib is
    #    more current than any cached version — intentional inversion vs the
    #    lib's --for-content order.
    flat = _home_dir() / "plugins" / "coordinator-claude" / "coordinator" / _LIB_REL
    if flat.is_file():
        return flat

    # 4. Versioned plugin cache — newest version dir, numeric (not
    #    lexicographic) semver compare so 2.10.0 beats 2.9.0.
    cache_parent = _home_dir() / "plugins" / "cache" / "coordinator-claude" / "coordinator"
    if cache_parent.is_dir():
        best_path: Path | None = None
        best_key = (0, 0, 0)
        for entry in cache_parent.iterdir():
            if not entry.is_dir():
                continue
            candidate = entry / _LIB_REL
            if not candidate.is_file():
                continue
            key = _version_key(entry.name)
            if key > best_key:
                best_path = candidate
                best_key = key
        if best_path is not None:
            return best_path

    return None


def main(argv: list[str]) -> int:
    lib = _locate_lib()
    if lib is None:
        home = _home_dir()
        sys.stderr.write(
            f"resolve-coordinator-clone: cannot locate {_LIB_REL} under any known coordinator install location.\n"
            f"  Searched: $CLAUDE_PLUGIN_ROOT, $COORDINATOR_ROOT, $COORDINATOR_CLONE, "
            f"{home}/.coordinator-content-root pointer, the published claude-klabauter engine (via a stamped $COORDINATOR_ENGINE_ROOT "
            "or registry.local.toml repos.claude_klabauter), "
            f"{home}/plugins/coordinator-claude/coordinator/, and the versioned plugin cache.\n"
            f"  Remediation: install/repair the coordinator plugin (writes {home}/.coordinator-content-root), "
            "set CLAUDE_PLUGIN_ROOT to its checkout, or set COORDINATOR_ENGINE_ROOT to a stamped claude-klabauter.\n"
        )
        return 1

    # Synchronous child, never os.execv: on Windows execv spawns and exits at
    # once, so the caller sees exit 0 before the child's stdout. No
    # CREATE_NO_WINDOW: it gives the child a fresh console and drops the
    # inherited std handles; this shim already runs under the caller's console.
    return subprocess.call([sys.executable, str(lib), *argv])  # popup-intentional-last-resort


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
