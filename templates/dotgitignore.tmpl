backups/
cache/
debug/
downloads/
file-history/
ide/
daemon/
paste-cache/
session-env/
shell-snapshots/
statsig/
telemetry/
todos/
usage-data/
sessions/
image-cache/
.last-cleanup

# --- Per-project session data (memory, settings, pointers — machine-local) ---
projects/

# --- Tasks: ignore UUID-named TodoWrite files (8-hex prefix + rest) + caches; keep curated files ---
# (lessons.md, improvement-queue.md, handoffs/ etc. stay tracked.)
tasks/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*
state/orientation_cache.md
state/.scc-cache
tasks/_*.log

# --- Plugin install/marketplace state (machine-specific paths, autoupdate stamps, caches) ---
plugins/installed_plugins.json
plugins/known_marketplaces.json
plugins/blocklist.json
plugins/install-counts-cache.json
plugins/cache/
plugins/marketplaces/
plugins/data/
plugins/.last_inuse_sweep
plugins/plugin-catalog-cache.json
# Nested per-plugin data dirs (doctor-last-run.json, health-check stamps,
# host-inventory caches) — regenerated on every doctor run, host-specific.
plugins/*/data/

# --- Repository map (regenerable cache) ---
.claude/repomap.md
.claude/repomap-cache/

# --- Scratch / agent-teams scratch (transient, consumed by next phase) ---
scratch/
teams/

# --- Session plans (ephemeral). Anchored to root so it does NOT shadow docs/plans/. ---
/plans/

# --- Installer-created machine artifacts (regenerable; never commit) ---
# The coordinator venv the installer builds (16M+, 1000+ files) — pinned via the
# machine-local key coordinator.python; a naive `git add` would commit the whole tree.
.coordinator-venv/
# Per-process GPU tenant scratch + install/runtime logs + the on-disk cache — pure
# runtime churn.
gpu-tenants/
logs/
/.cache/
# Example: a per-plugin installer stamp file, only relevant if that plugin is
# installed. Uncomment and rename for the plugin you're using:
# <plugin-name>-setup-state.yaml
# NOTE: `setup/` is intentionally NOT ignored — it is tracked doctrine (install
# scripts, publish targets), not machine state.

# --- Embedded plugin repos (separate git checkouts at the ~/.claude root) ---
# A plugin that is its own git clone (e.g. a vendored tool or SDK checked out
# under its own directory) triggers git's "adding embedded git repository"
# warning and would be committed as a gitlink. Ignore the nested .git so the
# working tree is tracked as plain files without absorbing a foreign repo. Add
# the specific plugin dir here if you keep it as a live clone rather than
# vendored content, e.g.:
# <plugin-name>/.git/

# --- Generated shims and forwarders (hazards 1 AND 2 together) ---
# Anything under the ROOT bin/ dir here is a GENERATED PATH shim: it carries the
# authoring machine's absolute interpreter path, so it cannot work on a peer
# even in principle, and being executable it also decays to mode 100644 the
# moment it round-trips through a Windows checkout. This directory is the
# single largest accumulator of accidentally-tracked per-machine content — it
# fills up quietly, one forwarder at a time, and the cleanup is a
# many-hundred-file untracking commit rather than the one line below.
# Callers should resolve executables through the settings home's bin dir
# ($COORDINATOR_SETTINGS_HOME/bin), never through a tracked copy here.
# ANCHORED with a leading slash on purpose: a bare `bin/` matches at every
# depth and would silently ignore an installed plugin's own tracked bin/.
/bin/
# If you ever archive a bin/ tree, keep its README tracked. A timestamped
# directory of hundreds of files with no explanation reads as disk damage to a
# fresh session, which then proposes a repair for something that never broke.
# Pattern: ignore the archive dir, negate its README.
# bin.retired-<stamp>/
# !bin.retired-<stamp>/README.md

# --- Per-machine runtime stamps, heartbeats, and scheduler state ---
# Version-check stamps, update receipts, install heartbeats and daemon logs are
# answers about THIS machine at THIS moment; session ids and lock files are
# actively confusing on the other box.
# ANCHORED on purpose, same reasoning as the machine-local markers above: these
# are root-only single-machine artifacts, so a bare rule would also swallow a
# same-named path a plugin legitimately tracks at depth.
/.last-update-result.json
/.mcp-version-check
/daemon.log
/jobs/
tasks/session-*/
# Example: per-plugin install-profile / setup-state / heartbeat files for an
# installed plugin stack — same reasoning, one entry per plugin you use:
# <plugin-name>/install-profile.json
# <plugin-name>/setup-state.json
# <plugin-name>/install-heartbeat
# <plugin-name>/watchdog/status.json

# --- Install/upgrade backups (per-machine, regenerable, noise in history) ---
*.bak

# --- Percolate publish bookkeeping ---
# Operator identity tokens and per-machine sync high-water marks. The identity
# file is a credential-class surface, not just machine state.
setup/.percolate-identity
setup/percolate-state/
