# Regenerate:  <DoE>/coordinator/bin/gen-claude-doe-shim.py --shell powershell
#
# Purpose: shadow the bare `claude` command with a thin wrapper that reads the
#   cold-readable pointer file (durable-first: settings-home machine-local
#   pointer, then the legacy ~/.claude/.doe-root mirror) and passes the root to
#   claude-doe via the explicit `--doe-root` argv seam (DR-087: the shim must
#   not promote the demoted pointer mirror to rung-1 REPO_DOE_CLAUDE authority).
#
# Spec backlink: docs/plans/2026-07-04-coordinator-maximalist-install-shape.md § C2
# Sibling: coordinator/templates/shell/claude-doe-shim.sh.tmpl (POSIX original
#   this file mirrors semantically — see that file for the bash oracle).
#
# DR-079 (2026-07-21 de-bash residual): the POSIX shim is the one acknowledged
# shell residual in the de-bash campaign's port-target split (tool 6, "claude-doe
# launcher") — a shell-rc function definition cannot be expressed in Python (a
# sourced-in-shell function, not an invokable script). This PowerShell twin is
# the SAME class of exception, on the SAME physics basis: `function claude {
# ... }` must be dot-sourced into the caller's own PowerShell session to shadow
# the `claude` command there, which a child Python process cannot do. It is not
# a precedent for adding more PowerShell (or bash) here — one named exception
# per shell family, not a carve-out. See CLAUDE.md § Runtime conventions.
#
# Machine-independent: the pointer is read at call-time, never baked.
# Windows-safe: Join-Path throughout, no POSIX path assumptions.

# Source-time guard: if the pointer is absent when this file is dot-sourced
# (e.g., a fresh install where gen-doe-root-pointer.py has not yet run), warn
# once to stderr and skip defining claude — a graceful skip, never a throwing
# error (a profile that throws breaks the operator's shell). The function will
# appear on the next shell start after coordinator:install (or the SessionStart
# self-heal) creates the pointer. `return` at file scope is the PowerShell
# analogue of the .sh oracle's `return 0`.
#
# Durable-first (DR-072): check the settings-home pointer first, falling back
# to the legacy ~/.claude pointer during the transition window. No
# lib-sourcing here — cold read, mirroring the coordinator-settings-home
# resolution order.
$__claudeDoeShimHome = if ($env:CLAUDE_HOME) { $env:CLAUDE_HOME } else { $HOME }
$__claudeDoeShimSettingsHome = if ($env:COORDINATOR_SETTINGS_HOME) { $env:COORDINATOR_SETTINGS_HOME } else { Join-Path $__claudeDoeShimHome ".coordinator-claude-settings" }
$__claudeDoeShimPointer = Join-Path (Join-Path $__claudeDoeShimSettingsHome "machine-local") ".doe-root"
$__claudeDoeShimLegacyPointer = Join-Path (Join-Path $__claudeDoeShimHome ".claude") ".doe-root"

if (-not (Test-Path -LiteralPath $__claudeDoeShimPointer) -and -not (Test-Path -LiteralPath $__claudeDoeShimLegacyPointer)) {
  Write-Warning "claude-doe shim: .doe-root pointer absent (settings-home or $__claudeDoeShimHome\.claude) — claude() not defined; run coordinator:install"
  return
}

# claude() — pointer-reading wrapper around claude-doe
#
# Reads the DoE repo root from the cold-readable pointer file at invocation
# time (not at source time) so that a self-healed pointer is picked up without
# re-sourcing the profile. Fails loud if the pointer is absent or empty at
# call-time (belt-and-suspenders: the source-time guard above already skipped
# definition when the pointer was absent, but the pointer can be removed
# later). Durable-first (DR-072): settings-home pointer, then legacy ~/.claude
# fallback.
#
# Negative-spec: does NOT call machine-local, does NOT require coordinator
# bins on PATH — zero tool dependency beyond claude-doe on PATH.
#
# @args splatting (not a $args -join relay): preserves per-argument fidelity —
# a %*-style relay truncates at a newline and strips quoting, which broke
# argv-fidelity for the cmd.exe forwarder this shim's sibling fixed (see
# cross-repo/archive/2026-08-07-claude-klabauter-em-cmd-forwarder-newline-truncation-fix.md).
# The call operator `&` (not simple juxtaposition) delegates explicitly to the
# distinctly-named `claude-doe` command — the function below is named `claude`,
# not `claude-doe`, so this cannot recurse into itself.
function claude {
  $__claudeDoeShimHome = if ($env:CLAUDE_HOME) { $env:CLAUDE_HOME } else { $HOME }
  $__claudeDoeShimSettingsHome = if ($env:COORDINATOR_SETTINGS_HOME) { $env:COORDINATOR_SETTINGS_HOME } else { Join-Path $__claudeDoeShimHome ".coordinator-claude-settings" }
  $__claudeDoeShimPointer = Join-Path $__claudeDoeShimSettingsHome "machine-local\.doe-root"
  $__claudeDoeShimLegacyPointer = Join-Path $__claudeDoeShimHome ".claude\.doe-root"

  $_r = $null
  if (Test-Path -LiteralPath $__claudeDoeShimPointer) {
    $_r = (Get-Content -LiteralPath $__claudeDoeShimPointer -ErrorAction SilentlyContinue | Select-Object -First 1)
  }
  if ([string]::IsNullOrEmpty($_r) -and (Test-Path -LiteralPath $__claudeDoeShimLegacyPointer)) {
    $_r = (Get-Content -LiteralPath $__claudeDoeShimLegacyPointer -ErrorAction SilentlyContinue | Select-Object -First 1)
  }
  if ([string]::IsNullOrEmpty($_r)) {
    Write-Error "claude-doe shim: .doe-root pointer missing (settings-home or $__claudeDoeShimHome\.claude) — run coordinator:install"
    return
  }

  & claude-doe --doe-root $_r @args
}
