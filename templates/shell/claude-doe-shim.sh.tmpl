# claude() — pointer-reading wrapper around claude-doe
#
# Reads the DoE repo root from the cold-readable pointer file at invocation
# time (not at source time) so that a self-healed pointer is picked up without
# re-sourcing the rc.  Fails loud if the pointer is absent or empty at
# call-time (belt-and-suspenders: the source-time guard above already skipped
# definition when the pointer was absent, but the pointer can be removed later).
# Durable-first (DR-072): settings-home pointer, then legacy ~/.claude fallback.
#
# Negative-spec: does NOT call machine-local, does NOT require coordinator bins
# on PATH — zero tool dependency beyond cat(1) and claude-doe on PATH.
claude() {
  _r="$(cat "${COORDINATOR_SETTINGS_HOME:-${CLAUDE_HOME:-$HOME}/.coordinator-claude-settings}/machine-local/.doe-root" 2>/dev/null)"
  if [ -z "$_r" ]; then
    _r="$(cat "${CLAUDE_HOME:-$HOME}/.claude/.doe-root" 2>/dev/null)"
  fi
  if [ -z "$_r" ]; then
    printf 'claude-doe shim: .doe-root pointer missing (settings-home or %s/.claude) — run coordinator:install\n' \
      "${CLAUDE_HOME:-$HOME}" >&2
    return 1
  fi
  command claude-doe --doe-root "$_r" "$@"
}
