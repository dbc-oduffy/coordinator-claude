# Machine-specific
settings.local.json

# Session data (not part of the distribution)
# Anchored to repo root: ephemeral session plans/ at root are ignored,
# but docs/plans/ (canonical, tracked design history) is not shadowed.
/plans/
tasks/
archive/
projects/
.remember/

# Claude Code local state
.claude/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/

# Experiment results (API outputs, reports)
experiments/results/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Coordinator universal scratch rule (added 2026-05-20)
scratch/
tasks/_*.log

# A percolate round's own state, written into the mirror by the round that ran. Round
# working memory, not published product: tracking it makes each round's manifest a diff
# in the next one. See coordinator-tripwires/a-rounds-own-manifest-is-not-payload.md.
.percolate/

# Group-EM watch runtime state -- a Stop hook appends one park record per turn end,
# and the watch/parked files carry this box's clock and session ids. Per-machine, no
# cross-clone reader; tracking any of them ships one box's runtime to every peer.
state/group-em-watch.json
state/group-em-watch-parked.json
state/group-em-watch-spool.jsonl
# Same rationale, same plane: written by claude-klabauter's
# coordinator_core.engine_provenance_counter on every engine-backed call, and
# every row carries this box's absolute engine path and wall clock.
state/engine-provenance-counts.jsonl

# Per-machine session machinery (subagent-share fire counts and friends),
# written by coordinator_core.session.machinery_paths. Generated, never
# authored. claude-klabauter's fleet_machinery_sweep lands this same ignore in
# the repos it sweeps; this tree never received it, so a documented install
# plus any engine-backed ceremony leaves the working tree dirty here.
.coordinator-local/
